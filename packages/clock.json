{
  "name": "clock",
  "summary": "timers, alarms, world clocks and weather",
  "layer": 2,
  "owns": {
    "qml": ["modules/ipc/ClockIpc.qml"],
    "services": ["Clock", "Localisation", "Weather"],
    "js": ["services/alarms.js", "services/localisation.js", "services/weather.js"],
    "tests": ["tests/alarms.test.js", "tests/fixtures/weather", "tests/localisation.test.js", "tests/weather.test.js"]
  },
  "requires": {
    "packages": ["core", "compositor"],
    "optional": []
  },
  "provides": {
    "singletons": ["Clock", "Weather"],
    "ipc": ["timer", "alarm", "zone"]
  },
  "config": {
    "namespace": ["clock", "weather"],
    "reads": ["region"]
  }
}
