{
  "name": "compositor",
  "summary": "the Hyprland bridge: windows, monitors, config files, chords",
  "layer": 1,
  "owns": {
    "qml": ["modules/ipc/CompositorIpc.qml"],
    "services": ["CliMigration", "CompositorSync", "Hypr", "HyprConfig", "Keymap", "Monitors", "WorkspaceSlide"],
    "js": [
      "services/chords.js",
      "services/cli-migration.js",
      "services/compositor-options.js",
      "services/hyprland-lua.js",
      "services/monitor-rules.js"
    ],
    "tests": ["tests/cli-migration.test.js", "tests/compositor-options.test.js", "tests/fixtures/hyprctl", "tests/hyprland-lua.test.js", "tests/monitor-rules.test.js"]
  },
  "requires": {
    "packages": ["core"],
    "optional": []
  },
  "provides": {
    "singletons": ["Hypr", "HyprConfig", "Keymap", "Monitors", "WorkspaceSlide"],
    "ipc": ["migration"]
  },
  "config": {
    "namespace": ["compositor", "cli"],
    "reads": ["anim", "edge", "rounding"]
  }
}
