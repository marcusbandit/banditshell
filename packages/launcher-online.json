      "modules/launcher/sources/GithubSource.qml",
      "modules/launcher/sources/PackageSource.qml",
      "modules/launcher/sources/SpeedtestSource.qml",
      "modules/launcher/sources/TranslateSource.qml",
      "modules/launcher/sources/VideoDownloadSource.qml",
