        out="${3:-$SHOT_DIR/settings-$size${page:+-$page}.png}"
        w="${size%x*}"
        h="${size#*x}"
        ws="${PREVIEW_WORKSPACE:-6}"
        hyprctl eval "hl.window_rule({ name = \"banditshell-settingspreview\", match = { title = \"^(banditshell-settingspreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true, workspace = \"$ws silent\", no_initial_focus = true, no_focus = true })" >/dev/null 2>&1 ||
            hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule center on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule workspace $ws silent, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_initial_focus on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_focus on, match:title ^(banditshell-settingspreview)\$" >/dev/null 2>&1 || true
        start_preview SettingsPreview 9 "SETTINGS_PREVIEW=$size" "SETTINGS_PAGE=$page"
        sleep 4
        preview_failed SettingsPreview && exit 1
        rect=$(window_rect banditshell-settingspreview)
        if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
        wait "$preview_pid" || true
        echo "$out"
        ;;
    files)
        where="${1:-$HOME}"
        out="${2:-}"
        resolve_target
        w=$(ipc_quiet shell get files.width || echo 1200)
        h=$(ipc_quiet shell get files.height || echo 760)
        hyprctl eval "hl.window_rule({ name = \"banditshell-filespreview\", match = { title = \"^(banditshell-filespreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true })" >/dev/null 2>&1 ||
            hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-filespreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-filespreview)\$ ; keyword windowrule center on, match:title ^(banditshell-filespreview)\$" >/dev/null 2>&1 || true
        start_preview FilesPreview 0 "FILES_PREVIEW=$where"
        if [ -n "$out" ]; then
            sleep 4
            preview_failed FilesPreview && exit 1
            rect=$(window_rect banditshell-filespreview)
            if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
            kill "$preview_pid" 2>/dev/null || true
            echo "$out"
        else
            sleep 2
            preview_failed FilesPreview && exit 1
            wait "$preview_pid"
        fi
        ;;
    gallery)
        size="${1:-1280x800}"
        w="${size%x*}"
        h="${size#*x}"
        hyprctl eval "hl.window_rule({ name = \"banditshell-gallery\", match = { title = \"^(banditshell-gallery)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true })" >/dev/null 2>&1 ||
            hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-gallery)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-gallery)\$ ; keyword windowrule center on, match:title ^(banditshell-gallery)\$" >/dev/null 2>&1 || true
        start_preview GalleryPreview 0 "GALLERY_SIZE=$size"
        sleep 2
        preview_failed GalleryPreview && exit 1
        echo "gallery up at $size"
        ;;
    menu)
        [ $# -ge 1 ] || say_usage "dev preview menu <menu> [file]"
        mkdir -p "$SHOT_DIR"
        out="${2:-$SHOT_DIR/menu-$1.png}"
        ipc menu open "$1" "" >/dev/null
        sleep 0.6
        grim "$out"
        ipc menu close >/dev/null
        echo "$out"
        ;;
    *) nope dev "preview $face" ;;
    esac
}

route_dev() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "") group_help dev ;;
    try) try_command "${1:-}" ;;
    back) go_back ;;
    watch) watch_merges ;;
    tidy)
        tidy_worktrees
        [ "$cleared" -gt 0 ] || echo "nothing merged to clear"
        list_worktrees
        ;;
    worktrees) other_worktrees | cut -f2 ;;
    run) cd "$HOME" || exit 1; exec qs -p "$SHELL_DIR" ;;
    build) build_helpers ;;
    shaders) build_shaders ;;
    test)
        command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
        cd "$SHELL_DIR" || exit 1
        exec node --test tests/*.test.js "$@"
        ;;
    modules)
        command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
        cd "$SHELL_DIR" || exit 1
        case "${1:-}" in
        "" | --matrix | --graph) exec node scripts/check-modules.js "$@" ;;
        --explain)
            [ -n "${2:-}" ] || say_usage "dev modules --explain <package>"
            exec node scripts/check-modules.js "$@"
            ;;
        *) nope dev "modules $1" ;;
        esac ;;
    lint)
        command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
        cd "$SHELL_DIR" || exit 1
        case "${1:-}" in
        "" | --all | --write-baseline) exec node scripts/lint-rules.js "$@" ;;
        --rule)
            [ -n "${2:-}" ] || say_usage "dev lint --rule <rule>"
            exec node scripts/lint-rules.js "$@"
            ;;
        *) nope dev "lint $1" ;;
        esac ;;
    release)
        for arg in "$@"; do
            case "$arg" in
            --dry-run | --skip-boot-check) ;;
            *) nope dev "release $arg" ;;
            esac
        done
        exec bash "$SHELL_DIR/scripts/release.sh" "$@" ;;
    check)
        case "${1:-}" in
        "") check_everything ;;
        island) check_island "${2:-}" ;;
        boot) shift; check_boot "$@" ;;
        *) nope dev "check $1" ;;
        esac ;;
    inspect)
        case "${1:-}" in
        island) ipc inspect island "${2:-}" ;;
        close) ipc inspect close ;;
        *) nope dev "inspect ${1:-}" ;;
        esac ;;
    preview) route_preview "$@" ;;
    perf) perf_command "$@" ;;
    trace) trace_command "$@" ;;
    menu)
        case "${1:-current}" in
        current | hover | list) ipc menu "${1:-current}" ;;
        *) nope dev "menu $1" ;;
        esac ;;
    launcher)
        [ "${1:-}" = scrub ] || nope dev "launcher ${1:-}"
        ipc launcher scrub "${2:-0}" ;;
    keyring)
        case "${1:-status}" in
        status | demo) ipc keyring "${1:-status}" ;;
        close) ipc keyring refuse ;;
        *) nope dev "keyring $1" ;;
        esac ;;
    polkit)
        case "${1:-status}" in
        status | demo) ipc polkit "${1:-status}" ;;
        close) ipc polkit refuse ;;
        *) nope dev "polkit $1" ;;
        esac ;;
    *) nope dev "$what" ;;
    esac
}

route_completions() {
    local sub="${1:-status}" generator code status=0
    local -a generators=(zsh bash)
    if [ $# -gt 0 ]; then shift; fi
    case "$sub" in
    install | status | remove)
        case "${1:-}" in
        zsh | bash)
            generators=("$1")
            shift
            ;;
        esac
        for generator in "${generators[@]}"; do
            "$SHELL_DIR/scripts/$generator-completion.sh" "$sub" "$@" || {
                code=$?
                [ "$code" -gt "$status" ] && status=$code
            }
        done
        exit "$status"
        ;;
    print)
        case "${1:-zsh}" in
        zsh | bash) exec "$SHELL_DIR/scripts/${1:-zsh}-completion.sh" print ;;
        *) say_usage "completions print [zsh|bash]" ;;
        esac
        ;;
    *) say_usage "completions [install|status|remove|print] [zsh|bash]" ;;
    esac
}

json_quote() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/}
    s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

json_list() {
    local item out=""
    for item in "$@"; do
        out+="${out:+,}$(json_quote "$item")"
    done
    printf '[%s]' "$out"
}

config_leaf() {
    local body value
    body=$(tr -d '\n' 2>/dev/null <"$CONFIG_FILE" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p") || body=""
    value=$(sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" <<<"$body")
    printf '%s' "${value:-$3}"
}

config_true() {
    tr -d '\n' 2>/dev/null <"$CONFIG_FILE" | grep -q "\"$1\"[[:space:]]*:[[:space:]]*{[^}]*\"$2\"[[:space:]]*:[[:space:]]*true"
}

config_channel() {
    local channel
    channel=$(config_leaf updates channel stable)
    [ "$channel" != main ] || config_true updates channelUpgraded || [ -s "$STATE_DIR/keep-channel" ] || channel=stable
    printf '%s' "$channel"
}

UPDATE_JSON=0
UPDATE_APPLYING=0
U_DIR="" U_REMOTE="" U_CHANNEL="" U_BRANCH="" U_BRANCH_NOW="" U_HEAD="" U_TARGET="" U_PREVIOUS="" U_BEHIND=0 U_AHEAD=0 U_STATE="" U_UNRELEASED="" U_FOUND_NONE=0
A_RESTART=0 A_HELPERS=0 A_DEPS="" A_DIRTY="" A_BLOCKED="" A_BUTTON="" A_SUMMARY=""
U_WARNINGS=()
HEALTH_WHY=""

ugit() { GIT_TERMINAL_PROMPT=0 LC_ALL=C git -C "$U_DIR" "$@"; }

update_has_node() { command -v node >/dev/null 2>&1 && [ -f "$U_DIR/services/update.js" ]; }

update_explain() {
    local text="$1" said
    if update_has_node; then
        printf '%s\n' "$text" | node "$U_DIR/services/update.js" explain "${U_BRANCH:-main}" && return 0
    fi
    said=$(printf '%s\n' "$text" | grep -v '^[[:space:]]*$' | tail -1)
    printf '%s\n' "${said#fatal: }"
}

update_fail() {
    local text="$1" line
    local -a lines=()
    if [ "$UPDATE_JSON" = 1 ]; then
        while IFS= read -r line; do
            lines+=("$line")
        done <<<"$text"
        if [ "$UPDATE_APPLYING" = 1 ]; then
            printf '{"phase":"failed","text":%s,"output":%s,"at":%s}\n' "$(json_quote "$(update_explain "$text")")" "$(json_list "${lines[@]}")" "$(date +%s)"
        else
            printf '{"state":"error","output":%s,"version":%s}\n' "$(json_list "${lines[@]}")" \
                "$(json_quote "$([ -z "$U_DIR" ] || update_label "$(ugit rev-parse --verify --quiet HEAD 2>/dev/null)")")"
        fi
    else
        echo "${red}banditshell: $(update_explain "$text")$plain" >&2
    fi
    exit 1
}

update_phase() {
    if [ "$UPDATE_JSON" = 1 ]; then
        printf '{"phase":%s,"text":%s,"at":%s}\n' "$(json_quote "$1")" "$(json_quote "$2")" "$(date +%s)"
    else
        printf '%s%s%s\n' "$dim" "$2" "$plain"
    fi
}

update_branch_for() {
    case "$2" in
    "" | main) [ "$1" = stable ] && echo stable || echo main ;;
    *) echo "$2" ;;
    esac
}

update_on_branch() {
    [ "$U_BRANCH_NOW" = "$U_BRANCH" ] || { [ "$U_BRANCH" = stable ] && [ "$U_BRANCH_NOW" = main ]; }
}

update_prepare() {
    local top="" saved
    top=$(git -C "$SHELL_DIR" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -z "$top" ] || [ "$top" != "$(cd "$SHELL_DIR" && pwd -P)" ]; then
        saved=$(cat "$STATE_DIR/root" 2>/dev/null || true)
        if [ -n "$saved" ] && [ -d "$saved" ] && [ "$(git -C "$saved" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$saved" && pwd -P)" ]; then
            top="$saved"
        else
            update_fail "fatal: not a git repository"
        fi
    fi
    SHELL_DIR="$top"
    U_DIR="$top"
    U_REMOTE=$(config_leaf updates remote origin)
    U_CHANNEL=$(config_channel)
    case "$U_CHANNEL" in
    stable | main) ;;
    *) update_fail "fatal: updates.channel in config.json is \"$U_CHANNEL\", and it has to be stable or main" ;;
    esac
    U_BRANCH=$(update_branch_for "$U_CHANNEL" "$(config_leaf updates branch main)")
    case "$U_REMOTE:$U_BRANCH" in
    -* | *:-* | :* | *:) update_fail "fatal: the update remote or branch is not a name git can take" ;;
    esac
}

update_fetch() {
    local out code=0
    out=$(GIT_TERMINAL_PROMPT=0 LC_ALL=C timeout -k 10 120 git -C "$U_DIR" fetch --quiet --no-tags -- "$U_REMOTE" \
        "+refs/heads/$U_BRANCH:refs/remotes/$U_REMOTE/$U_BRANCH" "+refs/tags/v*:refs/tags/v*" 2>&1) || code=$?
    case "$code" in
    0) ;;
    124 | 137) update_fail "timed out" ;;
    *)
        [ "$U_BRANCH" = stable ] && [[ $out == *"couldn't find remote ref refs/heads/stable"* ]] || update_fail "$out"
        ugit update-ref -d "refs/remotes/$U_REMOTE/stable" 2>/dev/null || true
        U_FOUND_NONE=1
        ;;
    esac
}

update_skipped() {
    local skips
    skips=$({ cat "$UPDATE_STATE/skip" 2>/dev/null || true; echo; config_leaf updates skip ""; echo; })
    grep -qxF -- "$1" <<<"$skips"
}

update_skipped_here() {
    grep -qxF -- "$1" "$UPDATE_STATE/skip" 2>/dev/null
}

update_read() {
    U_BRANCH_NOW=$(ugit symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)
    U_HEAD=$(ugit rev-parse --verify --quiet HEAD 2>/dev/null || true)
    U_TARGET=$(ugit rev-parse --verify --quiet --end-of-options "$U_REMOTE/$U_BRANCH^{commit}" 2>/dev/null || true)
    if [ -z "$U_TARGET" ] && [ "$U_BRANCH" = stable ]; then
        U_UNRELEASED=$([ "$U_FOUND_NONE" = 1 ] && echo none || echo unchecked)
        U_TARGET="$U_HEAD" U_STATE=current U_BEHIND=0 U_AHEAD=0 U_PREVIOUS=""
        update_on_branch || U_STATE=paused
        return 0
    fi
    [ -n "$U_TARGET" ] || update_fail "fatal: there is no fetched copy of $U_REMOTE/$U_BRANCH yet"
    U_BEHIND=$(ugit rev-list --count --end-of-options "HEAD..$U_REMOTE/$U_BRANCH" 2>/dev/null || echo 0)
    U_AHEAD=$(ugit rev-list --count --end-of-options "$U_REMOTE/$U_BRANCH..HEAD" 2>/dev/null || echo 0)
    if ! update_on_branch; then
        U_STATE=paused U_BEHIND=0 U_AHEAD=0
    elif [ "$U_BEHIND" -gt 0 ] && [ "$U_AHEAD" -gt 0 ]; then
        U_STATE=diverged
    elif [ "$U_BEHIND" -gt 0 ]; then
        U_STATE=available
        if update_skipped "$U_TARGET"; then
            U_STATE=skipped
        fi
    else
        U_STATE=current
    fi
    if [ "$U_BRANCH" = stable ]; then
        U_PREVIOUS=$(update_release_before)
    else
        U_PREVIOUS=$(cat "$UPDATE_STATE/previous" 2>/dev/null || true)
    fi
    if [ "$U_STATE" = paused ] || [ "$U_AHEAD" -gt 0 ] || ! [[ $U_PREVIOUS =~ ^[0-9a-f]{40,64}$ ]] ||
        [ "$U_PREVIOUS" = "$U_HEAD" ] || ! ugit merge-base --is-ancestor "$U_PREVIOUS" HEAD 2>/dev/null; then
        U_PREVIOUS=""
    fi
}

release_tags() {
    ugit tag --merged "$1" -l 'v*' --sort=-v:refname 2>/dev/null | grep -E '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || true
}

update_release_before() {
    local tag sha
    ugit rev-parse --verify --quiet HEAD^ >/dev/null 2>&1 || return 0
    while IFS= read -r tag; do
        sha=$(ugit rev-parse --verify --quiet "$tag^{commit}" 2>/dev/null) || continue
        [ "$sha" != "$U_HEAD" ] && ! update_skipped "$sha" || continue
        printf '%s' "$sha"
        return 0
    done < <(release_tags HEAD^)
}

update_fetched_at() {
    local file mtime
    file=$(ugit rev-parse --path-format=absolute --git-path FETCH_HEAD 2>/dev/null || true)
    mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
    echo $((mtime * 1000))
}

update_meta() {
    printf '%s\n' "state=$U_STATE" "head=$U_HEAD" "target=$U_TARGET" "channel=$U_CHANNEL" "branch=$U_BRANCH" "headBranch=$U_BRANCH_NOW" \
        "remote=$U_REMOTE" "behind=$U_BEHIND" "ahead=$U_AHEAD" "skipped=$([ "$U_STATE" = skipped ] && echo 1 || echo 0)" \
        "checkedAt=$(update_fetched_at)" "version=$(update_label "$U_HEAD")" "targetVersion=$(update_label "$U_TARGET")" \
        "previous=$U_PREVIOUS" "previousVersion=$(update_label "$U_PREVIOUS")"
}

update_meta_json() {
    printf '{"state":%s,"head":%s,"target":%s,"channel":%s,"branch":%s,"headBranch":%s,"remote":%s,"behind":%s,"ahead":%s,"skipped":%s,"checkedAt":%s,"version":%s,"targetVersion":%s,"previous":%s,"previousVersion":%s' \
        "$(json_quote "$U_STATE")" "$(json_quote "$U_HEAD")" "$(json_quote "$U_TARGET")" "$(json_quote "$U_CHANNEL")" "$(json_quote "$U_BRANCH")" \
        "$(json_quote "$U_BRANCH_NOW")" "$(json_quote "$U_REMOTE")" "$U_BEHIND" "$U_AHEAD" \
        "$([ "$U_STATE" = skipped ] && echo true || echo false)" "$(update_fetched_at)" \
        "$(json_quote "$(update_label "$U_HEAD")")" "$(json_quote "$(update_label "$U_TARGET")")" \
        "$(json_quote "$U_PREVIOUS")" "$(json_quote "$(update_label "$U_PREVIOUS")")"
}

update_facts() {
    local dir="$1" pair name file
    update_meta >"$dir/meta"
    ugit -c core.quotepath=off diff --name-status --no-renames HEAD "$U_TARGET" -- >"$dir/name-status"
    ugit -c core.quotepath=off diff --name-only HEAD -- >"$dir/dirty"
    ugit -c core.quotepath=off ls-files --others --exclude-standard >"$dir/untracked"
    for pair in actions:api/actions.tsv install:install.sh whatsnew:docs/whats-new.json; do
        name="${pair%%:*}" file="${pair#*:}"
        ugit show "HEAD:$file" >"$dir/$name.before" 2>/dev/null || : >"$dir/$name.before"
        ugit show "$U_TARGET:$file" >"$dir/$name.after" 2>/dev/null || : >"$dir/$name.after"
    done
}

update_fallback_lines() {
    local dir="$1" helpers=0 dirty blocked count
    count=$(wc -l <"$dir/name-status")
    grep -qE $'^[A-Z]\tsrc/.*\\.[ch]$' "$dir/name-status" && helpers=1
    dirty=$(cut -f2 "$dir/name-status" | grep -Fxf - "$dir/dirty" | paste -sd '\t' - || true)
    blocked=$(awk -F'\t' '$1 == "A" { print $2 }' "$dir/name-status" | grep -Fxf - "$dir/untracked" | paste -sd '\t' - || true)
    printf '%s\n' "kind=restart" "restart=1" "cli=0" "helpers=$helpers" "files=$count" "deps=" "dirty=$dirty" "blocked=$blocked" \
        "button=Update and restart" "summary=$U_BEHIND changes, restart assumed (node is missing, so they were not read)"
}

update_classify() {
    local dir="$1"
    if update_has_node; then
        node "$U_DIR/services/update.js" report "$dir" --lines
    else
        update_fallback_lines "$dir"
    fi
}

update_load_class() {
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
        restart) A_RESTART="$value" ;;
        helpers) A_HELPERS="$value" ;;
        deps) A_DEPS="$value" ;;
        dirty) A_DIRTY="$value" ;;
        blocked) A_BLOCKED="$value" ;;
        button) A_BUTTON="$value" ;;
        summary) A_SUMMARY="$value" ;;
        esac
    done
}

update_state_text() {
    case "$U_STATE" in
    current)
        if [ "$U_UNRELEASED" = none ]; then
            echo "there is no release on $U_BRANCH yet, so this copy stays at $(update_label "$U_HEAD")"
        elif [ "$U_UNRELEASED" = unchecked ]; then
            echo "$U_BRANCH has not been checked yet; banditshell update check looks"
        else
            echo "up to date at $(update_label "$U_HEAD") on $U_BRANCH"
        fi ;;
    paused) echo "this copy is on ${U_BRANCH_NOW/#HEAD/no branch}, so it does not follow $U_BRANCH" ;;
    diverged) echo "$U_BEHIND new on $U_BRANCH, but this copy has $U_AHEAD commit(s) of its own, so it cannot just move forward" ;;
    skipped) echo "$(update_label "$U_TARGET") did not start last time and is skipped until a newer version arrives" ;;
    esac
}

update_check() {
    local fetch=1 dir out="" arg
    UPDATE_JSON=0
    [ -z "${BANDITSHELL_JSON:-}" ] || UPDATE_JSON=1
    for arg in "$@"; do
        case "$arg" in
        --json) UPDATE_JSON=1 ;;
        --no-fetch) fetch=0 ;;
        *) say_usage "update check [--json] [--no-fetch]" ;;
        esac
    done
    update_prepare
    [ "$fetch" = 0 ] || update_fetch
    update_read
    if [ "$U_STATE" = available ]; then
        dir=$(mktemp -d)
        update_facts "$dir"
        if update_has_node; then
            out=$(node "$U_DIR/services/update.js" report "$dir" "$([ "$UPDATE_JSON" = 1 ] && echo --json || echo --text)")
        else
            update_load_class < <(update_classify "$dir")
            if [ "$UPDATE_JSON" = 1 ]; then
                out="$(update_meta_json),\"class\":{\"kind\":\"restart\",\"restart\":true,\"dirty\":[],\"blocked\":[]},\"summary\":$(json_quote "$A_SUMMARY"),\"button\":$(json_quote "$A_BUTTON"),\"entries\":[]}"
            else
                out="update waiting: $A_SUMMARY"$'\n'"run: banditshell update apply"
            fi
        fi
        rm -rf "$dir"
        printf '%s\n' "$out"
        exit 10
    fi
    if [ "$UPDATE_JSON" = 1 ]; then
        printf '%s}\n' "$(update_meta_json)"
    else
        update_state_text
    fi
    exit 0
}

update_label() {
    local label="" tag past
    [ -n "$1" ] || return 0
    tag=$(release_tags "$1" | head -n 1)
    if [ -n "$tag" ] && past=$(ugit rev-list --count "$tag..$1" 2>/dev/null); then
        label="$tag"
        [ "$past" = 0 ] || label+="+$past"
    else
        label=$(ugit show "$1:docs/whats-new.json" 2>/dev/null | awk -F'"' '!found && /^[[:space:]]*"id":[[:space:]]*"/ { print $4; found = 1 }') || label=""
    fi
    printf '%s' "${label:-${1:0:7}}"
}

update_result() {
    local ok="$1" why="$2" hand="${3:-false}" from to aside_items=() line
    from=$(cat "$UPDATE_STATE/previous" 2>/dev/null || true)
    to=$(cat "$UPDATE_STATE/target" 2>/dev/null || true)
    while IFS= read -r line; do
        [ -z "$line" ] || aside_items+=("$line")
    done 2>/dev/null <"$UPDATE_STATE/aside" || true
    printf '{"ok":%s,"hand":%s,"from":%s,"to":%s,"fromLabel":%s,"toLabel":%s,"why":%s,"aside":%s,"log":%s,"at":%s,"shown":false}\n' \
        "$ok" "$hand" "$(json_quote "$from")" "$(json_quote "$to")" "$(json_quote "$(update_label "$from")")" \
        "$(json_quote "$(update_label "$to")")" "$(json_quote "$why")" "$(json_list "${aside_items[@]}")" \
        "$(json_quote "$FAILED_LOG")" "$(date +%s)" >"$UPDATE_STATE/result.json.next"
    mv -f "$UPDATE_STATE/result.json.next" "$UPDATE_STATE/result.json"
}

update_lock() {
    mkdir -p "$UPDATE_STATE"
    exec 8>"$UPDATE_STATE/lock"
    command -v flock >/dev/null || update_fail "fatal: flock is missing; install util-linux"
    flock "$@" 8 || update_fail "fatal: another update is already running"
}

update_plan() {
    say_dry "stage $U_TARGET into $STAGED with git archive"
    say_dry "run scripts/qml-compile-check.sh on the staged tree and refuse if it fails"
    say_dry "check that scripts/qmldirs.sh leaves the staged qmldir files alone"
    [ "$A_HELPERS" != 1 ] || say_dry "build the helpers in the staged tree"
    say_dry "record ${U_HEAD:0:7} in $UPDATE_STATE/previous"
    [ -z "$A_DIRTY" ] || say_dry "set aside ${A_DIRTY//$'\t'/, } with git stash"
    say_dry "git merge --ff-only ${U_TARGET:0:7}"
    [ "$A_HELPERS" != 1 ] || say_dry "copy the staged helpers into bin/"
    say_dry "ensure bin/banditshell, refresh completions"
    if [ "$A_RESTART" = 1 ]; then
        say_dry "restart the shell, then wait for shell status and scan the log"
    else
        say_dry "leave the running shell to reload, then wait for shell status and scan the log"
    fi
    say_dry "on a failed health check: git reset --keep ${U_HEAD:0:7}, relaunch, write result.json, skip ${U_TARGET:0:7}"
}

update_stage() {
    rm -rf "$STAGED"
    mkdir -p "$STAGED"
    ugit archive "$U_TARGET" | tar -x -C "$STAGED" || update_fail "fatal: could not unpack the new version"
}

update_verify() {
    local checker out before after
    checker="$U_DIR/scripts/qml-compile-check.sh"
    [ -f "$checker" ] || checker="$STAGED/scripts/qml-compile-check.sh"
    mkdir -p "$UPDATE_STATE"
    if [ -f "$checker" ]; then
        if ! out=$(bash "$checker" "$STAGED" 2>&1); then
            printf '%s\n' "$out" >"$UPDATE_STATE/verify.log"
            [ "$UPDATE_JSON" = 1 ] || printf '%s\n' "$out" | tail -n 8 >&2
            rm -rf "$STAGED"
            update_fail "fatal: the new version does not load, so nothing was changed (details: $UPDATE_STATE/verify.log)"
        fi
    else
        U_WARNINGS+=("this copy has no compile check, so the new version was not tried before applying")
    fi
    if [ -f "$STAGED/scripts/qmldirs.sh" ]; then
        before=$(cd "$STAGED" && find . -name qmldir -exec cksum {} + | sort | cksum)
        BANDITSHELL_DIR="$STAGED" bash "$STAGED/scripts/qmldirs.sh" >/dev/null 2>&1 || true
        after=$(cd "$STAGED" && find . -name qmldir -exec cksum {} + | sort | cksum)
        [ "$before" = "$after" ] || U_WARNINGS+=("the new version's qmldir files are out of date; run scripts/qmldirs.sh in it")
    fi
    if [ "$A_HELPERS" = 1 ]; then
        mkdir -p "$UPDATE_STATE"
        if ! (SHELL_DIR="$STAGED" && build_helpers) >"$UPDATE_STATE/build.log" 2>&1; then
            rm -rf "$STAGED"
            update_fail "fatal: the helpers in the new version did not build, so nothing was changed (details: $UPDATE_STATE/build.log)"
        fi
    fi
}

update_set_aside() {
    local out
    : >"$UPDATE_STATE/aside"
    [ -n "$A_DIRTY" ] || return 0
    if out=$(printf '%s\n' "${A_DIRTY//$'\t'/$'\n'}" | ugit -c user.name=banditshell -c user.email=banditshell@localhost --literal-pathspecs \
        stash push --quiet --message "banditshell update to ${U_TARGET:0:7}: edits set aside" --pathspec-from-file=- 2>&1); then
        printf '%s\n' "${A_DIRTY//$'\t'/$'\n'}" >"$UPDATE_STATE/aside"
    else
        update_fail "$out"
    fi
}

update_merge() {
    local out
    if ! out=$(ugit merge --ff-only --quiet "$U_TARGET" 2>&1); then
        if [ -s "$UPDATE_STATE/aside" ]; then
            ugit -c user.name=banditshell -c user.email=banditshell@localhost stash pop --quiet >/dev/null 2>&1 || true
        fi
        update_fail "$out"
    fi
}

update_after_merge() {
    local helper
    if [ "$A_HELPERS" = 1 ]; then
        mkdir -p "$U_DIR/bin"
        for helper in "${HELPERS[@]}"; do
            [ ! -x "$STAGED/bin/$helper" ] || cp -f "$STAGED/bin/$helper" "$U_DIR/bin/$helper"
        done
    fi
    ensure_built || U_WARNINGS+=("bin/ was not rebuilt; run banditshell doctor")
    for helper in zsh bash; do
        [ ! -x "$U_DIR/scripts/$helper-completion.sh" ] || "$U_DIR/scripts/$helper-completion.sh" install --quiet >/dev/null 2>&1 ||
            U_WARNINGS+=("$helper completion was not refreshed; run banditshell completions install")
    done
}

update_log_mark() {
    local pid
    if pid=$(instance_of "$U_DIR"); then
        log_length "$pid" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

update_apply() {
    local to="" detach=0 arg line mark=0
    UPDATE_JSON=0
    [ -z "${BANDITSHELL_JSON:-}" ] || UPDATE_JSON=1
    while [ $# -gt 0 ]; do
        arg="$1"
        shift
        case "$arg" in
        --json) UPDATE_JSON=1 ;;
        --detach) detach=1 ;;
        --to)
            [ $# -gt 0 ] || say_usage "update apply [--to <sha>] [--detach] [--json]"
            to="$1"
            shift ;;
        *) say_usage "update apply [--to <sha>] [--detach] [--json]" ;;
        esac
    done
    UPDATE_APPLYING=1
    if [ "$detach" = 1 ] && ! dry; then
        mkdir -p "$UPDATE_STATE"
        : >"$UPDATE_STATE/progress.log"
        (cd "$HOME" && detach "$(readlink -f "${BASH_SOURCE[0]}")" update apply --json ${to:+--to "$to"} 8>&- </dev/null >>"$UPDATE_STATE/progress.log" 2>>"$UPDATE_STATE/apply.log")
        return 0
    fi
    update_prepare
    if ! dry; then
        update_lock -n
    fi
    if [ -n "$to" ]; then
        [[ $to =~ ^[0-9a-f]{40,64}$ ]] || update_fail "fatal: $to is not a full commit id"
        ugit cat-file -e "$to^{commit}" 2>/dev/null || update_fail "fatal: that version is not in this copy; check for updates first"
        ugit merge-base --is-ancestor HEAD "$to" 2>/dev/null || update_fail "fatal: Not possible to fast-forward, aborting."
        update_read
        U_TARGET="$to"
        U_BEHIND=$(ugit rev-list --count "HEAD..$to")
        U_AHEAD=0
        U_STATE=current
        [ "$U_BEHIND" -eq 0 ] || U_STATE=available
        update_on_branch || U_STATE=paused
    else
        update_fetch
        update_read
    fi
    case "$U_STATE" in
    paused) update_fail "fatal: $(update_state_text)" ;;
    diverged) update_fail "fatal: Not possible to fast-forward, aborting." ;;
    current)
        update_phase "done" "Already up to date."
        return 0 ;;
    esac
    local facts
    facts=$(mktemp -d)
    update_facts "$facts"
    update_load_class < <(update_classify "$facts")
    rm -rf "$facts"
    if [ -n "$A_BLOCKED" ]; then
        update_fail "error: The following untracked working tree files would be overwritten by merge:"$'\n'"	${A_BLOCKED//$'\t'/$'\n\t'}"$'\n'"Please move or remove them before you merge."
    fi
    if dry; then
        update_phase plan "$A_SUMMARY"
        update_plan
        return 0
    fi
    update_phase stage "Getting it..."
    update_stage
    update_phase verify "Checking it loads..."
    update_verify
    update_phase apply "Applying..."
    mkdir -p "$UPDATE_STATE"
    printf '%s\n' "$U_HEAD" >"$UPDATE_STATE/previous"
    printf '%s\n' "$U_TARGET" >"$UPDATE_STATE/target"
    rm -f "$UPDATE_STATE/result.json"
    mark=$(update_log_mark)
    update_set_aside
    update_merge
    update_after_merge
    rm -rf "$STAGED"
    [ -z "$A_DEPS" ] || U_WARNINGS+=("this version needs $A_DEPS; run bash $U_DIR/install.sh")
    for line in "${U_WARNINGS[@]}"; do
        update_phase warning "$line"
    done
    update_finish_work "$mark"
}

update_finish_work() {
    local mark="$1" restart="$A_RESTART" pid=""
    if ! running; then
        update_conclude "Updated to $(update_label "$(cat "$UPDATE_STATE/target")"). The shell is not running; start it with banditshell start."
        return 0
    fi
    if [ "$restart" = 1 ]; then
        update_phase restart "Restarting..."
        stop_shell || true
        ensure_built || true
        if ! launch "$SHELL_DIR"; then
            update_roll_back "the new version did not start: ${HEALTH_WHY:-it failed to load}" 1
            return 1
        fi
        refresh_backup || true
        remember_checkout
    else
        update_phase health "Checking it started..."
        if pid=$(instance_of "$SHELL_DIR") && ! health_check "$pid" "$mark"; then
            update_roll_back "the new version did not start: $HEALTH_WHY" 1
            return 1
        fi
        [ -z "$pid" ] || refresh_backup || true
    fi
    update_conclude "Updated to $(update_label "$(cat "$UPDATE_STATE/target")")"
}

update_conclude() {
    dry && return 0
    ! update_skipped_here "$(cat "$UPDATE_STATE/target" 2>/dev/null || true)" || rm -f "$UPDATE_STATE/skip"
    update_result true ""
    update_phase "done" "$1"
}

update_roll_back() {
    local why="$1" relaunch="$2" hand="${3:-false}" previous="${4:-}" target out
    [ -n "$previous" ] || previous=$(cat "$UPDATE_STATE/previous" 2>/dev/null || true)
    target=$(cat "$UPDATE_STATE/target" 2>/dev/null || true)
    if dry; then
        say_dry "git reset --keep ${previous:0:7}, relaunch, write result.json, skip ${target:0:7}"
        return 0
    fi
    if ! out=$(ugit reset --keep --quiet "$previous" 2>&1); then
        [ "$hand" = true ] && update_fail "$out"
        update_result false "$why. Going back failed too: $(printf '%s' "$out" | tail -1)"
        update_phase failed "$why. Going back failed too."
        return 1
    fi
    printf '%s\n' "$target" >"$UPDATE_STATE/skip"
    ensure_built || true
    if [ "$relaunch" = 1 ]; then
        update_phase restart "Going back..."
        stop_shell || true
        if launch "$SHELL_DIR"; then
            refresh_backup || true
        else
            start_backup || true
        fi
    fi
    update_result false "$why" "$hand"
    [ "$hand" = true ] || complain "update $(update_label "$target") did not start, back on $(update_label "$previous")"
    update_phase rolledback "Went back to $(update_label "$previous")"
}

update_rollback() {
    local previous target head arg detach=0
    UPDATE_JSON=0
    [ -z "${BANDITSHELL_JSON:-}" ] || UPDATE_JSON=1
    for arg in "$@"; do
        case "$arg" in
        --json) UPDATE_JSON=1 ;;
        --detach) detach=1 ;;
        *) say_usage "update rollback [--detach] [--json]" ;;
        esac
    done
    UPDATE_APPLYING=1
    if [ "$detach" = 1 ] && ! dry; then
        mkdir -p "$UPDATE_STATE"
        : >"$UPDATE_STATE/progress.log"
        (cd "$HOME" && detach "$(readlink -f "${BASH_SOURCE[0]}")" update rollback --json 8>&- </dev/null >>"$UPDATE_STATE/progress.log" 2>>"$UPDATE_STATE/apply.log")
        return 0
    fi
    update_prepare
    dry || update_lock -n
    [ "$UPDATE_JSON" = 0 ] || update_phase goback "Going back..."
    update_read
    [ "$U_STATE" != paused ] || update_fail "fatal: $(update_state_text)"
    [ "$U_AHEAD" -eq 0 ] || update_fail "fatal: this copy has $U_AHEAD commit(s) of its own, and going back would take them off the branch"
    head=$(ugit rev-parse HEAD)
    if [ "$U_BRANCH" = stable ]; then
        [ -n "$U_PREVIOUS" ] || update_fail "fatal: there is no earlier release to go back to"
        previous="$U_PREVIOUS"
    else
        previous=$(cat "$UPDATE_STATE/previous" 2>/dev/null || true)
    fi
    [ -n "$previous" ] && [ "$previous" != "$head" ] || update_fail "fatal: there is no earlier version recorded to go back to"
    ugit cat-file -e "$previous^{commit}" 2>/dev/null || update_fail "fatal: the recorded earlier version is no longer in this copy"
    [ "$U_PREVIOUS" = "$previous" ] || update_fail "fatal: the recorded earlier version is not behind this one"
    printf '%s\n' "$head" >"$UPDATE_STATE/target"
    update_roll_back "rolled back by hand" "$(running && echo 1 || echo 0)" true "$previous"
}

update_oneline() {
    case "$U_STATE" in
    available) echo "$(update_label "$U_HEAD") on $U_BRANCH, $(update_label "$U_TARGET") is waiting: $1" ;;
    *) echo "$(update_label "$U_HEAD") on $U_BRANCH_NOW, $(update_state_text)" ;;
    esac
}

update_status() {
    local full="$1" json=0 dir summary="" arg result last
    shift
    [ -z "${BANDITSHELL_JSON:-}" ] || json=1
    for arg in "$@"; do
        case "$arg" in
        --json) json=1 ;;
        *) say_usage "update status [--json]" ;;
        esac
    done
    UPDATE_JSON=$json
    update_prepare
    update_read
    if [ "$U_STATE" = available ]; then
        dir=$(mktemp -d)
        update_facts "$dir"
        if update_has_node; then
            if [ "$json" = 1 ]; then
                summary=$(node "$U_DIR/services/update.js" report "$dir" --json)
            else
                summary=$(node "$U_DIR/services/update.js" report "$dir" --lines | sed -n 's/^summary=//p')
            fi
        else
            summary="$U_BEHIND changes (node is missing, so they were not read)"
            [ "$json" = 0 ] || summary="$(update_meta_json),\"summary\":$(json_quote "$summary")}"
        fi
        rm -rf "$dir"
    fi
    result=$(cat "$UPDATE_STATE/result.json" 2>/dev/null || true)
    if [ "$json" = 1 ]; then
        [ -n "$summary" ] || summary="$(update_meta_json)}"
        printf '%s,"result":%s}\n' "${summary%\}}" "${result:-null}"
        exit 0
    fi
    update_oneline "$summary"
    [ "$full" = full ] || exit 0
    last=$(update_last_result "$result")
    [ -z "$last" ] || echo "$last"
    if [ -n "$U_PREVIOUS" ]; then
        echo "banditshell update rollback goes back to $(update_label "$U_PREVIOUS")"
    elif [ "$U_BRANCH" != stable ] && [ -s "$UPDATE_STATE/previous" ]; then
        echo "before the last update: $(head -c 7 "$UPDATE_STATE/previous")"
    fi
    exit 0
}

update_last_result() {
    local ok why to
    [ -n "$1" ] || return 0
    ok=$(sed -n 's/.*"ok":\(true\|false\).*/\1/p' <<<"$1")
    to=$(sed -n 's/.*"toLabel":"\([^"]*\)".*/\1/p' <<<"$1")
    why=$(sed -n 's/.*"why":"\([^"]*\)".*/\1/p' <<<"$1")
    if [ "$ok" = true ]; then
        echo "last update: reached $to"
    else
        echo "last update: $to did not start${why:+ ($why)}; it is skipped until a newer version arrives"
    fi
}

route_events() {
    local filter="" file name pattern="" words line follower_pid
    local -a names
    while [ $# -gt 0 ]; do
        case "$1" in
        --json) ;;
        --filter)
            [ $# -ge 2 ] || say_usage "events [--filter <names>]"
            filter="$2"
            shift
            ;;
        --filter=*) filter="${1#--filter=}" ;;
        *) nope events "$1" ;;
        esac
        shift
    done
    if [ -n "$filter" ]; then
        IFS=, read -ra names <<<"$filter"
        for name in "${names[@]}"; do
            [[ $name =~ ^[a-z]+(\.[a-z]+)?$ ]] || { complain "events --filter wants names like panel or media.track, not $name"; exit 2; }
            pattern="${pattern:+$pattern|}${name//./\\.}"
        done
    fi
    running || { complain "not running (try: banditshell start)"; exit 3; }
    file="$RUN_DIR/events.jsonl"
    mkdir -p "$RUN_DIR" 2>/dev/null || true
    [ -e "$file" ] || : >"$file" 2>/dev/null || true
    if [ -z "$pattern" ]; then
        exec tail -n 0 -F "$file" 2>/dev/null
    fi
    words="\"event\":\"($pattern)(\\.[a-z]+)?\""
    coproc follower { exec tail -n 0 -F "$file" 2>/dev/null; }
    # shellcheck disable=SC2154
    follower_pid="$follower_PID"
    trap 'kill "$follower_pid" 2>/dev/null; exit 0' EXIT TERM INT HUP PIPE
    while IFS= read -r line <&"${follower[0]}"; do
        if [[ $line =~ $words ]]; then printf '%s\n' "$line"; fi
    done
}

route_update() {
    local sub="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$sub" in
    "") update_status line ;;
    check) update_check "$@" ;;
    apply) update_apply "$@" ;;
    rollback) update_rollback "$@" ;;
    status) update_status full "$@" ;;
    *) nope update "$sub" ;;
    esac
}

migrate_or_fail() {
    local rewritten lead i suffix
    local -a words kept lead_words external
    if [ -z "$migrated" ] && command -v node >/dev/null &&
        rewritten=$(node "$SHELL_DIR/services/cli-migration.js" --cmd "$*" 2>/dev/null) &&
        [ -n "$rewritten" ]; then
        if [[ $rewritten == "!"* ]]; then
            read -ra external <<<"${rewritten#!}"
            echo "banditshell: that is ${external[0]}'s job now: ${rewritten#!}" >&2
            exec "${external[@]}"
        fi
        words=("$@")
        lead="$rewritten"
        kept=()
        for ((i = 0; i < ${#words[@]}; i++)); do
            kept=("${words[@]:i}")
            suffix="${kept[*]}"
            if [ "$rewritten" = "$suffix" ]; then
                lead=""
                break
            elif [[ $rewritten == *" $suffix" ]]; then
                lead="${rewritten% "$suffix"}"
                break
            fi
            kept=()
        done
        read -ra lead_words <<<"$lead"
        BANDITSHELL_MIGRATED=1 exec "${BASH_SOURCE[0]}" "${lead_words[@]}" "${kept[@]}"
    fi
    echo "banditshell: no command $*" >&2
    usage >&2
    exit 2
}

if [ $# -gt 0 ] && [ "$1" != update ] && [ "$1" != events ] && [ "${!#}" = --json ] && [ -z "${BANDITSHELL_JSON:-}" ]; then
    as_json "${@:1:$#-1}"
fi

if [ "${1:-}" = action ] && [ -n "${BANDITSHELL_ROW:-}" ]; then
    hinted=()
    if hinted_action "${2:-}"; then
        set -- "${hinted[@]}" "${@:3}"
    fi
fi
unset BANDITSHELL_ROW

cmd="${1:-help}"
shift || true

if [ "$cmd" != help ] && [ "$cmd" != -h ] && [ "$cmd" != --help ]; then
    case "$cmd:${1:-}" in
    log:-h | log:--help) ;;
    *:help | *:-h | *:--help) group_help "$cmd" && exit 0 ;;
    esac
fi

case "$cmd" in
panel)
    route_panel "$@"
    ;;
notifications)
    route_notifications "$@"
    ;;
island)
    route_island "$@"
    ;;
output)
    route_output "$@"
    ;;
screen)
    route_screen "$@"
    ;;
wallpaper)
    route_wallpaper "$@"
    ;;
screenshot)
    route_screenshot "$@"
    ;;
clock)
    route_clock "$@"
    ;;
focus)
    route_focus "$@"
    ;;
tablet)
    route_tablet "$@"
    ;;
config)
    route_config "$@"
    ;;
update)
    route_update "$@"
    ;;
start)
    running && { echo "already running"; exit 0; }
    start_checkout "started"
    ;;
stop)
    if stop_shell; then
        echo "stopped"
    else
        echo "not running"
    fi
    ;;
restart)
    if trial=$(live_worktree); then
        try_worktree "$trial"
        exit 0
    fi
    stop_shell || true
    start_checkout "restarted"
    ;;
unstick)
    [ $# -eq 0 ] || nope unstick "$1"
    unstick
    ;;
watchdog)
    [ $# -eq 0 ] || nope watchdog "$1"
    watchdog
    ;;
triage)
    triage "$@"
    ;;
status)
    [ $# -eq 0 ] || migrate_or_fail status "$@"
    ipc shell status
    ;;
log)
    exec qs -p "$(live_dir || echo "$SHELL_DIR")" log "$@"
    ;;
doctor)
    case "${1:-}" in
    "") doctor ;;
    --report) [ $# -eq 1 ] || nope doctor "--report $2"; doctor_report ;;
    api) doctor_api ;;
    binds)
        case "${2:-}" in
        "") ipc migration status ;;
        rewrite) ipc migration migrate ;;
        *) nope doctor "binds $2" ;;
        esac ;;
    *) nope doctor "$1" ;;
    esac
    ;;
completions)
    route_completions "$@"
    ;;
dev)
    route_dev "$@"
    ;;
action)
    route_action "$@"
    ;;
api)
    route_api "$@"
    ;;
version)
    route_version
    ;;
events)
    route_events "$@"
    ;;
help | -h | --help)
    if [ $# -gt 0 ]; then
        group_help "$1" || { echo "banditshell: no command $1" >&2; usage >&2; exit 2; }
    else
        usage
    fi
    ;;
*)
    migrate_or_fail "$cmd" "$@"
    ;;
esac
