#!/usr/bin/env bash
# banditshell - drive the shell from a terminal or a keybind
#
# panel                          the launcher, menus and every other panel
#   banditshell panel            every panel and menu by name
#   banditshell panel close      every panel away
#   banditshell panel <panel> [toggle|open|close|status] [screen]
#                                one panel; bare, whether it is open
#   banditshell panel files [toggle|open] [dir]
#                                the file browser, in a folder
#   banditshell panel settings open [page] [screen]
#   banditshell panel settings page <page>
#                                settings on a page, or another page while it stays
#                                put
#   banditshell panel launcher run <app|row>
#                                start an app the way the launcher does, or run
#                                any launcher row by its id, like command:lock
#   banditshell panel keyboard [dock|float]
#   banditshell panel keyboard page <layer> [screen]
#                                dock or float the on-screen keyboard, or show one
#                                of its layers
#   banditshell panel clipboard list
#   banditshell panel clipboard [use|pin|remove] <index>
#   banditshell panel clipboard clear
#                                the clipboard's history
#   banditshell panel calculator [full|compact]
#   banditshell panel calculator answer <expression>
#                                open the calculator in a shape, or answer without
#                                opening it
#   banditshell panel notifications clear
#                                empty the notification history
#   <panel>: launcher|session|clipboard|media|calculator|quickcontrols
#            keyboard|settings|notifications|island|hotkeys|files|wallpaper
#                                and every menu; banditshell panel lists them all
#
# output                         which device plays: the speakers or the headphones
#   banditshell output           what plays, and which device is which
#   banditshell output [speakers|headphones|toggle]
#                                play through one, or flip between them
#   banditshell output list      every device that can play
#   banditshell output assign [speakers|headphones] <device>
#                                name the device that is the speakers or the
#                                headphones
#
# screen                         brightness, temperature, border, sidebar, stream
#   banditshell screen           all of it at once
#   banditshell screen brightness [<percent>|+n|-n]
#                                every display that answers DDC; .5 is 50 percent,
#                                a bare + or - moves 10
#   banditshell screen temperature [<kelvin>|off]
#                                warm the colours, or stop
#   banditshell screen border [on|off|toggle]
#                                the shell's frame; off is the bare desktop
#   banditshell screen sidebar [on|off|toggle] [<screen>|all]
#                                the sidebar, on one screen or on every one
#   banditshell screen stream on [screen]
#   banditshell screen stream off
#                                streamer mode: a band with the OBS deck across
#                                one screen
#
# wallpaper                      the picture: next, previous, a file, on or off
#   banditshell wallpaper        what each screen wears; the picker is banditshell
#                                panel wallpaper
#   banditshell wallpaper [on|off|toggle]
#   banditshell wallpaper [next|prev|clear] [<screen>|all]
#   banditshell wallpaper set <file> [<screen>|all]
#                                wear a file, on one screen or on every one
#   banditshell wallpaper list [screen]
#   banditshell wallpaper palette
#                                every picture, or the colours of the one worn
#
# screenshot                     a region saved or copied, or the whole desktop
#   banditshell screenshot save [--freeze]
#                                pick a region, save it and open the editor;
#                                --freeze stills the screen before the pick
#   banditshell screenshot copy [--freeze]
#                                pick a region onto the clipboard. Without the
#                                shell, save and copy fall back on grim and slurp
#   banditshell screenshot full [file]
#                                the whole desktop, no picking
#
# clock                          timers, alarms and world clocks
#   banditshell clock            the timers and the alarms
#   banditshell clock timer start <duration> [label]
#   banditshell clock timer [pause|resume|toggle|cancel] [handle]
#                                a duration is 10 (minutes), 90s or 1h30m; bare,
#                                the running timers
#   banditshell clock alarm add <time> [--days <days>] [--label <text>] [--run <command>|--ask <message>]
#                                when it rings, --run runs a command and --ask
#                                sends the message through clock.cloud
#   banditshell clock alarm [list|snooze|stop]
#   banditshell clock alarm [enable|disable|remove] <handle>
#                                bare, the next alarm and what is ringing
#   banditshell clock zone list
#   banditshell clock zone [find|add|remove] <place>
#                                the world clocks in the clock menu
#
# focus                          modes, and quiet notifications
#   banditshell focus            the mode, and whether notifications are quiet
#   banditshell focus mode [none|work|play|stream|sleep|list]
#                                the mode, or switch to one; none puts back what
#                                the last one changed
#   banditshell focus quiet [on|off|toggle] [hour|evening|tomorrow|never]
#                                quiet notifications still collect in history but
#                                show no popup and make no sound; the second word
#                                is when quiet ends
#
# tablet                         tablet mode, the lid and the pen's area
#   banditshell tablet           the hinge, the lid and the pen's area
#   banditshell tablet [on|off|toggle] [caller]
#   banditshell tablet lid [open|closed|toggle] [caller]
#                                tablet mode and the lid as the shell believes
#                                them; caller names who said so
#   banditshell tablet probe
#   banditshell tablet probe lid
#                                ask the hardware, and say how it answered
#   banditshell tablet pen [edit|commit|cancel|aspect|centre|follow]
#                                edit opens the mapper over the screen; the rest
#                                act on it
#   banditshell tablet pen area <x> <y> <width> <height>
#                                map the pen to a rectangle without the mapper
#
# config                         read and write settings, pick a theme
#   banditshell config get <key>
#                                a dotted key in config.json
#   banditshell config set <key> <value>
#                                write one; the shell takes it at once
#   banditshell config theme [<theme>|list]
#                                the theme; bare, its name
#
# start|stop|restart|status|log|doctor
#                                the shell itself
#   banditshell start            start the shell and wait until it is up
#   banditshell stop             stop it, a tried worktree included
#   banditshell restart          stop it and start it again, a tried worktree
#                                included
#   banditshell status [--json]  what the shell thinks the compositor said
#   banditshell log [args]       the running shell's log
#   banditshell doctor [--json]  repair bin/, the helpers and ~/bin/banditshell,
#                                put the Lua module in place, then report
#                                quickshell, dkms, failed units and binds in an
#                                old form
#   banditshell doctor api       put the Lua module in place and check it: the
#                                shim in your Hyprland config, the checkout
#                                pointer, every action id, your binds and the
#                                banditshell on your PATH; exits 1 on a failure
#   banditshell doctor binds     the binds still in an old form, and where
#   banditshell doctor binds rewrite
#                                rewrite them, a .bak beside each file
#
# action                         run a stable action by its id
#   banditshell action <id> [args...]
#                                the names a bind keeps across updates. The id is
#                                looked up in api/actions.tsv when it runs, then
#                                run as whatever command it stands for today, so
#                                a renamed command never breaks a bind
#
# api                            the table of stable action ids
#   banditshell api list [<pattern>] [--json]
#                                every id with its status and what it does; a
#                                pattern like 'panel.*' narrows the list
#   banditshell api show <id>    one id: the command it runs, since which API
#   banditshell api check        every id against the commands this CLI has, and
#                                the table against the Lua module; exits 1 on a
#                                failure
#
# version                        which build is installed
#   banditshell version [--json]
#                                the newest what's-new id, the commit and branch,
#                                the checkout, the API number and the Quickshell
#                                and Hyprland versions
#
# completions                    tab completion for zsh and bash
#   banditshell completions [install|status|remove|print] [zsh|bash]
#                                built from this text, and rebuilt on the first
#                                Tab after it changes
#
# dev                            working on banditshell: try, build, test, preview
#   banditshell dev try [worktree]
#                                run a worktree on the live session in place of
#                                the checkout: its branch, its number in the list
#                                or any unique part of its name, 0 for the
#                                checkout; bare, the one you are in, the only one,
#                                or a pick, once the merged ones are cleared and a
#                                merged one running has gone back to the checkout
#   banditshell dev back         the checkout again, after try
#   banditshell dev tidy         clear every worktree whose work is merged, with
#                                its branch, going back to the checkout first if
#                                one of them is running; then list the rest and
#                                their pull requests
#   banditshell dev watch        while a worktree runs, go back to the checkout
#                                once it is merged; try starts this itself
#   banditshell dev worktrees    every worktree's branch
#   banditshell dev run          the shell in the foreground
#   banditshell dev build        compile src/*.c into bin/
#   banditshell dev shaders      compile components/**/*.frag to .qsb
#   banditshell dev test [args]  run tests/*.test.js in node
#   banditshell dev check        compile every QML file in a fresh engine, then
#                                run the tests
#   banditshell dev check island [dir]
#                                walk the island through every situation it has
#                                a rule for, headless: each checked, and
#                                photographed into dir
#   banditshell dev inspect island [screen]
#                                look at every situation on the live island:
#                                a panel on the right makes each one up, and
#                                you hover and click the island itself
#   banditshell dev inspect close
#                                end it and take everything made up away
#   banditshell dev preview lock [file]
#                                the lock face, photographed
#   banditshell dev preview settings [WxH] [page] [file]
#                                the settings face at a size, photographed
#   banditshell dev preview files [dir] [file]
#                                the file browser in a window; with a file,
#                                photographed
#   banditshell dev preview gallery [WxH]
#                                every component the shell owns, in a window
#   banditshell dev preview menu <menu> [file]
#                                open a menu, photograph it, put it away
#   banditshell dev menu [current|hover|list]
#                                the open menu, the one under the pointer, or
#                                every menu
#   banditshell dev launcher scrub <fraction>
#                                hold the launcher's letter rail at 0 to 1; below
#                                0 lets go
#   banditshell dev keyring [status|demo|close]
#                                the keyring's password prompt: what it asks, a
#                                made-up question, or refuse it
#   banditshell dev polkit [status|demo|close]
#                                the shell's polkit password prompt: whether the
#                                shell is the agent, what it asks, a made-up
#                                question, or refuse it
#
# help                           this list; banditshell help <command> for one
#   banditshell help [<command>]
#
# exit codes: 0 done, 1 failed, 2 usage, 3 the shell is not running, 4 the shell
# refused. --json after a status command prints it as JSON.

set -euo pipefail

SHELL_DIR="${BANDITSHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SHOT_DIR="${BANDITSHELL_SHOTS:-${XDG_RUNTIME_DIR:-/tmp}/banditshell}"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/banditshell"
PID_FILE="$RUN_DIR/pid"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/banditshell"
HYPR_DIR="${HYPR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"
SHIM_NAME=banditshell.lua
BACKUP="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/lastgood"
FAILED_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/failed.log"
SURFACES=(launcher session clipboard media calculator quickcontrols keyboard settings notifications island hotkeys files wallpaper)
HELPERS=(bs-pty bs-ls bs-gamma)

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' magenta=$'\e[35m' cyan=$'\e[36m' plain=$'\e[0m'
else
    bold="" dim="" red="" green="" yellow="" magenta="" cyan="" plain=""
fi

qs_target=()
qs_target_resolved=0
migrated="${BANDITSHELL_MIGRATED:-}"
unset BANDITSHELL_MIGRATED

list_instances() {
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Process ID:/ { pid = $NF }
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            print pid "\t" p
        }
    '
}

instance_of() {
    local pid path
    while IFS=$'\t' read -r pid path; do
        [ "$path" = "$1/shell.qml" ] && { echo "$pid"; return 0; }
    done < <(list_instances)
    return 1
}

worktree_list() {
    git -C "$SHELL_DIR" worktree list --porcelain 2>/dev/null | awk '
        /^worktree / { path = substr($0, 10); branch = "(detached)" }
        /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        /^$/ && path != "" { print path "\t" branch; path = "" }
        END { if (path != "") print path "\t" branch }
    '
}

main_dir() {
    local path branch
    if IFS=$'\t' read -r path branch < <(worktree_list) && [ -n "$path" ]; then
        echo "$path"
    else
        echo "$SHELL_DIR"
    fi
}

branch_of() {
    local path branch
    while IFS=$'\t' read -r path branch; do
        [ "$path" = "$1" ] && { echo "$branch"; return 0; }
    done < <(worktree_list)
    echo "${1##*/}"
}

known_shells() {
    printf '%s/shell.qml\n' "$SHELL_DIR" "$BACKUP"
    worktree_list | cut -f1 | sed 's|$|/shell.qml|'
}

shell_pids() {
    local pid path known
    known=$(known_shells)
    while IFS=$'\t' read -r pid path; do
        if grep -qxF -- "$path" <<<"$known"; then
            echo "$pid"
        fi
    done < <(list_instances)
}

live_dir() {
    local pid path known
    known=$(known_shells)
    while IFS=$'\t' read -r pid path; do
        if grep -qxF -- "$path" <<<"$known"; then
            echo "${path%/shell.qml}"
            return 0
        fi
    done < <(list_instances)
    return 1
}

live_worktree() {
    local live
    live=$(live_dir) || return 1
    [ "$live" != "$(main_dir)" ] && [ "$live" != "$BACKUP" ] || return 1
    echo "$live"
}

match_worktree() {
    local want="$1" home path branch folder number=0
    local -a hits=()
    [ -n "$want" ] || return 1
    home=$(main_dir)
    if [ -d "$want" ]; then
        want=$(git -C "$want" rev-parse --show-toplevel 2>/dev/null || echo "$want")
    fi
    while IFS=$'\t' read -r path branch; do
        if [ "$path" = "$home" ]; then
            [ "$want" = 0 ] || [ "$want" = "$branch" ] || [ "$want" = "$path" ] || continue
            hits=("$path")
            break
        fi
        number=$((number + 1))
        folder="${path##*/}"
        if [[ $want == /* ]]; then
            [ "$want" = "$path" ] && hits=("$path") && break
        elif [[ $want =~ ^[0-9]+$ ]]; then
            [ "$want" = "$number" ] && hits=("$path") && break
        elif [ "$want" = "$branch" ] || [ "$want" = "$folder" ]; then
            hits=("$path")
            break
        elif [[ ${branch,,} == *"${want,,}"* || ${folder,,} == *"${want,,}"* ]]; then
            hits+=("$path")
        fi
    done < <(worktree_list)
    [ "${#hits[@]}" -eq 1 ] || return 1
    echo "${hits[0]}"
}

other_worktrees() { worktree_list | tail -n +2; }

pick_worktree() {
    local home live guess target
    local -a others=()
    home=$(main_dir)
    live=$(live_dir || true)
    for guess in "$(git rev-parse --show-toplevel 2>/dev/null || true)" "$SHELL_DIR"; do
        target=$(match_worktree "$guess") || continue
        if [ "$target" != "$home" ] && [ "$target" != "$live" ]; then
            echo "$target"
            return 0
        fi
    done
    mapfile -t others < <(other_worktrees | cut -f1)
    [ "${#others[@]}" -eq 1 ] && [ "${others[0]}" != "$live" ] || return 1
    echo "${others[0]}"
}

pulls=""
pulls_loaded=0
cleared=0

main_ref() {
    local branch
    branch=$(branch_of "$1")
    if git -C "$1" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
        echo "origin/$branch"
    else
        echo "$branch"
    fi
}

load_pulls() {
    [ "$pulls_loaded" = 0 ] || return 0
    pulls_loaded=1
    command -v gh >/dev/null || return 0
    pulls=$(cd "$(main_dir)" && timeout 8 gh pr list --state all --limit 200 \
        --json number,headRefName,state,headRefOid \
        --jq '.[] | [.headRefName, .number, (.state | ascii_downcase), .headRefOid] | @tsv' 2>/dev/null) || pulls=""
}

pull_of() { awk -F'\t' -v branch="$1" '$1 == branch { print $2 "\t" $3 "\t" $4; exit }' <<<"$pulls"; }

pull_label() {
    local number state
    IFS=$'\t' read -r number state _ <<<"$(pull_of "$1")"
    [ -z "$number" ] || echo "#$number $state"
}

landed() {
    local home="$1" base="$2" branch="$3" tip="$4" number state merged_tip
    IFS=$'\t' read -r number state merged_tip <<<"$(pull_of "$branch")"
    if [ "$state" = merged ] && { [ "$merged_tip" = "$tip" ] || git -C "$home" merge-base --is-ancestor "$tip" "$base"; }; then
        echo "merged #$number"
        return 0
    fi
    git -C "$home" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null &&
        git -C "$home" merge-base --is-ancestor "refs/remotes/origin/$branch" "$base" &&
        git -C "$home" merge-base --is-ancestor "$tip" "$base" || return 1
    echo "on $base"
}

tidy_worktrees() {
    local home base live here entries checked path branch tip why changed
    home=$(main_dir)
    if git -C "$home" remote get-url origin >/dev/null 2>&1; then
        timeout 10 git -C "$home" fetch --quiet origin "$(branch_of "$home")" 2>/dev/null &
    fi
    load_pulls
    wait
    base=$(main_ref "$home")
    live=$(live_dir || true)
    here=$(git rev-parse --show-toplevel 2>/dev/null || true)
    git -C "$home" worktree prune 2>/dev/null || true
    entries=$(worktree_list)
    while IFS=$'\t' read -r path branch; do
        [ "$path" != "$home" ] || continue
        tip=$(git -C "$path" rev-parse -q --verify HEAD 2>/dev/null) || continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        changed=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
        if [ "$path" = "$here" ]; then
            echo "${yellow}kept $branch, $why: you are in it$plain"
        elif [ "$changed" -gt 0 ]; then
            echo "${yellow}kept $branch, $why: $changed changed since$plain"
        elif [ -f "$(git -C "$path" rev-parse --absolute-git-dir)/locked" ]; then
            echo "${yellow}kept $branch, $why: locked$plain"
        elif [ "$path" = "$live" ] && ! leave_merged "$home" "$base" "$branch" "$tip" "$why"; then
            continue
        elif git -C "$home" worktree remove "$path"; then
            git -C "$home" branch -qD "$branch" 2>/dev/null || true
            echo "${dim}cleared$plain $branch$dim, $magenta$why$plain"
            cleared=$((cleared + 1))
        fi
    done <<<"$entries"
    checked=$(cut -f2 <<<"$entries")
    while IFS=$'\t' read -r branch tip; do
        grep -qxF -- "$branch" <<<"$checked" && continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        if git -C "$home" branch -qD "$branch"; then
            echo "${dim}cleared$plain $branch$dim, $magenta$why$dim, no worktree$plain"
            cleared=$((cleared + 1))
        fi
    done < <(git -C "$home" for-each-ref --format='%(refname:short)%09%(objectname)' refs/heads)
}

leave_merged() {
    local home="$1" base="$2" branch="$3" tip="$4" why="$5"
    if ! git -C "$home" merge-base --is-ancestor "$tip" HEAD; then
        if [ "$(git -C "$home" symbolic-ref -q --short HEAD)" != "${base#origin/}" ] ||
            ! git -C "$home" merge --ff-only --quiet "$base" >/dev/null 2>&1; then
            echo "${yellow}kept $branch, $why: it is running, and the checkout cannot move up to $base on its own (update it, then banditshell dev back)$plain"
            return 1
        fi
        echo "${dim}moved the checkout up to $base$plain"
    fi
    echo "${dim}$branch is $why and running, so back to the checkout$plain"
    go_back
}

watch_merges() {
    local home base live branch tip why
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/banditshell-watch.lock"
    flock -n 9 || exit 0
    while sleep 120; do
        live=$(live_worktree) || exit 0
        home=$(main_dir)
        branch=$(branch_of "$live")
        timeout 30 git -C "$home" fetch --quiet origin "$(branch_of "$home")" 2>/dev/null || continue
        pulls_loaded=0
        load_pulls
        base=$(main_ref "$home")
        tip=$(git -C "$live" rev-parse -q --verify HEAD 2>/dev/null) || continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        [ -z "$(git -C "$live" status --porcelain 2>/dev/null)" ] || continue
        leave_merged "$home" "$base" "$branch" "$tip" "$why" 9>&- >/dev/null 2>&1 || continue
        notify-send -a banditshell "Back on $(branch_of "$home")" "$branch is $why" 2>/dev/null || true
        exit 0
    done
}

list_worktrees() {
    local live home base entries path branch label number=0 ahead changed pull width=0
    local label_tint branch_tint ahead_tint changed_tint pull_tint
    live=$(live_dir || true)
    home=$(main_dir)
    base=$(main_ref "$home")
    entries=$(worktree_list)
    load_pulls
    while IFS=$'\t' read -r path branch; do
        [ "${#branch}" -le "$width" ] || width=${#branch}
    done <<<"$entries"
    while IFS=$'\t' read -r path branch; do
        label=$number label_tint=$bold branch_tint=""
        if [ "$path" = "$live" ]; then
            label="*" label_tint=$green branch_tint=$green
        fi
        number=$((number + 1))
        pull=""
        [ "$path" = "$home" ] || pull=$(pull_label "$branch")
        case "$pull" in
        *open) pull_tint=$green ;;
        *merged) pull_tint=$magenta ;;
        *closed) pull_tint=$red ;;
        *) pull_tint="" ;;
        esac
        ahead=$(git -C "$path" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
        ahead_tint=$dim
        [ "$ahead" -eq 0 ] || ahead_tint=$cyan
        changed=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
        changed_tint=$dim
        [ "$changed" -eq 0 ] || changed_tint=$yellow
        printf '%s%3s%s  %s%-*s%s  %s+%-3s%s %s%3s changed%s  %s%-11s%s %s%s%s\n' \
            "$label_tint" "$label" "$plain" "$branch_tint" "$width" "$branch" "$plain" \
            "$ahead_tint" "$ahead" "$plain" "$changed_tint" "$changed" "$plain" \
            "$pull_tint" "$pull" "$plain" "$dim" "${path/#"$HOME"/\~}" "$plain"
    done <<<"$entries"
}

cached_pid() {
    local pid dir
    [ -r "$PID_FILE" ] || return 1
    IFS=$'\t' read -r pid dir <"$PID_FILE" || return 1
    [ "$dir" = "$SHELL_DIR" ] || return 1
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
    qs | quickshell*) echo "$pid" ;;
    *) return 1 ;;
    esac
}

remember_pid() {
    mkdir -p "$RUN_DIR" 2>/dev/null || return 0
    printf '%s\t%s\n' "$1" "$SHELL_DIR" >"$PID_FILE" 2>/dev/null || true
}

resolve_target() {
    if [ "$qs_target_resolved" = 1 ]; then
        return 0
    fi
    qs_target_resolved=1

    local pid path exact="" any=""
    if pid=$(cached_pid); then
        qs_target=(--pid "$pid")
        return 0
    fi
    while IFS=$'\t' read -r pid path; do
        case "$path" in
        "$SHELL_DIR/shell.qml") exact="$pid" ;;
        */shell.qml) [ -n "$any" ] || any="$pid" ;;
        esac
    done < <(list_instances)

    local pick="${exact:-$any}"
    if [ -n "$pick" ]; then
        qs_target=(--pid "$pick")
        remember_pid "$pick"
    else
        qs_target=(-p "$SHELL_DIR")
    fi
}

complain() {
    echo "${red}banditshell: $1$plain" >&2
    hyprctl notify -1 5000 "rgb(e06c75)" "banditshell: $1" >/dev/null 2>&1 || true
}

reply_of() {
    case "$1" in
    "refused: "*)
        echo "banditshell: ${1#refused: }" >&2
        return 4
        ;;
    "no shell window"* | "no such "*)
        echo "banditshell: $1" >&2
        return 4
        ;;
    "usage: "*)
        echo "banditshell: $1" >&2
        return 2
        ;;
    esac
    [ -z "$1" ] || printf '%s\n' "$1"
    return 0
}

ipc() {
    local out
    if [ -n "${BANDITSHELL_DRY:-}" ]; then
        echo "ipc $*"
        return 0
    fi
    resolve_target
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        reply_of "$out"
        return $?
    fi
    if [ "${qs_target[0]}" = --pid ] && kill -0 "${qs_target[1]}" 2>/dev/null; then
        complain "the shell is running but did not take \`$*\` (a build older than this CLI? try: banditshell restart)"
        return 4
    fi
    complain "not running (try: banditshell start)"
    return 3
}

ipc_quiet() {
    local out
    if [ -n "${BANDITSHELL_DRY:-}" ]; then
        echo "ipc $*"
        return 0
    fi
    resolve_target
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    return 1
}

running() {
    cached_pid >/dev/null && return 0
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            if (p ~ /\/shell\.qml$/) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

refresh_backup() {
    mkdir -p "$BACKUP"
    rsync -a --delete --exclude .git --exclude .claude --exclude .scratch \
        "$SHELL_DIR/" "$BACKUP/"
}

launch() {
    local out tries=0
    out=$(mktemp)
    if ! (cd "$HOME" && qs -d -p "$1") >"$out" 2>&1 || grep -q "Failed to load configuration" "$out"; then
        mkdir -p "$(dirname "$FAILED_LOG")"
        cat "$out" >>"$FAILED_LOG"
        rm -f "$out"
        return 1
    fi
    while [ "$tries" -lt 30 ]; do
        if instance_of "$1" >/dev/null; then
            sleep 1
            if instance_of "$1" >/dev/null; then
                rm -f "$out"
                return 0
            fi
            break
        fi
        sleep 0.2
        tries=$((tries + 1))
    done
    mkdir -p "$(dirname "$FAILED_LOG")"
    cat "$out" >>"$FAILED_LOG"
    rm -f "$out"
    return 1
}

start_backup() {
    if [ ! -f "$BACKUP/shell.qml" ]; then
        complain "shell failed to load and there is no backup yet (errors: $FAILED_LOG)"
        return 1
    fi
    complain "shell failed to load - running the last known good copy (errors: $FAILED_LOG)"
    launch "$BACKUP"
}

stop_shell() {
    local -a pids
    local pid alive tries=0
    mapfile -t pids < <(shell_pids)
    [ "${#pids[@]}" -gt 0 ] || return 1
    kill "${pids[@]}" 2>/dev/null || true
    while [ "$tries" -lt 40 ]; do
        alive=0
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                alive=1
            fi
        done
        [ "$alive" = 0 ] && return 0
        sleep 0.05
        tries=$((tries + 1))
    done
    return 0
}

start_checkout() {
    ensure_lua || true
    ensure_built || complain "checkout incomplete, starting anyway (run: banditshell doctor)"
    if launch "$SHELL_DIR"; then
        refresh_backup
        echo "$green$1$plain"
    else
        start_backup || exit 1
        echo "running from backup - the checkout itself failed to load (errors: $FAILED_LOG)" >&2
        exit 1
    fi
}

try_worktree() {
    local target="$1" name live
    name=$(branch_of "$target")
    (SHELL_DIR="$target" && ensure_lua) || true
    (SHELL_DIR="$target" && ensure_built) || complain "$name: helpers not built, trying it anyway (run: banditshell dev build in it)"
    live=$(live_dir || true)
    [ -z "$live" ] || [ "$live" = "$target" ] || echo "${dim}leaving $(branch_of "$live") for $name$plain"
    stop_shell || true
    if launch "$target"; then
        echo "${green}trying $name$plain$dim - back to the checkout on its own once merged, or banditshell dev back$plain"
        (cd "$HOME" && setsid -f "$(readlink -f "${BASH_SOURCE[0]}")" dev watch </dev/null >/dev/null 2>&1) || true
        return 0
    fi
    complain "$name failed to load - back on the checkout (errors: $FAILED_LOG)"
    SHELL_DIR=$(main_dir)
    start_checkout "back on $(branch_of "$SHELL_DIR")"
    exit 1
}

header() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$(readlink -f "${BASH_SOURCE[0]}")"; }

usage() {
    header | awk '
        function emit() {
            if (name == "")
                return
            if (length(name) > 12)
                printf "  %s\n%15s%s\n", name, "", text
            else
                printf "  %-12s %s\n", name, text
            name = ""
        }
        NR == 1 { print; print ""; next }
        /^[a-z][a-z|]*( |$)/ && !/^[a-z]+ [^ ]/ {
            emit()
            name = $1
            gsub(/\|/, "  ", name)
            text = substr($0, 30, 2) == "  " ? substr($0, 32) : ""
            sub(/^ +/, "", text)
            if (text != "")
                emit()
            next
        }
        name != "" && match($0, /^ +/) && RLENGTH == 31 {
            text = substr($0, 32)
            emit()
            next
        }
        { emit() }
        END { emit() }
    '
}

group_help() {
    header | awk -v want="$1" '
        function title() {
            if (titled)
                return
            printf "banditshell %s%s\n\n", name, text == "" ? "" : " - " text
            titled = 1
        }
        done { next }
        /^[a-z][a-z|]*( |$)/ && !/^[a-z]+ [^ ]/ {
            if (inside) {
                done = 1
                next
            }
            n = split($1, words, "|")
            for (i = 1; i <= n; i++)
                if (words[i] == want)
                    inside = 1
            if (inside) {
                name = $1
                gsub(/\|/, ", ", name)
                text = substr($0, 30, 2) == "  " ? substr($0, 32) : ""
                sub(/^ +/, "", text)
            }
            next
        }
        !inside { next }
        /^$/ {
            done = 1
            next
        }
        !titled && text == "" && match($0, /^ +/) && RLENGTH == 31 {
            text = substr($0, 32)
            next
        }
        { title(); print }
        END { exit inside ? 0 : 1 }
    '
}

nope() {
    echo "banditshell: $1 has no ${2:-<nothing>}" >&2
    group_help "${1%% *}" >&2
    exit 2
}

say_usage() {
    echo "usage: banditshell $1" >&2
    exit 2
}

helpers_current() {
    local helper
    for helper in "${HELPERS[@]}"; do
        [ -x "$SHELL_DIR/bin/$helper" ] || return 1
        if [ "$SHELL_DIR/src/$helper.c" -nt "$SHELL_DIR/bin/$helper" ]; then
            return 1
        fi
    done
    return 0
}

ensure_built() {
    if [ "$(readlink "$SHELL_DIR/bin/banditshell" 2>/dev/null)" != ../cli/banditshell ]; then
        mkdir -p "$SHELL_DIR/bin" && ln -sfn ../cli/banditshell "$SHELL_DIR/bin/banditshell" || return 1
    fi
    helpers_current && return 0
    "$SHELL_DIR/bin/banditshell" dev build >/dev/null 2>&1 || "$SHELL_DIR/bin/banditshell" build >/dev/null 2>&1 || return 1
}

pct_of() { awk -v v="$1" 'BEGIN{printf "%d", v * 100 + 0.5}'; }

level_of() {
    local sign="" n="$1"
    case "$n" in
    [+-]*) sign="${n:0:1}" n="${n:1}" ;;
    esac
    case "$n" in
    "") [ -n "$sign" ] && n=10 ;;
    *.*) n=$(pct_of "$n") ;;
    esac
    printf '%s%s' "$sign" "$n"
}

labelled() {
    local out
    out=$(cat)
    [ -n "$out" ] || return 0
    awk -v label="$1" '{ printf "%-11s %s\n", NR == 1 ? label : "", $0 }' <<<"$out"
}

panel_ipc() {
    case "$1" in
    wallpaper) echo wallpapers ;;
    *) echo "$1" ;;
    esac
}

builtin_panel() {
    local surface
    for surface in "${SURFACES[@]}"; do
        [ "$surface" = "$1" ] && return 0
    done
    return 1
}

panel_status_takes_screen() { case "$1" in keyboard | notifications | island | hotkeys) return 0 ;; *) return 1 ;; esac; }

toggle_panel() {
    local name="$1" rest="${2:-}"
    case "$name" in
    launcher | session | clipboard | media | calculator | quickcontrols | settings) ipc "$name" toggle ;;
    keyboard | notifications | island | hotkeys | files) ipc "$name" toggle "$rest" ;;
    wallpaper) ipc wallpapers toggle "$rest" ;;
    *) ipc menu toggle "$name" "$rest" ;;
    esac
}

open_panel() {
    local name="$1"
    shift
    case "$name" in
    launcher | session | clipboard | media | calculator | quickcontrols) ipc "$name" open ;;
    keyboard | notifications | island | hotkeys | files) ipc "$name" open "${1:-}" ;;
    settings) ipc settings open "${1:-}" "${2:-}" ;;
    wallpaper) ipc wallpapers open "${1:-}" ;;
    *) ipc menu open "$name" "${1:-}" ;;
    esac
}

close_call() {
    case "$1" in
    wallpaper) call=(wallpapers close) ;;
    penmap) call=(penmap cancel) ;;
    launcher | session | clipboard | media | calculator | quickcontrols | keyboard | settings | notifications | island | hotkeys | files | picker) call=("$1" close) ;;
    *) call=(menu close) ;;
    esac
}

close_panel() {
    local -a call
    close_call "$1"
    ipc "${call[@]}"
}

close_everything() {
    local -a call
    local name closed=0
    for name in menu picker penmap "${SURFACES[@]}"; do
        close_call "$name"
        if ipc_quiet "${call[@]}" >/dev/null; then
            closed=1
        fi
    done
    if [ "$closed" = 0 ]; then
        complain "not running (try: banditshell start)"
        return 3
    fi
    echo "closed everything"
}

status_panel() {
    local current
    if builtin_panel "$1"; then
        if panel_status_takes_screen "$1"; then
            ipc "$(panel_ipc "$1")" status "${2:-}"
        else
            ipc "$(panel_ipc "$1")" status
        fi
        return
    fi
    current=$(ipc menu current) || return 1
    if [ "$current" = "$1" ]; then echo open; else echo closed; fi
}

list_panels() {
    printf '%s\n' "${SURFACES[@]}"
    ipc_quiet menu list || true
}

route_panel() {
    local name="${1:-}" action
    case "$name" in
    "") list_panels; return ;;
    close) [ $# -eq 1 ] || nope panel "close ${2:-}"; close_everything; return ;;
    notch) name=island ;;
    esac
    shift
    action="${1:-status}"
    if [ $# -gt 0 ]; then shift; fi

    case "$name:$action" in
    launcher:run) [ $# -ge 1 ] || say_usage "panel launcher run <app|row>"; ipc launcher run "$1" ;;
    settings:page) [ $# -ge 1 ] || say_usage "panel settings page <page>"; ipc settings page "$1" ;;
    keyboard:dock | keyboard:float) ipc keyboard "$action" ;;
    keyboard:page) [ $# -ge 1 ] || say_usage "panel keyboard page <layer> [screen]"; ipc keyboard page "$1" "${2:-}" ;;
    clipboard:list | clipboard:clear) ipc clipboard "$action" ;;
    clipboard:use | clipboard:pin | clipboard:remove) [ $# -ge 1 ] || say_usage "panel clipboard $action <index>"; ipc clipboard "$action" "$1" ;;
    calculator:full) ipc calculator app ;;
    calculator:compact) ipc calculator panel ;;
    calculator:answer) [ $# -ge 1 ] || say_usage "panel calculator answer <expression>"; ipc calculator answer "$*" ;;
    notifications:clear) ipc notifications clear ;;
    *:toggle) toggle_panel "$name" "${1:-}" ;;
    *:open) open_panel "$name" "$@" ;;
    *:close) close_panel "$name" ;;
    *:status) status_panel "$name" "${1:-}" ;;
    *) nope panel "$name $action" ;;
    esac
}

route_output() {
    case "${1:-}" in
    "") ipc output status ;;
    speakers | headphones | toggle | list) ipc output "$1" ;;
    assign) [ $# -ge 3 ] || say_usage "output assign speakers|headphones <device>"; ipc output assign "$2" "$3" ;;
    *) nope output "$1" ;;
    esac
}

route_screen() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc screen status | labelled display || return 1
        ipc_quiet border status | labelled border || true
        ipc_quiet sidebar status | labelled sidebar || true
        ipc_quiet stream status | labelled stream || true
        ;;
    brightness)
        if [ -z "${1:-}" ]; then ipc screen status; else ipc screen brightness "$(level_of "$1")"; fi ;;
    temperature)
        if [ -z "${1:-}" ]; then ipc screen status; else ipc screen temperature "$1"; fi ;;
    border)
        case "${1:-}" in
        "") ipc border status ;;
        on | off | toggle) ipc border "$1" ;;
        *) nope screen "border $1" ;;
        esac ;;
    sidebar)
        case "${1:-}" in
        "") ipc sidebar status ;;
        on | off | toggle) ipc sidebar "$1" "${2:-}" ;;
        *) nope screen "sidebar $1" ;;
        esac ;;
    stream)
        case "${1:-}" in
        "") ipc stream status ;;
        on) ipc stream on "${2:-}" ;;
        off) ipc stream off ;;
        *) nope screen "stream $1" ;;
        esac ;;
    *) nope screen "$what" ;;
    esac
}

route_wallpaper() {
    case "${1:-}" in
    "") ipc wallpaper status ;;
    on | off | toggle | palette) ipc wallpaper "$1" ;;
    next | prev | clear) ipc wallpaper "$1" "${2:-}" ;;
    set) [ $# -ge 2 ] || say_usage "wallpaper set <file> [screen|all]"
        ipc wallpaper set "$(realpath -s -m -- "$2")" "${3:-}" ;;
    list) ipc wallpaper list "${2:-}" ;;
    *) nope wallpaper "$1" ;;
    esac
}

screenshot_dir() {
    local cfg dir
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
    dir=$(jq -r '.picker.dir // empty' "$cfg" 2>/dev/null || true)
    dir="${dir:-~/Pictures/Screenshots}"
    printf '%s' "${dir/#\~/$HOME}"
}

pick_region() {
    local action="$1" region note dir editor out
    if ipc_quiet picker "$action"; then
        return 0
    fi
    if ! command -v slurp >/dev/null || ! command -v grim >/dev/null; then
        complain "not running, and no grim/slurp to fall back on"
        exit 1
    fi
    complain "not running - falling back to grim/slurp (try: banditshell start)"
    # shellcheck disable=SC2086
    region=$(slurp ${SLURP_ARGS:-}) || exit 0
    if [ -z "$region" ]; then
        exit 0
    fi
    note="banditshell was not running"
    case "$action" in
    freeze*) note="$note; taken live, nothing could be frozen" ;;
    esac
    case "$action" in
    *clip)
        grim -g "$region" - | wl-copy --type image/png
        notice "Screenshot copied" "$note"
        ;;
    *)
        dir=$(screenshot_dir)
        editor=$(jq -r '.picker.editor // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json" 2>/dev/null || true)
        editor="${editor:-swappy -f}"
        mkdir -p "$dir"
        out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
        grim -g "$region" "$out"
        notice "Screenshot saved" "$out ($note)"
        # shellcheck disable=SC2086
        ${editor} "$out" >/dev/null 2>&1 || true
        echo "$out"
        ;;
    esac
}

notice() {
    notify-send -a banditshell "$1" "$2" 2>/dev/null ||
        hyprctl notify -1 5000 "rgb(e5c07b)" "$1 - $2" >/dev/null 2>&1 || true
}

route_screenshot() {
    local mode="${1:-}" freeze=0 arg dir out
    if [ $# -gt 0 ]; then shift; fi
    case "$mode" in
    "") group_help screenshot; return ;;
    full)
        if [ -n "${1:-}" ]; then
            out="$1"
        else
            dir=$(screenshot_dir)
            mkdir -p "$dir"
            out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
        fi
        grim "$out"
        echo "$out"
        return
        ;;
    save | copy) ;;
    *) nope screenshot "$mode" ;;
    esac
    for arg in "$@"; do
        case "$arg" in
        --freeze) freeze=1 ;;
        *) nope screenshot "$mode $arg" ;;
        esac
    done
    case "$mode:$freeze" in
    save:0) pick_region open ;;
    save:1) pick_region freeze ;;
    copy:0) pick_region clip ;;
    copy:1) pick_region freezeclip ;;
    esac
}

route_timer() {
    case "${1:-}" in
    "") ipc timer status ;;
    start) [ $# -ge 2 ] || say_usage "clock timer start <duration> [label]"; ipc timer start "$2" "${3:-}" ;;
    pause | resume | toggle | cancel) ipc timer "$1" "${2:-}" ;;
    *) nope clock "timer $1" ;;
    esac
}

route_alarm() {
    local action="${1:-}" when days="" label="" mode="" payload=""
    case "$action" in
    "") ipc alarm status ;;
    list | snooze | stop) ipc alarm "$action" ;;
    enable | disable | remove) [ $# -ge 2 ] || say_usage "clock alarm $action <handle>"; ipc alarm "$action" "$2" ;;
    add)
        [ $# -ge 2 ] || say_usage "clock alarm add <time> [--days <days>] [--label <text>] [--run <command>|--ask <message>]"
        when="$2"
        shift 2
        while [ $# -gt 0 ]; do
            [ $# -ge 2 ] || { echo "banditshell: $1 needs a value" >&2; exit 2; }
            case "$1" in
            --days) days="$2" ;;
            --label) label="$2" ;;
            --run) mode="command" payload="$2" ;;
            --ask) mode="cloud" payload="$2" ;;
            *) echo "banditshell: unknown option: $1" >&2; exit 2 ;;
            esac
            shift 2
        done
        ipc alarm add "$when" "$days" "$label" "$mode" "$payload"
        ;;
    *) nope clock "alarm $action" ;;
    esac
}

route_zone() {
    local action="${1:-list}"
    case "$action" in
    list) ipc zone list ;;
    find | add | remove) [ $# -ge 2 ] || say_usage "clock zone $action <place>"; shift; ipc zone "$action" "$*" ;;
    *) nope clock "zone $action" ;;
    esac
}

route_clock() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc timer status | labelled timers || return 1
        ipc_quiet alarm status | labelled alarms || true
        ;;
    timer) route_timer "$@" ;;
    alarm) route_alarm "$@" ;;
    zone) route_zone "$@" ;;
    *) nope clock "$what" ;;
    esac
}

route_mode() {
    case "${1:-}" in
    "") ipc mode status ;;
    list) ipc mode list ;;
    *) ipc mode choose "$1" ;;
    esac
}

route_quiet() {
    case "${1:-}" in
    "") ipc quiet status ;;
    off) ipc quiet off ;;
    on | toggle) ipc quiet "$1" "${2:-}" ;;
    *) nope focus "quiet $1" ;;
    esac
}

route_focus() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc mode status | labelled mode || return 1
        ipc_quiet quiet status || true
        ;;
    mode) route_mode "$@" ;;
    quiet) route_quiet "$@" ;;
    *) nope focus "$what" ;;
    esac
}

route_tablet() {
    case "${1:-}" in
    "")
        ipc tablet status | labelled tablet || return 1
        ipc_quiet penmap status | labelled pen || true
        ;;
    on | off | toggle) ipc tablet "$1" "${2:-}" ;;
    lid)
        case "${2:-}" in
        "") ipc tablet status ;;
        open | closed | toggle) ipc tablet lid "$2" "${3:-}" ;;
        *) nope tablet "lid $2" ;;
        esac ;;
    probe)
        case "${2:-}" in
        "") python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose ;;
        lid) python3 "$SHELL_DIR/scripts/tablet-state.py" --lid --verbose ;;
        *) nope tablet "probe $2" ;;
        esac ;;
    pen)
        case "${2:-}" in
        "") ipc penmap status ;;
        edit) ipc penmap open ;;
        commit | cancel | aspect | centre | follow) ipc penmap "$2" ;;
        area) [ $# -ge 6 ] || say_usage "tablet pen area <x> <y> <width> <height>"; ipc penmap set "$3" "$4" "$5" "$6" ;;
        *) nope tablet "pen $2" ;;
        esac ;;
    *) nope tablet "$1" ;;
    esac
}

route_config() {
    case "${1:-}" in
    "") group_help config ;;
    get) [ $# -ge 2 ] || say_usage "config get <key>"; ipc shell get "$2" ;;
    set) [ $# -ge 3 ] || say_usage "config set <key> <value>"; ipc shell set "$2" "$3" ;;
    theme)
        case "${2:-}" in
        "") ipc shell get theme ;;
        list) ipc shell themes ;;
        *) ipc shell set theme "\"$2\"" ;;
        esac ;;
    *) nope config "$1" ;;
    esac
}

JSON_AWK='
function jstr(s,   out, i, c, n) {
    out = ""
    n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\\") out = out "\\\\"
        else if (c == "\"") out = out "\\\""
        else if (c == "\t") out = out "\\t"
        else if (c == "\r") out = out "\\r"
        else out = out c
    }
    return "\"" out "\""
}
function jvalue(v) {
    if (v ~ /^-?[0-9]+(\.[0-9]+)?$/ || v == "true" || v == "false")
        return v
    return jstr(v)
}
'

