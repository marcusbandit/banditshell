#!/usr/bin/env bash
# banditshell - run and drive the shell.
#
#   banditshell start|stop|restart|run
#                                the shell itself: detach and prove it, stop it,
#                                restart it, run it in the foreground
#   banditshell log [args]       the running shell's log
#   banditshell doctor           repair bin/, the helpers and ~/bin/banditshell,
#                                then report quickshell, dkms and failed units
#   banditshell toggle panel <panel> [screen]|panel files [dir]|border|wallpaper
#        sidebar [<screen>|all]|output|tablet [caller]|tablet lid [caller]
#        volume mute
#                                flip a surface or a boolean
#   banditshell open panel <panel> [screen]|panel settings [page] [screen]
#        panel files [dir]
#                                open a surface
#   banditshell close panel <panel>
#                                put one surface away; bare, every surface
#   banditshell panic            every surface away
#   banditshell status panel <panel> [screen]|border|sidebar|volume|output|tablet
#        penmap|wallpaper|timer|alarm|lock|keyring|migration|screen
#                                what a thing is doing; bare, the shell
#   banditshell set border [on|off]|wallpaper [on|off]|wallpaper <file> [<screen>|all]
#        sidebar [on|off] [<screen>|all]|tablet [on|off] [caller]
#        tablet lid [closed|open] [caller]|volume [<percent>|+n|-n]
#        volume mute [on|off]|output [speakers|headphones]|output <role> <sink>
#        brightness [<percent>|+n|-n]|temperature [<kelvin>|off]|theme [theme]
#        penmap rect <x> <y> <width> <height>|<key> <value>
#                                a state, a level or a dotted config key; .5 is
#                                50 percent, +n and -n move, a bare + or - steps
#   banditshell get <key>|theme  a dotted config key, or the theme's name
#   banditshell list menu|clipboard|wallpaper [screen]|output|alarm|zone|themes
#                                enumerate a registry
#   banditshell dispatch timer start <duration> [label]
#        timer [pause|resume|toggle|cancel] [handle]
#        alarm [list|status|snooze|stop]|alarm [enable|disable|remove] <handle>
#        alarm add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]
#        zone list|zone [find|add|remove] <place>
#        clipboard [use|pin|remove] <index>|clipboard clear
#        calculator [app|panel]|calculator answer <expression>
#        keyboard [dock|float]|keyboard page <layer> [screen]
#        settings float|settings page <page>
#        launcher run <app>|launcher scrub <fraction>
#        wallpaper [next|prev|clear] [<screen>|all]|wallpaper palette
#        menu [current|hover]|penmap [commit|cancel|aspect|centre|follow]
#        keyring [refuse|demo]|tablet probe|tablet probe lid
#        notifications clear|migration migrate|lock
#        picker [open|freeze|clip|freezeclip|close]
#                                the bespoke tail, target by target; the picker
#                                falls back to grim and slurp without the shell
#   banditshell files [toggle|open] [dir]|close|status
#                                the file browser
#   banditshell completions install|status|remove|print
#                                tab completion, generated from this text
#   banditshell build            compile src/*.c into bin/
#   banditshell shaders          compile components/**/*.frag to .qsb
#   banditshell test [args]      run tests/*.test.js in node
#   banditshell shot [file]      a plain screenshot
#   banditshell demo <menu> [file]
#                                open a menu, shoot it, put it away
#   banditshell gallery [WxH]    every component the shell owns, in a window
#   banditshell lockpreview [file]
#                                the lock face, photographed
#   banditshell settingspreview [WxH] [page] [file]
#                                the settings face at a size, photographed
#   banditshell filespreview [dir] [file]
#                                the file browser in a window; with a file, shot
#   banditshell help             this text
#
#   <panel>: launcher|session|clipboard|media|calculator|quickcontrols|keyboard
#        settings|notifications|notch|hotkeys|files|wallpaper|penmap
#                                or any menu key (list menu)

set -euo pipefail

SHELL_DIR="${BANDITSHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SHOT_DIR="${BANDITSHELL_SHOTS:-${XDG_RUNTIME_DIR:-/tmp}/banditshell}"
BACKUP="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/lastgood"
FAILED_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/failed.log"
SURFACES=(launcher session clipboard media calculator quickcontrols keyboard settings notifications notch hotkeys files wallpaper penmap)
HELPERS=(bs-pty bs-ls bs-gamma)

qs_target=()
qs_target_resolved=0

list_instances() {
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Process ID:/ { pid = $NF }
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            print pid "\t" p
        }
    '
}

instance_of() {
    local pid path
    while IFS=$'\t' read -r pid path; do
        [ "$path" = "$1/shell.qml" ] && { echo "$pid"; return 0; }
    done < <(list_instances)
    return 1
}

shell_pids() {
    local pid path
    while IFS=$'\t' read -r pid path; do
        case "$path" in
        "$SHELL_DIR/shell.qml" | "$BACKUP/shell.qml") echo "$pid" ;;
        esac
    done < <(list_instances)
}

resolve_target() {
    if [ "$qs_target_resolved" = 1 ]; then
        return 0
    fi
    qs_target_resolved=1

    local pid path exact="" any=""
    while IFS=$'\t' read -r pid path; do
        case "$path" in
        "$SHELL_DIR/shell.qml") exact="$pid" ;;
        */shell.qml) [ -n "$any" ] || any="$pid" ;;
        esac
    done < <(list_instances)

    local pick="${exact:-$any}"
    if [ -n "$pick" ]; then
        qs_target=(--pid "$pick")
    else
        qs_target=(-p "$SHELL_DIR")
    fi
}

complain() {
    echo "banditshell: $1" >&2
    hyprctl notify -1 5000 "rgb(e06c75)" "banditshell: $1" >/dev/null 2>&1 || true
}

ipc() {
    resolve_target
    local out
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    complain "not running (try: banditshell start)"
    return 1
}

ipc_quiet() {
    resolve_target
    local out
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    return 1
}

running() {
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            if (p ~ /\/shell\.qml$/) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

refresh_backup() {
    mkdir -p "$BACKUP"
    rsync -a --delete --exclude .git --exclude .claude --exclude .scratch \
        "$SHELL_DIR/" "$BACKUP/"
}

launch() {
    local out tries=0
    out=$(mktemp)
    if ! (cd "$HOME" && qs -d -p "$1") >"$out" 2>&1 || grep -q "Failed to load configuration" "$out"; then
        mkdir -p "$(dirname "$FAILED_LOG")"
        cat "$out" >>"$FAILED_LOG"
        rm -f "$out"
        return 1
    fi
    while [ "$tries" -lt 30 ]; do
        if instance_of "$1" >/dev/null; then
            sleep 1
            if instance_of "$1" >/dev/null; then
                rm -f "$out"
                return 0
            fi
            break
        fi
        sleep 0.2
        tries=$((tries + 1))
    done
    mkdir -p "$(dirname "$FAILED_LOG")"
    cat "$out" >>"$FAILED_LOG"
    rm -f "$out"
    return 1
}

start_backup() {
    if [ ! -f "$BACKUP/shell.qml" ]; then
        complain "shell failed to load and there is no backup yet (errors: $FAILED_LOG)"
        return 1
    fi
    complain "shell failed to load - running the last known good copy (errors: $FAILED_LOG)"
    launch "$BACKUP"
}

stop_shell() {
    local -a pids
    local pid alive tries=0
    mapfile -t pids < <(shell_pids)
    [ "${#pids[@]}" -gt 0 ] || return 1
    kill "${pids[@]}" 2>/dev/null || true
    while [ "$tries" -lt 40 ]; do
        alive=0
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                alive=1
            fi
        done
        [ "$alive" = 0 ] && return 0
        sleep 0.05
        tries=$((tries + 1))
    done
    return 0
}

usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$(readlink -f "${BASH_SOURCE[0]}")"; }

helpers_current() {
    local helper
    for helper in "${HELPERS[@]}"; do
        [ -x "$SHELL_DIR/bin/$helper" ] || return 1
        if [ "$SHELL_DIR/src/$helper.c" -nt "$SHELL_DIR/bin/$helper" ]; then
            return 1
        fi
    done
    return 0
}

ensure_built() {
    if [ ! -x "$SHELL_DIR/bin/banditshell" ] || [ "$SHELL_DIR/cli/banditshell" -nt "$SHELL_DIR/bin/banditshell" ]; then
        install -Dm755 "$SHELL_DIR/cli/banditshell" "$SHELL_DIR/bin/banditshell" || return 1
    fi
    helpers_current && return 0
    "$SHELL_DIR/bin/banditshell" build >/dev/null 2>&1 || return 1
}

pct_of() { awk -v v="$1" 'BEGIN{printf "%d", v * 100 + 0.5}'; }

rel_of() { case "$1" in *.*) pct_of "$1" ;; *) printf '%s' "$1" ;; esac; }

panel_ipc() {
    case "$1" in
    wallpaper) echo wallpapers ;;
    *) echo "$1" ;;
    esac
}

panel_status_ok() { case "$1" in clipboard | media | calculator | keyboard | settings | notifications | notch | hotkeys | files | wallpaper | penmap | quickcontrols) return 0 ;; *) return 1 ;; esac; }
panel_status_takes_screen() { case "$1" in keyboard | notifications | notch | hotkeys) return 0 ;; *) return 1 ;; esac; }

toggle_panel() {
    local name="$1" rest="${2:-}"
    case "$name" in
    launcher | session) ipc "$(panel_ipc "$name")" toggle ;;
    clipboard | media | calculator | quickcontrols) ipc "$name" toggle ;;
    keyboard) ipc keyboard toggle "$rest" ;;
    settings) ipc settings toggle ;;
    notifications | notch | hotkeys) ipc "$name" toggle "$rest" ;;
    files) ipc files toggle "$rest" ;;
    wallpaper) ipc wallpapers toggle "$rest" ;;
    penmap) ipc penmap open ;;
    *) ipc menu toggle "$name" "$rest" ;;
    esac
}

open_panel() {
    local name="$1"
    shift
    case "$name" in
    launcher | session) ipc "$(panel_ipc "$name")" open ;;
    clipboard | media | calculator | quickcontrols) ipc "$name" open ;;
    keyboard) ipc keyboard open "${1:-}" ;;
    settings) ipc settings open "${1:-}" "${2:-}" ;;
    notifications | notch | hotkeys) ipc "$name" open "${1:-}" ;;
    files) ipc files open "${1:-}" ;;
    wallpaper) ipc wallpapers open "${1:-}" ;;
    penmap) ipc penmap open ;;
    *) ipc menu open "$name" "${1:-}" ;;
    esac
}

close_call() {
    case "$1" in
    wallpaper) call=(wallpapers close) ;;
    penmap) call=(penmap cancel) ;;
    launcher | session | clipboard | media | calculator | quickcontrols | keyboard | settings | notifications | notch | hotkeys | files | picker) call=("$1" close) ;;
    *) call=(menu close) ;;
    esac
}

close_panel() {
    local -a call
    close_call "$1"
    ipc "${call[@]}"
}

close_everything() {
    local -a call
    local name closed=0
    for name in menu picker "${SURFACES[@]}"; do
        close_call "$name"
        if ipc_quiet "${call[@]}" >/dev/null; then
            closed=1
        fi
    done
    if [ "$closed" = 0 ]; then
        complain "not running (try: banditshell start)"
        return 1
    fi
    echo "closed everything"
}

status_panel() {
    panel_status_ok "$1" || { echo "banditshell: $1 has no status" >&2; return 1; }
    if panel_status_takes_screen "$1"; then
        ipc "$(panel_ipc "$1")" status "${2:-}"
    else
        ipc "$(panel_ipc "$1")" status
    fi
}

route_dispatch() {
    local target="$1"
    shift
    local action="${1:-}"

    case "$target" in
    menu)
        case "$action" in
        current | hover) ipc menu "$action" ;;
        *) echo "banditshell: dispatch menu current|hover" >&2; exit 2 ;;
        esac
        ;;

    timer)
        case "$action" in
        pause | resume | toggle | cancel) ipc timer "$action" "${2:-}" ;;
        start) [ $# -ge 2 ] || { echo "usage: banditshell dispatch timer start <duration> [label]" >&2; exit 2; }
            ipc timer start "$2" "${3:-}" ;;
        *) echo "banditshell: dispatch timer start|pause|resume|toggle|cancel" >&2; exit 2 ;;
        esac
        ;;

    alarm)
        case "$action" in
        list | status | snooze | stop) ipc alarm "$action" ;;
        enable | disable | remove) [ $# -ge 2 ] || { echo "usage: banditshell dispatch alarm $action <handle>" >&2; exit 2; }
            ipc alarm "$action" "$2" ;;
        add)
            [ $# -ge 2 ] || { echo "usage: banditshell dispatch alarm add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]" >&2; exit 2; }
            local when="$2"
            shift 2
            local days="" label="" mode="" payload=""
            while [ $# -gt 0 ]; do
                [ $# -ge 2 ] || { echo "banditshell: $1 needs a value" >&2; exit 2; }
                case "$1" in
                --days) days="$2" ;;
                --label) label="$2" ;;
                --run) mode="command"; payload="$2" ;;
                --ask) mode="cloud"; payload="$2" ;;
                *) echo "banditshell: unknown option: $1" >&2; exit 2 ;;
                esac
                shift 2
            done
            ipc alarm add "$when" "$days" "$label" "$mode" "$payload"
            ;;
        *) echo "banditshell: dispatch alarm list|status|snooze|stop|enable|disable|remove|add" >&2; exit 2 ;;
        esac
        ;;

    zone)
        case "$action" in
        list) ipc zone list ;;
        find | add | remove) [ $# -ge 2 ] || { echo "usage: banditshell dispatch zone $action <place>" >&2; exit 2; }
            shift
            ipc zone "$action" "$*" ;;
        *) echo "banditshell: dispatch zone list|find|add|remove" >&2; exit 2 ;;
        esac
        ;;

    clipboard)
        case "$action" in
        clear) ipc clipboard clear ;;
        use | pin | remove) [ $# -ge 2 ] || { echo "usage: banditshell dispatch clipboard $action <index>" >&2; exit 2; }
            ipc clipboard "$action" "$2" ;;
        *) echo "banditshell: dispatch clipboard use|pin|remove <index>|clear" >&2; exit 2 ;;
        esac
        ;;

    calculator)
        case "$action" in
        app | panel) ipc calculator "$action" ;;
        answer) [ $# -ge 2 ] || { echo "usage: banditshell dispatch calculator answer <expression>" >&2; exit 2; }
            shift
            ipc calculator answer "$*" ;;
        *) echo "banditshell: dispatch calculator app|panel|answer <expression>" >&2; exit 2 ;;
        esac
        ;;

    keyboard)
        case "$action" in
        dock | float) ipc keyboard "$action" ;;
        page) [ $# -ge 2 ] || { echo "usage: banditshell dispatch keyboard page <layer> [screen]" >&2; exit 2; }
            ipc keyboard page "$2" "${3:-}" ;;
        *) echo "banditshell: dispatch keyboard page <layer>|dock|float" >&2; exit 2 ;;
        esac
        ;;

    settings)
        case "$action" in
        float) ipc settings float ;;
        page) [ $# -ge 2 ] || { echo "usage: banditshell dispatch settings page <page>" >&2; exit 2; }
            ipc settings page "$2" ;;
        *) echo "banditshell: dispatch settings page <page>|float" >&2; exit 2 ;;
        esac
        ;;

    launcher)
        case "$action" in
        run) ipc launcher run "${2:-}" ;;
        scrub) ipc launcher scrub "${2:-0}" ;;
        *) echo "banditshell: dispatch launcher run <app>|scrub <fraction>" >&2; exit 2 ;;
        esac
        ;;

    wallpaper)
        case "$action" in
        next | prev | clear) ipc wallpaper "$action" "${2:-}" ;;
        palette) ipc wallpaper palette ;;
        *) echo "banditshell: dispatch wallpaper next|prev|clear [screen|all]|palette" >&2; exit 2 ;;
        esac
        ;;

    penmap)
        case "$action" in
        commit | cancel | aspect | centre | follow) ipc penmap "$action" ;;
        probe) python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose ;;
        *) echo "banditshell: dispatch penmap commit|cancel|aspect|centre|follow" >&2; exit 2 ;;
        esac
        ;;

    tablet)
        case "$action" in
        probe)
            if [ "${2:-}" = lid ]; then
                python3 "$SHELL_DIR/scripts/tablet-state.py" --lid --verbose
            else
                python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose
            fi
            ;;
        *) echo "banditshell: dispatch tablet probe [lid]" >&2; exit 2 ;;
        esac
        ;;

    keyring)
        case "$action" in
        refuse | demo) ipc keyring "$action" ;;
        *) echo "banditshell: dispatch keyring refuse|demo" >&2; exit 2 ;;
        esac
        ;;

    notifications)
        case "$action" in
        clear) ipc notifications clear ;;
        *) echo "banditshell: dispatch notifications clear" >&2; exit 2 ;;
        esac
        ;;

    migration)
        case "$action" in
        migrate) ipc migration migrate ;;
        *) echo "banditshell: dispatch migration migrate" >&2; exit 2 ;;
        esac
        ;;

    lock) ipc lock lock ;;

    picker)
        if ipc_quiet picker "$action" && [ "$action" != close ]; then
            exit 0
        fi
        case "$action" in
        close) ipc picker close; exit 0 ;;
        esac
        if ! command -v slurp >/dev/null || ! command -v grim >/dev/null; then
            complain "not running, and no grim/slurp to fall back on"
            exit 1
        fi
        complain "not running - falling back to grim/slurp (try: banditshell start)"
        # shellcheck disable=SC2086
        region=$(slurp ${SLURP_ARGS:-}) || exit 0
        if [ -z "$region" ]; then
            exit 0
        fi
        note="banditshell was not running"
        case "$action" in
        freeze*) note="$note; taken live, nothing could be frozen" ;;
        esac
        say2() {
            notify-send -a banditshell "$1" "$2" 2>/dev/null ||
                hyprctl notify -1 5000 "rgb(e5c07b)" "$1 - $2" >/dev/null 2>&1 || true
        }
        case "$action" in
        *clip)
            grim -g "$region" - | wl-copy --type image/png
            say2 "Screenshot copied" "$note"
            ;;
        *)
            cfg="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
            dir=$(jq -r '.picker.dir // empty' "$cfg" 2>/dev/null || true)
            editor=$(jq -r '.picker.editor // empty' "$cfg" 2>/dev/null || true)
            dir="${dir:-~/Pictures/Screenshots}"
            dir="${dir/#\~/$HOME}"
            editor="${editor:-swappy -f}"
            mkdir -p "$dir"
            out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
            grim -g "$region" "$out"
            say2 "Screenshot saved" "$out ($note)"
            # shellcheck disable=SC2086
            ${editor} "$out" >/dev/null 2>&1 || true
            echo "$out"
            ;;
        esac
        ;;

    *)
        echo "banditshell: no dispatch target: $target" >&2
        exit 2
        ;;
    esac
}

route_verb() {
    local verb="$1"
    shift
    local obj="${1:-}"
    if [ "$#" -gt 0 ]; then shift; fi

    case "$verb" in
    toggle)
        case "$obj" in
        panel) [ $# -ge 1 ] || { echo "usage: banditshell toggle panel <panel> [screen]" >&2; exit 2; }
            toggle_panel "$1" "${2:-}" ;;
        border) ipc border toggle ;;
        wallpaper) ipc wallpaper toggle ;;
        sidebar) ipc sidebar toggle "${1:-}" ;;
        output) ipc output toggle ;;
        tablet)
            if [ "${1:-}" = lid ]; then
                ipc tablet lid toggle "${2:-}"
            else
                ipc tablet toggle "${1:-}"
            fi ;;
        volume)
            [ "${1:-}" = mute ] || { echo "banditshell: the level is a number; use 'set volume <percent>'. Only mute toggles." >&2; exit 2; }
            ipc volume mute "" ;;
        *) echo "banditshell: nothing to toggle: ${obj:-<none>} (try: toggle panel <panel>|border|wallpaper|sidebar|output|tablet|volume mute)" >&2; exit 2 ;;
        esac
        ;;

    open)
        case "$obj" in
        panel) [ $# -ge 1 ] || { echo "usage: banditshell open panel <panel> [args]" >&2; exit 2; }
            open_panel "$@" ;;
        "") echo "usage: banditshell open panel <panel> [args]" >&2; exit 2 ;;
        *) echo "banditshell: only panels open: open panel <panel>" >&2; exit 2 ;;
        esac
        ;;

    close)
        if [ -z "$obj" ]; then
            close_everything
            return
        fi
        [ "$obj" = panel ] && [ $# -ge 1 ] || { echo "usage: banditshell close panel <panel> (bare 'close' shuts everything)" >&2; exit 2; }
        close_panel "$1"
        ;;

    set)
        case "$obj" in
        border) [ $# -ge 1 ] || { echo "usage: banditshell set border on|off" >&2; exit 2; }
            case "$1" in on | off) ipc border "$1" ;; *) echo "banditshell: set border on|off" >&2; exit 2 ;; esac ;;
        sidebar) [ $# -ge 1 ] || { echo "usage: banditshell set sidebar on|off [screen|all]" >&2; exit 2; }
            case "$1" in on | off) ipc sidebar "$1" "${2:-}" ;; *) echo "banditshell: set sidebar on|off [screen|all]" >&2; exit 2 ;; esac ;;
        wallpaper)
            [ $# -ge 1 ] || { echo "usage: banditshell set wallpaper on|off|<file> [screen|all]" >&2; exit 2; }
            case "$1" in
            on | off) ipc wallpaper "$1" ;;
            "") echo "usage: banditshell set wallpaper on|off|<file> [screen|all]" >&2; exit 2 ;;
            *) ipc wallpaper set "$(realpath -s -m -- "$1")" "${2:-}" ;;
            esac ;;
        volume)
            [ $# -ge 1 ] || { echo "usage: banditshell set volume <percent>|+n|-n|mute on|off" >&2; exit 2; }
            if [ "$1" = mute ]; then
                case "${2:-}" in
                on | off) ipc volume mute "$2" ;;
                "") echo "banditshell: set volume mute on|off (or: toggle volume mute)" >&2; exit 2 ;;
                *) echo "banditshell: set volume mute on|off" >&2; exit 2 ;;
                esac
                return 0
            fi
            case "$1" in
            +*) n="${1#+}"; if [ -z "$n" ]; then ipc volume up ""; else ipc volume upPercent "$(rel_of "$n")"; fi ;;
            -*) n="${1#-}"; if [ -z "$n" ]; then ipc volume down ""; else ipc volume downPercent "$(rel_of "$n")"; fi ;;
            *.*) ipc volume set "$(pct_of "$1")" ;;
            *) ipc volume set "$1" ;;
            esac ;;
        brightness)
            [ $# -ge 1 ] || { echo "usage: banditshell set brightness <percent>|+n|-n" >&2; exit 2; }
            case "$1" in
            *.*) ipc screen brightness "$(pct_of "$1")" ;;
            *) ipc screen brightness "$1" ;;
            esac ;;
        temperature)
            [ $# -ge 1 ] || { echo "usage: banditshell set temperature <kelvin>|off" >&2; exit 2; }
            ipc screen temperature "$1" ;;
        output)
            [ $# -ge 1 ] || { echo "usage: banditshell set output speakers|headphones|<role> <sink>" >&2; exit 2; }
            case "$1" in
            speakers | headphones) ipc output "$1" ;;
            "") echo "usage: banditshell set output speakers|headphones|<role> <sink>" >&2; exit 2 ;;
            *) [ $# -ge 2 ] || { echo "usage: banditshell set output <role> <sink>" >&2; exit 2; }
                ipc output assign "$1" "${2:-}" ;;
            esac ;;
        theme) [ $# -ge 1 ] || { echo "usage: banditshell set theme <theme>" >&2; exit 2; }
            ipc shell set theme "\"$1\"" ;;
        penmap)
            [ "${1:-}" = rect ] && [ $# -ge 5 ] || { echo "usage: banditshell set penmap rect <x> <y> <width> <height>" >&2; exit 2; }
            ipc penmap set "$2" "$3" "$4" "$5" ;;
        "") echo "usage: banditshell set <key> <value>" >&2; exit 2 ;;
        *) [ $# -ge 1 ] || { echo "usage: banditshell set <key> <value>" >&2; exit 2; }
            ipc shell set "$obj" "$1" ;;
        esac
        ;;

    get)
        case "$obj" in
        "") echo "usage: banditshell get <key>|theme" >&2; exit 2 ;;
        theme) ipc shell get theme ;;
        *) ipc shell get "$obj" ;;
        esac
        ;;

    list)
        case "$obj" in
        menu) ipc menu list ;;
        clipboard) ipc clipboard list ;;
        wallpaper) ipc wallpaper list "${1:-}" ;;
        output) ipc output list ;;
        alarm) ipc alarm list ;;
        zone) ipc zone list ;;
        themes) ipc shell themes ;;
        *) echo "banditshell: list menu|clipboard|wallpaper|output|alarm|zone|themes" >&2; exit 2 ;;
        esac
        ;;

    status)
        case "$obj" in
        "") ipc shell status ;;
        panel) [ $# -ge 1 ] || { echo "usage: banditshell status panel <panel> [screen]" >&2; exit 2; }
            status_panel "$1" "${2:-}" ;;
        border | sidebar | volume | output | tablet | penmap | wallpaper | timer | alarm | lock | keyring | migration | screen) ipc "$obj" status ;;
        *) echo "banditshell: no status for: $obj" >&2; exit 2 ;;
        esac
        ;;
    esac
}

preview_pid=""
preview_log=""

start_preview() {
    local name="$1" limit="$2"
    shift 2
    [ -f "$SHELL_DIR/previews/$name.qml" ] || { echo "banditshell: no preview named $name" >&2; exit 1; }
    mkdir -p "$SHOT_DIR"
    preview_log="$SHOT_DIR/$name.log"
    local -a command=(env "BANDITSHELL_PREVIEW=$name" "$@" qs -p "$SHELL_DIR/preview.qml")
    if [ "$limit" -gt 0 ]; then
        command=(timeout "$limit" "${command[@]}")
    fi
    (cd "$HOME" && exec "${command[@]}") >"$preview_log" 2>&1 &
    preview_pid=$!
}

preview_failed() {
    if kill -0 "$preview_pid" 2>/dev/null && ! grep -q "@previews/$1\.qml\[" "$preview_log"; then
        return 1
    fi
    kill "$preview_pid" 2>/dev/null || true
    echo "banditshell: the $1 preview did not come up (log: $preview_log)" >&2
    sed 's/\x1b\[[0-9;]*m//g' "$preview_log" | grep -E 'ERROR|@previews/' >&2 || true
    return 0
}

window_rect() {
    hyprctl -j clients | jq -r --arg title "$1" '.[] | select(.title == $title) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | head -1
}

cmd="${1:-help}"
shift || true

case "$cmd" in
start)
    running && { echo "already running"; exit 0; }
    ensure_built || complain "checkout incomplete, starting anyway (run: banditshell doctor)"
    if launch "$SHELL_DIR"; then
        refresh_backup
        echo "started"
    else
        start_backup || exit 1
        echo "running from backup - the checkout itself failed to load (errors: $FAILED_LOG)" >&2
        exit 1
    fi
    ;;
stop)
    if stop_shell; then
        echo "stopped"
    else
        echo "not running"
    fi
    ;;
restart)
    stop_shell || true
    ensure_built || complain "checkout incomplete, starting anyway (run: banditshell doctor)"
    if launch "$SHELL_DIR"; then
        refresh_backup
        echo "restarted"
    else
        start_backup || exit 1
        echo "running from backup - the checkout itself failed to load (errors: $FAILED_LOG)" >&2
        exit 1
    fi
    ;;
run)
    cd "$HOME" || exit 1
    exec qs -p "$SHELL_DIR"
    ;;
log)
    exec qs -p "$SHELL_DIR" log "$@"
    ;;
doctor)
    if ensure_built; then
        echo "bin/ current, helpers in place"
    else
        complain "bin/ not rebuilt (run: bash $SHELL_DIR/install.sh)"
    fi
    mkdir -p "$HOME/bin"
    if [ ! -e "$HOME/bin/banditshell" ] || [ "$(readlink -f "$HOME/bin/banditshell")" != "$SHELL_DIR/bin/banditshell" ]; then
        ln -sfn "$SHELL_DIR/bin/banditshell" "$HOME/bin/banditshell"
        echo "exec symlink restored: ~/bin/banditshell"
    fi
    if command -v qs >/dev/null 2>&1; then
        echo "quickshell $(qs --version 2>/dev/null | head -1)"
    else
        complain "quickshell missing (run: bash $SHELL_DIR/install.sh)"
    fi
    if command -v dkms >/dev/null 2>&1 && dkms status 2>/dev/null | grep -q . && ! dkms status 2>/dev/null | grep -q "$(uname -r)"; then
        complain "no dkms module built for the running kernel $(uname -r); a reboot may come up without graphics (update again, or boot the older kernel)"
    fi
    failed=$(systemctl --failed --no-pager 2>/dev/null | sed -n 's/^\(.*\.service\).*/\1/p' | tr '\n' ' ')
    if [ -n "$failed" ]; then
        echo "failed units (machine state, not the shell): $failed"
    fi
    echo "the shell itself: $(running && echo running || echo 'not running (try: banditshell start)')"
    ;;
toggle | open | set | get | list | status | close)
    route_verb "$cmd" "$@"
    ;;
panic)
    close_everything
    ;;
dispatch)
    [ $# -ge 1 ] || { echo "usage: banditshell dispatch <target> <action> [args...]" >&2; exit 2; }
    route_dispatch "$@"
    ;;
completions)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    install | print | status | remove)
        exec "$SHELL_DIR/scripts/zsh-completion.sh" "$sub" "$@"
        ;;
    *) echo "usage: banditshell completions install|print|status|remove" >&2; exit 2 ;;
    esac
    ;;
shot)
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/shot.png}"
    grim "$out"
    echo "$out"
    ;;
files)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | open) ipc files "$sub" "${1:-}" ;;
    close | status) ipc files "$sub" ;;
    *) echo "usage: banditshell files toggle|open [dir]|close|status" >&2; exit 2 ;;
    esac
    ;;
build)
    cc="${CC:-gcc}"
    command -v "$cc" >/dev/null || { echo "banditshell: no C compiler (set \$CC, or install gcc)" >&2; exit 1; }
    read -ra cflags <<<"-O2 -Wall -Wextra -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -fstack-protector-strong -fstack-clash-protection -fPIE ${CFLAGS:-}"
    read -ra ldflags <<<"-pie -Wl,-z,relro,-z,now ${LDFLAGS:-}"
    read -ra wayland <<<"$(pkg-config --libs wayland-client 2>/dev/null || echo -lwayland-client)"
    mkdir -p "$SHELL_DIR/bin"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-pty" "$SHELL_DIR/src/bs-pty.c" "${ldflags[@]}" -lutil
    echo "src/bs-pty.c -> bin/bs-pty"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-ls" "$SHELL_DIR/src/bs-ls.c" "${ldflags[@]}"
    echo "src/bs-ls.c -> bin/bs-ls"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-gamma" "$SHELL_DIR/src/bs-gamma.c" "$SHELL_DIR/src/gamma-client-protocol.c" "${ldflags[@]}" "${wayland[@]}" -lm
    echo "src/bs-gamma.c -> bin/bs-gamma"
    ;;
shaders)
    qsb="${QSB:-/usr/lib/qt6/bin/qsb}"
    [ -x "$qsb" ] || { echo "banditshell: qsb not found (install qt6-shadertools)" >&2; exit 1; }
    while IFS= read -r f; do
        "$qsb" --glsl "100es,120,150" --hlsl 50 --msl 12 -o "$f.qsb" "$f"
        echo "${f#"$SHELL_DIR/"} -> ${f#"$SHELL_DIR/"}.qsb"
    done < <(find "$SHELL_DIR/components" -name '*.frag' | sort)
    ;;
test)
    command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
    cd "$SHELL_DIR" || exit 1
    exec node --test 'tests/*.test.js' "$@"
    ;;
demo)
    [ $# -ge 1 ] || { echo "usage: banditshell demo <menu> [file]" >&2; exit 2; }
    mkdir -p "$SHOT_DIR"
    out="${2:-$SHOT_DIR/menu-$1.png}"
    ipc menu open "$1" "" >/dev/null
    sleep 0.6
    grim "$out"
    ipc menu close >/dev/null
    echo "$out"
    ;;
filespreview)
    where="${1:-$HOME}"
    out="${2:-}"
    resolve_target
    w=$(ipc_quiet shell get files.width || echo 1200)
    h=$(ipc_quiet shell get files.height || echo 760)
    hyprctl eval "hl.window_rule({ name = \"banditshell-filespreview\", match = { title = \"^(banditshell-filespreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true })" >/dev/null 2>&1 ||
        hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-filespreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-filespreview)\$ ; keyword windowrule center on, match:title ^(banditshell-filespreview)\$" >/dev/null 2>&1 || true
    start_preview FilesPreview 0 "FILES_PREVIEW=$where"
    if [ -n "$out" ]; then
        sleep 4
        preview_failed FilesPreview && exit 1
        rect=$(window_rect banditshell-filespreview)
        if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
        kill "$preview_pid" 2>/dev/null || true
        echo "$out"
    else
        sleep 2
        preview_failed FilesPreview && exit 1
        wait "$preview_pid"
    fi
    ;;
lockpreview)
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/lock.png}"
    start_preview LockPreview 9
    sleep 4
    preview_failed LockPreview && exit 1
    grim "$out"
    wait "$preview_pid" || true
    echo "$out"
    ;;
settingspreview)
    mkdir -p "$SHOT_DIR"
    size="${1:-560x560}"
    page="${2:-}"
    out="${3:-$SHOT_DIR/settings-$size${page:+-$page}.png}"
    w="${size%x*}"
    h="${size#*x}"
    ws="${PREVIEW_WORKSPACE:-6}"
    hyprctl eval "hl.window_rule({ name = \"banditshell-settingspreview\", match = { title = \"^(banditshell-settingspreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true, workspace = \"$ws silent\", no_initial_focus = true, no_focus = true })" >/dev/null 2>&1 ||
        hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule center on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule workspace $ws silent, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_initial_focus on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_focus on, match:title ^(banditshell-settingspreview)\$" >/dev/null 2>&1 || true
    start_preview SettingsPreview 9 "SETTINGS_PREVIEW=$size" "SETTINGS_PAGE=$page"
    sleep 4
    preview_failed SettingsPreview && exit 1
    rect=$(window_rect banditshell-settingspreview)
    if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
    wait "$preview_pid" || true
    echo "$out"
    ;;
gallery)
    size="${1:-1280x800}"
    w="${size%x*}"
    h="${size#*x}"
    hyprctl eval "hl.window_rule({ name = \"banditshell-gallery\", match = { title = \"^(banditshell-gallery)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true })" >/dev/null 2>&1 ||
        hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-gallery)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-gallery)\$ ; keyword windowrule center on, match:title ^(banditshell-gallery)\$" >/dev/null 2>&1 || true
    start_preview Gallery 0 "GALLERY_SIZE=$size"
    sleep 2
    preview_failed Gallery && exit 1
    echo "gallery up at $size"
    ;;
help | -h | --help)
    usage
    ;;
*)
    if [ -z "${BANDITSHELL_MIGRATED:-}" ] && command -v node >/dev/null &&
        migrated=$(node "$SHELL_DIR/services/cli-migration.js" --cmd "$cmd${*:+ $*}" 2>/dev/null) &&
        [ -n "$migrated" ]; then
        words=("$cmd" "$@")
        lead="$migrated"
        kept=()
        for ((i = 0; i < ${#words[@]}; i++)); do
            kept=("${words[@]:i}")
            suffix="${kept[*]}"
            if [ "$migrated" = "$suffix" ]; then
                lead=""
                break
            elif [[ $migrated == *" $suffix" ]]; then
                lead="${migrated% "$suffix"}"
                break
            fi
            kept=()
        done
        read -ra lead_words <<<"$lead"
        export BANDITSHELL_MIGRATED=1
        exec "${BASH_SOURCE[0]}" "${lead_words[@]}" "${kept[@]}"
    fi
    usage >&2
    exit 2
    ;;
esac
