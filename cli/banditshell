#!/usr/bin/env bash
# banditshell - drive the shell from a terminal or a keybind
#
# panel                          the launcher, menus and every other panel
#   banditshell panel            every panel and menu by name
#   banditshell panel close      every panel away
#   banditshell panel <panel> [toggle|open|close|status] [screen]
#                                one panel; bare, whether it is open
#   banditshell panel files [toggle|open] [dir]
#                                the file browser, in a folder
#   banditshell panel settings open [page] [screen]
#   banditshell panel settings page <page>
#                                settings on a page, or another page while it
#                                stays put
#   banditshell panel launcher open [<query>]
#                                the launcher with the query already typed, like
#                                notifications unread
#   banditshell panel launcher run <app|row>
#                                start an app the way the launcher does, or run
#                                any launcher row by its id, like command:lock
#   banditshell panel keyboard [dock|float]
#   banditshell panel keyboard page <layer> [screen]
#                                dock or float the on-screen keyboard, or show one
#                                of its layers
#   banditshell panel clipboard list
#   banditshell panel clipboard [use|pin|remove] <index>
#   banditshell panel clipboard clear
#                                the clipboard's history
#   banditshell panel calculator [full|compact]
#   banditshell panel calculator answer <expression>
#                                open the calculator in a shape, or answer without
#                                opening it
#   banditshell panel notifications clear
#                                empty the notification history
#   banditshell panel notifications [open|toggle|close]
#                                the history is a launcher mode: open and toggle
#                                show the launcher on notifications
#   <panel>: launcher|session|clipboard|media|calculator|quickcontrols
#            keyboard|settings|notifications|island|hotkeys|files|wallpaper
#                                and every menu; banditshell panel lists them all
#
# output                         which device plays: the speakers or the headphones
#   banditshell output           what plays, and which device is which
#   banditshell output [speakers|headphones|toggle]
#                                play through one, or flip between them
#   banditshell output list      every device that can play
#   banditshell output assign [speakers|headphones] <device>
#                                name the device that is the speakers or the
#                                headphones
#
# screen                         brightness, temperature, border, sidebar, stream
#   banditshell screen           all of it at once
#   banditshell screen brightness [<percent>|+n|-n]
#                                every display that answers DDC; .5 is 50 percent,
#                                a bare + or - moves 10
#   banditshell screen temperature [<kelvin>|off]
#                                warm the colours, or stop
#   banditshell screen border [on|off|toggle]
#                                the shell's frame; off is the bare desktop
#   banditshell screen sidebar [on|off|toggle] [<screen>|all]
#                                the sidebar, on one screen or on every one
#   banditshell screen stream on [screen]
#   banditshell screen stream off
#                                streamer mode: a band with the OBS deck across
#                                one screen
#
# wallpaper                      the picture: next, previous, a file, on or off
#   banditshell wallpaper        what each screen wears; the picker is banditshell
#                                panel wallpaper
#   banditshell wallpaper [on|off|toggle]
#   banditshell wallpaper [next|prev|clear] [<screen>|all]
#   banditshell wallpaper set <file> [<screen>|all]
#                                wear a file, on one screen or on every one
#   banditshell wallpaper list [screen]
#   banditshell wallpaper palette
#                                every picture, or the colours of the one worn
#
# screenshot                     a region saved or copied, or the whole desktop
#   banditshell screenshot save [--freeze]
#                                pick a region, save it and open the editor;
#                                --freeze stills the screen before the pick
#   banditshell screenshot copy [--freeze]
#                                pick a region onto the clipboard. Without the
#                                shell, save and copy fall back on grim and slurp
#   banditshell screenshot full [file]
#                                the whole desktop, no picking
#
# clock                          timers, alarms and world clocks
#   banditshell clock            the timers and the alarms
#   banditshell clock timer start <duration> [label]
#   banditshell clock timer [pause|resume|toggle|cancel] [handle]
#                                a duration is 10 (minutes), 90s or 1h30m; bare,
#                                the running timers
#   banditshell clock alarm add <time> [--days <days>] [--label <text>] [--run <command>|--ask <message>]
#                                when it rings, --run runs a command and --ask
#                                sends the message through clock.cloud
#   banditshell clock alarm [list|snooze|stop]
#   banditshell clock alarm [enable|disable|remove] <handle>
#                                bare, the next alarm and what is ringing
#   banditshell clock zone list
#   banditshell clock zone [find|add|remove] <place>
#                                the world clocks in the clock menu
#
# focus                          modes, and quiet notifications
#   banditshell focus            the mode, and whether notifications are quiet
#   banditshell focus mode [none|work|play|stream|sleep|list]
#                                the mode, or switch to one; none puts back what
#                                the last one changed
#   banditshell focus quiet [on|off|toggle] [hour|evening|tomorrow|never]
#                                quiet notifications still collect in history but
#                                show no popup and make no sound; the second word
#                                is when quiet ends
#
# notifications                  the history in the launcher, and the alert on screen
#   banditshell notifications    what is waiting: unread, held and whether quiet
#   banditshell notifications list [unread|held] [<app>]
#                                one line per conversation: number, app, age, how
#                                many messages and what was said
#   banditshell notifications open [<query>]
#                                the launcher on the history, with the query typed
#   banditshell notifications act
#   banditshell notifications dismiss [front|all]
#   banditshell notifications reply <text>
#   banditshell notifications snooze [<span>]
#                                the alert on screen: open it, put it away, answer
#                                it, or have it back later; 10m, 1h or day
#   banditshell notifications mute <app> [hour|day|never]
#   banditshell notifications unmute <app>
#                                stop an app's popups and sounds for a while, or
#                                until unmuted; they still collect in the history
#   banditshell notifications clear
#                                empty the history
#
# island                         post a task, a timer or a level to the island
#   banditshell island           what the island shows now
#   banditshell island push [--id <id>] [--text <text>] [--detail <text>] [--progress <fraction>] [--icon <name>] [--until <span>] [--priority <n>] [--run <command>]
#                                show an activity; --id and --text are needed.
#                                progress is 0 to 1, or unknown, which spins; until
#                                is how long it may stay, like 30s or 2m; a press on
#                                the row runs the command. An id pushed again
#                                replaces the first
#   banditshell island update <id> [--text <text>] [--detail <text>] [--progress <fraction>] [--icon <name>] [--until <span>]
#                                change what it shows; a detail of - clears it
#   banditshell island end <id> [done|failed|cancelled]
#                                finish it: its mark stays for a moment, then it goes
#   banditshell island list      every activity and where it stands
#
# tablet                         tablet mode, the lid and the pen's area
#   banditshell tablet           the hinge, the lid and the pen's area
#   banditshell tablet [on|off|toggle] [caller]
#   banditshell tablet lid [open|closed|toggle] [caller]
#                                tablet mode and the lid as the shell believes
#                                them; caller names who said so
#   banditshell tablet probe
#   banditshell tablet probe lid
#                                ask the hardware, and say how it answered
#   banditshell tablet pen [edit|commit|cancel|aspect|centre|follow]
#                                edit opens the mapper over the screen; the rest
#                                act on it
#   banditshell tablet pen area <x> <y> <width> <height>
#                                map the pen to a rectangle without the mapper
#
# config                         read and write settings, pick a theme
#   banditshell config get <key>
#                                a dotted key in config.json
#   banditshell config set <key> <value>
#                                write one; the shell takes it at once
#   banditshell config theme [<theme>|list]
#                                the theme; bare, its name
#
# update                         the shell's own version: look, apply, go back
#   banditshell update           one line: the release this copy is on and
#                                whether a newer one is waiting.
#                                updates.channel in config.json picks what is
#                                followed: stable (each release, the default) or
#                                main (every merge); updates.branch, when it is
#                                not main, follows that branch instead
#   banditshell update check [--json] [--no-fetch]
#                                fetch, then say which release is waiting and
#                                what it changes
#                                (restart or reload, commands, dependencies, your
#                                edits in the way); exit 0 when current, 10 when
#                                a version is waiting, 1 on an error; --no-fetch
#                                reads what the last fetch brought
#   banditshell update apply [--to <sha>] [--detach] [--json]
#                                stage the new version, check that it loads,
#                                move the checkout up, restart when it needs
#                                one and go back on its own if it does not start
#   banditshell update rollback [--detach] [--json]
#                                on stable the release before this one, on main
#                                the version before the last update; what it
#                                leaves is skipped until a newer one arrives
#   banditshell update status [--json]
#                                where this copy stands, the last update's
#                                outcome and the version it replaced
#
# start|stop|restart|status|log|doctor
#                                the shell itself
#   banditshell start            start the shell and wait until it is up
#   banditshell stop             stop it, a tried worktree included
#   banditshell restart          stop it and start it again, a tried worktree
#                                included
#   banditshell status [--json]  what the shell thinks the compositor said
#   banditshell log [args]       the running shell's log
#   banditshell doctor [--json]  repair bin/, the helpers and ~/bin/banditshell,
#                                put the Lua module in place, then report
#                                quickshell, dkms, failed units and binds in an
#                                old form
#   banditshell doctor api       put the Lua module in place and check it: the
#                                shim in your Hyprland config, the checkout
#                                pointer, every action id, your binds and the
#                                banditshell on your PATH; exits 1 on a failure
#   banditshell doctor --report  for a bug report: the version, your config with
#                                tokens, keys, passwords and cookies left out, the
#                                last 40 log lines and whether the module and rules
#                                checks pass
#   banditshell doctor binds     the binds still in an old form, and where
#   banditshell doctor binds rewrite
#                                rewrite them, a dated .bak beside each file
#
# unstick|watchdog               a frozen or crashed shell, lock screen included
#   banditshell unstick          keep a trace of a frozen shell, stop it and
#                                start it again; a locked session gets its lock
#                                screen back
#   banditshell watchdog         check on the shell every 10 seconds and unstick
#                                it on its own: frozen for 30 seconds, or gone
#                                while the session is locked
#
# triage                         tell the maintainer something is wrong
#   banditshell triage [--yes]   a report with no words of yours
#   banditshell triage [<words>] [--yes]
#                                say what went wrong in your own words; the
#                                report adds the version, your config with
#                                secrets left out, the log and the checks, shows
#                                you all of it, and files it as a github issue
#                                once you answer y; --yes skips the question,
#                                and without a terminal nothing is sent, the
#                                report is saved with the command that sends it
#
# action                         run a stable action by its id
#   banditshell action <id> [args...]
#                                the names a bind keeps across updates. The id is
#                                looked up in api/actions.tsv when it runs, then
#                                run as whatever command it stands for today, so
#                                a renamed command never breaks a bind
#
# api                            the table of stable action ids
#   banditshell api list [<pattern>] [--json]
#                                every id with its status and what it does; a
#                                pattern like 'panel.*' narrows the list
#   banditshell api show <id>    one id: the command it runs, since which API
#   banditshell api check        every id against the commands this CLI has, and
#                                the table against the Lua module; exits 1 on a
#                                failure
#
# version                        which build is installed
#   banditshell version [--json]
#                                the version (the release, with +n for commits
#                                past it, or the newest what's-new id), the update
#                                channel and the branch it follows, the commit and
#                                branch, the checkout, the API number and the
#                                Quickshell and Hyprland versions
#
# events                         follow the shell without polling
#   banditshell events [--filter <names>]
#                                one JSON line per event while it runs: workspace,
#                                panel, mode, quiet, media, activity, notification
#                                and update. --filter takes names or groups, like
#                                panel,media.track; docs/events.md has every field
#
# completions                    tab completion for zsh and bash
#   banditshell completions [install|status|remove|print] [zsh|bash]
#                                built from this text, and rebuilt on the first
#                                Tab after it changes
#
# dev                            working on banditshell: try, build, test, preview
#   banditshell dev try [worktree]
#                                run a worktree on the live session in place of
#                                the checkout: its branch, its number in the list
#                                or any unique part of its name, 0 for the
#                                checkout; bare, the one you are in, the only one,
#                                or a pick, once the merged ones are cleared and a
#                                merged one running has gone back to the checkout
#   banditshell dev back         the checkout again, after try
#   banditshell dev tidy         clear every worktree whose work is merged, with
#                                its branch, going back to the checkout first if
#                                one of them is running; then list the rest and
#                                their pull requests
#   banditshell dev watch        while a worktree runs, go back to the checkout
#                                once it is merged; try starts this itself
#   banditshell dev worktrees    every worktree's branch
#   banditshell dev run          the shell in the foreground
#   banditshell dev build        compile src/*.c into bin/
#   banditshell dev shaders      compile components/**/*.frag to .qsb
#   banditshell dev test [args]  run tests/*.test.js in node
#   banditshell dev check        compile every QML file in a fresh engine, then
#                                run the tests
#   banditshell dev modules      check the module boundaries against
#                                modules.baseline.json; a new violation fails
#   banditshell dev modules [--matrix]
#                                which package reaches for which, as a table
#   banditshell dev modules --graph
#                                the same as a Markdown page with a Mermaid graph
#   banditshell dev modules --explain <package>
#                                what a package needs, from which file and line
#   banditshell dev lint         check the house rules (comments, radii, motion,
#                                font sizes, colours, dashes, qmldirs, singleton
#                                member reads) against
#                                rules.baseline.json; a new violation fails
#   banditshell dev lint [--all] [--write-baseline]
#                                every violation with file and line, or record
#                                today's counts as the new baseline
#   banditshell dev lint --rule <rule>
#                                one rule only, L1 to L16
#   banditshell dev release [--dry-run] [--skip-boot-check]
#                                cut the next release from a clean checkout of
#                                origin/main: tests, modules, house rules,
#                                compile and boot checks, then the number (minor
#                                for a feature, patch for fixes), the tag, stable
#                                moved and the GitHub release with what's new
#                                since the last tag; --dry-run pushes nothing;
#                                without gamescope it refuses unless
#                                --skip-boot-check is given
#   banditshell dev check island [dir]
#                                walk the island through every situation it has
#                                a rule for, headless: each checked, and
#                                photographed into dir
#   banditshell dev check boot [--shots] [dir]
#                                boot the real shell.qml headless in a private
#                                session, call every ipc status and a round of
#                                verbs, and fail on any runtime error in its log;
#                                --shots photographs it at rest and with the
#                                launcher open
#   banditshell dev perf [--runs <n>] [--boots <n>] [--only <pattern>] [--profile] [--ns] [dir]
#                                time every operation headless: boot the shell n
#                                times (5), then open and close every panel, menu
#                                and settings page n times (5), and print each
#                                step in between with first, last, mean, median,
#                                min and max; --profile also lists the bindings,
#                                functions and objects that took the time inside
#                                each one; --ns prints nanoseconds
#   banditshell dev perf live [--runs <n>] [--only <pattern>] [--ns] [dir]
#                                the same against the running shell, on screen
#   banditshell dev trace [on|off|status]
#                                record the running shell's own timings while you
#                                use it
#   banditshell dev trace clear [dir]
#                                forget what was recorded, in the shell and in dir
#   banditshell dev trace report [dir]
#                                every operation recorded so far, grouped, as a
#                                table and a page
#   banditshell dev inspect island [screen]
#                                look at every situation on the live island:
#                                a panel on the right makes each one up, and
#                                you hover and click the island itself
#   banditshell dev inspect close
#                                end it and take everything made up away
#   banditshell dev preview lock [file]
#                                the lock face, photographed
#   banditshell dev preview settings [WxH] [page] [file]
#                                the settings face at a size, photographed
#   banditshell dev preview files [dir] [file]
#                                the file browser in a window; with a file,
#                                photographed
#   banditshell dev preview gallery [WxH]
#                                every component the shell owns, in a window
#   banditshell dev preview menu <menu> [file]
#                                open a menu, photograph it, put it away
#   banditshell dev menu [current|hover|list]
#                                the open menu, the one under the pointer, or
#                                every menu
#   banditshell dev launcher scrub <fraction>
#                                hold the launcher's letter rail at 0 to 1; below
#                                0 lets go
#   banditshell dev keyring [status|demo|close]
#                                the keyring's password prompt: what it asks, a
#                                made-up question, or refuse it
#   banditshell dev polkit [status|demo|close]
#                                the shell's polkit password prompt: whether the
#                                shell is the agent, what it asks, a made-up
#                                question, or refuse it
#
# help                           this list; banditshell help <command> for one
#   banditshell help [<command>]
#
# exit codes: 0 done, 1 failed, 2 usage, 3 the shell is not running, 4 the shell
# refused. --json after a status command prints it as JSON.

set -euo pipefail

SHELL_DIR="${BANDITSHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SHOT_DIR="${BANDITSHELL_SHOTS:-${XDG_RUNTIME_DIR:-/tmp}/banditshell}"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/banditshell"
PID_FILE="$RUN_DIR/pid"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/banditshell"
HYPR_DIR="${HYPR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"
SHIM_NAME=banditshell.lua
BACKUP="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/lastgood"
FAILED_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/failed.log"
STAGED="${XDG_CACHE_HOME:-$HOME/.cache}/banditshell/staged"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/banditshell"
UPDATE_STATE="$STATE_ROOT/update"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
HEALTH_WAIT="${BANDITSHELL_HEALTH_WAIT:-8}"
HEALTH_SCAN="${BANDITSHELL_HEALTH_SCAN:-3}"
SURFACES=(launcher session clipboard media calculator quickcontrols keyboard settings notifications island hotkeys files wallpaper)
HELPERS=(bs-pty bs-ls bs-gamma)
IPC_LIMIT="${BANDITSHELL_IPC_LIMIT:-10}"
HANG_DIR="$STATE_DIR/hangs"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
    bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' magenta=$'\e[35m' cyan=$'\e[36m' plain=$'\e[0m'
else
    bold="" dim="" red="" green="" yellow="" magenta="" cyan="" plain=""
fi

qs_target=()
qs_target_resolved=0
migrated="${BANDITSHELL_MIGRATED:-}"
unset BANDITSHELL_MIGRATED

list_instances() {
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Process ID:/ { pid = $NF }
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            print pid "\t" p
        }
    '
}

instance_of() {
    local pid path
    while IFS=$'\t' read -r pid path; do
        [ "$path" = "$1/shell.qml" ] && { echo "$pid"; return 0; }
    done < <(list_instances)
    return 1
}

worktree_list() {
    git -C "$SHELL_DIR" worktree list --porcelain 2>/dev/null | awk '
        /^worktree / { path = substr($0, 10); branch = "(detached)" }
        /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch) }
        /^$/ && path != "" { print path "\t" branch; path = "" }
        END { if (path != "") print path "\t" branch }
    '
}

main_dir() {
    local path branch
    if IFS=$'\t' read -r path branch < <(worktree_list) && [ -n "$path" ]; then
        echo "$path"
    else
        echo "$SHELL_DIR"
    fi
}

branch_of() {
    local path branch
    while IFS=$'\t' read -r path branch; do
        [ "$path" = "$1" ] && { echo "$branch"; return 0; }
    done < <(worktree_list)
    echo "${1##*/}"
}

known_shells() {
    printf '%s/shell.qml\n' "$SHELL_DIR" "$BACKUP"
    worktree_list | cut -f1 | sed 's|$|/shell.qml|'
}

shell_pids() {
    local pid path known
    known=$(known_shells)
    while IFS=$'\t' read -r pid path; do
        if grep -qxF -- "$path" <<<"$known"; then
            echo "$pid"
        fi
    done < <(list_instances)
}

live_dir() {
    local pid path known
    known=$(known_shells)
    while IFS=$'\t' read -r pid path; do
        if grep -qxF -- "$path" <<<"$known"; then
            echo "${path%/shell.qml}"
            return 0
        fi
    done < <(list_instances)
    return 1
}

live_worktree() {
    local live
    live=$(live_dir) || return 1
    [ "$live" != "$(main_dir)" ] && [ "$live" != "$BACKUP" ] || return 1
    echo "$live"
}

match_worktree() {
    local want="$1" home path branch folder number=0
    local -a hits=()
    [ -n "$want" ] || return 1
    home=$(main_dir)
    if [ -d "$want" ]; then
        want=$(git -C "$want" rev-parse --show-toplevel 2>/dev/null || echo "$want")
    fi
    while IFS=$'\t' read -r path branch; do
        if [ "$path" = "$home" ]; then
            [ "$want" = 0 ] || [ "$want" = "$branch" ] || [ "$want" = "$path" ] || continue
            hits=("$path")
            break
        fi
        number=$((number + 1))
        folder="${path##*/}"
        if [[ $want == /* ]]; then
            [ "$want" = "$path" ] && hits=("$path") && break
        elif [[ $want =~ ^[0-9]+$ ]]; then
            [ "$want" = "$number" ] && hits=("$path") && break
        elif [ "$want" = "$branch" ] || [ "$want" = "$folder" ]; then
            hits=("$path")
            break
        elif [[ ${branch,,} == *"${want,,}"* || ${folder,,} == *"${want,,}"* ]]; then
            hits+=("$path")
        fi
    done < <(worktree_list)
    [ "${#hits[@]}" -eq 1 ] || return 1
    echo "${hits[0]}"
}

other_worktrees() { worktree_list | tail -n +2; }

pick_worktree() {
    local home live guess target
    local -a others=()
    home=$(main_dir)
    live=$(live_dir || true)
    for guess in "$(git rev-parse --show-toplevel 2>/dev/null || true)" "$SHELL_DIR"; do
        target=$(match_worktree "$guess") || continue
        if [ "$target" != "$home" ] && [ "$target" != "$live" ]; then
            echo "$target"
            return 0
        fi
    done
    mapfile -t others < <(other_worktrees | cut -f1)
    [ "${#others[@]}" -eq 1 ] && [ "${others[0]}" != "$live" ] || return 1
    echo "${others[0]}"
}

pulls=""
pulls_loaded=0
cleared=0

main_ref() {
    local branch
    branch=$(branch_of "$1")
    if git -C "$1" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
        echo "origin/$branch"
    else
        echo "$branch"
    fi
}

load_pulls() {
    [ "$pulls_loaded" = 0 ] || return 0
    pulls_loaded=1
    command -v gh >/dev/null || return 0
    pulls=$(cd "$(main_dir)" && timeout 8 gh pr list --state all --limit 200 \
        --json number,headRefName,state,headRefOid \
        --jq '.[] | [.headRefName, .number, (.state | ascii_downcase), .headRefOid] | @tsv' 2>/dev/null) || pulls=""
}

pull_of() { awk -F'\t' -v branch="$1" '$1 == branch { print $2 "\t" $3 "\t" $4; exit }' <<<"$pulls"; }

pull_label() {
    local number state
    IFS=$'\t' read -r number state _ <<<"$(pull_of "$1")"
    [ -z "$number" ] || echo "#$number $state"
}

landed() {
    local home="$1" base="$2" branch="$3" tip="$4" number state merged_tip
    IFS=$'\t' read -r number state merged_tip <<<"$(pull_of "$branch")"
    if [ "$state" = merged ] && { [ "$merged_tip" = "$tip" ] || git -C "$home" merge-base --is-ancestor "$tip" "$base"; }; then
        echo "merged #$number"
        return 0
    fi
    git -C "$home" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null &&
        git -C "$home" merge-base --is-ancestor "refs/remotes/origin/$branch" "$base" &&
        git -C "$home" merge-base --is-ancestor "$tip" "$base" || return 1
    echo "on $base"
}

tidy_worktrees() {
    local home base live here entries checked path branch tip why changed
    home=$(main_dir)
    if git -C "$home" remote get-url origin >/dev/null 2>&1; then
        timeout 10 git -C "$home" fetch --quiet origin "$(branch_of "$home")" 2>/dev/null &
    fi
    load_pulls
    wait
    base=$(main_ref "$home")
    live=$(live_dir || true)
    here=$(git rev-parse --show-toplevel 2>/dev/null || true)
    git -C "$home" worktree prune 2>/dev/null || true
    entries=$(worktree_list)
    while IFS=$'\t' read -r path branch; do
        [ "$path" != "$home" ] || continue
        tip=$(git -C "$path" rev-parse -q --verify HEAD 2>/dev/null) || continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        changed=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
        if [ "$path" = "$here" ]; then
            echo "${yellow}kept $branch, $why: you are in it$plain"
        elif [ "$changed" -gt 0 ]; then
            echo "${yellow}kept $branch, $why: $changed changed since$plain"
        elif [ -f "$(git -C "$path" rev-parse --absolute-git-dir)/locked" ]; then
            echo "${yellow}kept $branch, $why: locked$plain"
        elif [ "$path" = "$live" ] && ! leave_merged "$home" "$base" "$branch" "$tip" "$why"; then
            continue
        elif git -C "$home" worktree remove "$path"; then
            git -C "$home" branch -qD "$branch" 2>/dev/null || true
            echo "${dim}cleared$plain $branch$dim, $magenta$why$plain"
            cleared=$((cleared + 1))
        fi
    done <<<"$entries"
    checked=$(cut -f2 <<<"$entries")
    while IFS=$'\t' read -r branch tip; do
        grep -qxF -- "$branch" <<<"$checked" && continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        if git -C "$home" branch -qD "$branch"; then
            echo "${dim}cleared$plain $branch$dim, $magenta$why$dim, no worktree$plain"
            cleared=$((cleared + 1))
        fi
    done < <(git -C "$home" for-each-ref --format='%(refname:short)%09%(objectname)' refs/heads)
}

leave_merged() {
    local home="$1" base="$2" branch="$3" tip="$4" why="$5"
    if ! git -C "$home" merge-base --is-ancestor "$tip" HEAD; then
        if [ "$(git -C "$home" symbolic-ref -q --short HEAD)" != "${base#origin/}" ] ||
            ! git -C "$home" merge --ff-only --quiet "$base" >/dev/null 2>&1; then
            echo "${yellow}kept $branch, $why: it is running, and the checkout cannot move up to $base on its own (update it, then banditshell dev back)$plain"
            return 1
        fi
        echo "${dim}moved the checkout up to $base$plain"
    fi
    echo "${dim}$branch is $why and running, so back to the checkout$plain"
    go_back
}

watch_merges() {
    local home base live branch tip why
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/banditshell-watch.lock"
    flock -n 9 || exit 0
    while sleep 120; do
        live=$(live_worktree) || exit 0
        home=$(main_dir)
        branch=$(branch_of "$live")
        timeout 30 git -C "$home" fetch --quiet origin "$(branch_of "$home")" 2>/dev/null || continue
        pulls_loaded=0
        load_pulls
        base=$(main_ref "$home")
        tip=$(git -C "$live" rev-parse -q --verify HEAD 2>/dev/null) || continue
        why=$(landed "$home" "$base" "$branch" "$tip") || continue
        [ -z "$(git -C "$live" status --porcelain 2>/dev/null)" ] || continue
        leave_merged "$home" "$base" "$branch" "$tip" "$why" 9>&- >/dev/null 2>&1 || continue
        notify-send -a banditshell "Back on $(branch_of "$home")" "$branch is $why" 2>/dev/null || true
        exit 0
    done
}

list_worktrees() {
    local live home base entries path branch label number=0 ahead changed pull width=0
    local label_tint branch_tint ahead_tint changed_tint pull_tint
    live=$(live_dir || true)
    home=$(main_dir)
    base=$(main_ref "$home")
    entries=$(worktree_list)
    load_pulls
    while IFS=$'\t' read -r path branch; do
        [ "${#branch}" -le "$width" ] || width=${#branch}
    done <<<"$entries"
    while IFS=$'\t' read -r path branch; do
        label=$number label_tint=$bold branch_tint=""
        if [ "$path" = "$live" ]; then
            label="*" label_tint=$green branch_tint=$green
        fi
        number=$((number + 1))
        pull=""
        [ "$path" = "$home" ] || pull=$(pull_label "$branch")
        case "$pull" in
        *open) pull_tint=$green ;;
        *merged) pull_tint=$magenta ;;
        *closed) pull_tint=$red ;;
        *) pull_tint="" ;;
        esac
        ahead=$(git -C "$path" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
        ahead_tint=$dim
        [ "$ahead" -eq 0 ] || ahead_tint=$cyan
        changed=$(git -C "$path" status --porcelain 2>/dev/null | wc -l)
        changed_tint=$dim
        [ "$changed" -eq 0 ] || changed_tint=$yellow
        printf '%s%3s%s  %s%-*s%s  %s+%-3s%s %s%3s changed%s  %s%-11s%s %s%s%s\n' \
            "$label_tint" "$label" "$plain" "$branch_tint" "$width" "$branch" "$plain" \
            "$ahead_tint" "$ahead" "$plain" "$changed_tint" "$changed" "$plain" \
            "$pull_tint" "$pull" "$plain" "$dim" "${path/#"$HOME"/\~}" "$plain"
    done <<<"$entries"
}

cached_pid() {
    local pid dir
    [ -r "$PID_FILE" ] || return 1
    IFS=$'\t' read -r pid dir <"$PID_FILE" || return 1
    [ "$dir" = "$SHELL_DIR" ] || return 1
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
    qs | quickshell* | .quickshell-wra* | .qs-wrapped) echo "$pid" ;;
    *) return 1 ;;
    esac
}

detach() {
    if setsid --help 2>&1 | grep -q -- --fork; then
        setsid -f "$@"
    else
        setsid "$@" &
    fi
}

absolute_path() {
    local path=$1 resolved
    [[ $path == /* ]] || path=$PWD/$path
    resolved=$(realpath -s -m -- "$path" 2>/dev/null) || resolved=$path
    printf '%s\n' "$resolved"
}

remember_pid() {
    mkdir -p "$RUN_DIR" 2>/dev/null || return 0
    printf '%s\t%s\n' "$1" "$SHELL_DIR" >"$PID_FILE" 2>/dev/null || true
}

resolve_target() {
    if [ "$qs_target_resolved" = 1 ]; then
        return 0
    fi
    qs_target_resolved=1

    local pid path exact="" any=""
    if pid=$(cached_pid); then
        qs_target=(--pid "$pid")
        return 0
    fi
    while IFS=$'\t' read -r pid path; do
        case "$path" in
        "$SHELL_DIR/shell.qml") exact="$pid" ;;
        */shell.qml) [ -n "$any" ] || any="$pid" ;;
        esac
    done < <(list_instances)

    local pick="${exact:-$any}"
    if [ -n "$pick" ]; then
        qs_target=(--pid "$pick")
        remember_pid "$pick"
    else
        qs_target=(-p "$SHELL_DIR")
    fi
}

complain() {
    echo "${red}banditshell: $1$plain" >&2
    hyprctl notify -1 5000 "rgb(e06c75)" "banditshell: $1" >/dev/null 2>&1 || true
}

reply_of() {
    case "$1" in
    "refused: "*)
        echo "banditshell: ${1#refused: }" >&2
        return 4
        ;;
    "no shell window"* | "no such "*)
        echo "banditshell: $1" >&2
        return 4
        ;;
    "usage: "*)
        echo "banditshell: $1" >&2
        return 2
        ;;
    esac
    [ -z "$1" ] || printf '%s\n' "$1"
    return 0
}

ipc() {
    local out status=0
    if [ -n "${BANDITSHELL_DRY:-}" ]; then
        echo "ipc $*"
        return 0
    fi
    resolve_target
    out=$(cd "$HOME" && timeout "$IPC_LIMIT" qs ipc "${qs_target[@]}" call "$@" 2>/dev/null) || status=$?
    if [ "$status" = 0 ]; then
        reply_of "$out"
        return $?
    fi
    if [ "$status" = 124 ]; then
        complain "the shell did not answer \`$*\` within ${IPC_LIMIT}s (try: banditshell restart)"
        return 4
    fi
    if [ "${qs_target[0]}" = --pid ] && kill -0 "${qs_target[1]}" 2>/dev/null; then
        complain "the shell is running but did not take \`$*\` (a build older than this CLI? try: banditshell restart)"
        return 4
    fi
    complain "not running (try: banditshell start)"
    return 3
}

ipc_quiet() {
    local out
    if [ -n "${BANDITSHELL_DRY:-}" ]; then
        echo "ipc $*"
        return 0
    fi
    resolve_target
    if out=$(cd "$HOME" && timeout "$IPC_LIMIT" qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    return 1
}

running() {
    cached_pid >/dev/null && return 0
    qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            if (p ~ /\/shell\.qml$/) found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

dry() { [ -n "${BANDITSHELL_DRY:-}" ] && [ "${BANDITSHELL_DRY:-}" != 0 ]; }

say_dry() { echo "${dim}dry: $*$plain"; }

refresh_backup() {
    if dry; then
        say_dry "refresh the last known good copy at $BACKUP"
        return 0
    fi
    [ "$(readlink -f "$SHELL_DIR")" != "$(readlink -f "$BACKUP")" ] || return 0
    mkdir -p "$BACKUP"
    if command -v rsync >/dev/null 2>&1 &&
        rsync -a --delete --exclude .git --exclude .claude --exclude .scratch "$SHELL_DIR/" "$BACKUP/"; then
        return 0
    fi
    find "$BACKUP" -mindepth 1 -delete
    find "$SHELL_DIR" -mindepth 1 -maxdepth 1 ! -name .git ! -name .claude ! -name .scratch -exec cp -a {} "$BACKUP/" \;
}

remember_checkout() {
    dry && return 0
    [ -e "$SHELL_DIR/.git" ] || return 0
    local tmp
    mkdir -p "$STATE_DIR" || return 0
    tmp=$(mktemp "$STATE_DIR/.root.XXXXXX") || return 0
    printf '%s\n' "$SHELL_DIR" >"$tmp" && mv -f "$tmp" "$STATE_DIR/root"
}

shell_answers() {
    local pid="$1" tries limit=$((HEALTH_WAIT * 4))
    for ((tries = 0; tries <= limit; tries++)); do
        (cd "$HOME" && qs ipc --pid "$pid" call shell status) >/dev/null 2>&1 && return 0
        kill -0 "$pid" 2>/dev/null || return 1
        sleep 0.25
    done
    return 1
}

log_trouble() {
    local pid="$1" mark="${2:-0}"
    (cd "$HOME" && qs log --pid "$pid" 2>&1) | sed 's/\x1b\[[0-9;]*m//g' | tail -n +"$((mark + 1))" |
        grep -E 'ReferenceError|Failed to load' | head -5 || true
}

log_length() {
    (cd "$HOME" && qs log --pid "$1" 2>/dev/null) | wc -l
}

health_check() {
    local pid="$1" mark="${2:-0}" tries steps=$((HEALTH_SCAN * 2)) trouble=""
    HEALTH_WHY=""
    if ! shell_answers "$pid"; then
        HEALTH_WHY="the shell did not answer shell status within ${HEALTH_WAIT} seconds"
        return 1
    fi
    for ((tries = 0; tries <= steps; tries++)); do
        trouble=$(log_trouble "$pid" "$mark")
        if [ -n "$trouble" ]; then
            HEALTH_WHY="the log shows errors: ${trouble%%$'\n'*}"
            return 1
        fi
        kill -0 "$pid" 2>/dev/null || { HEALTH_WHY="the shell exited"; return 1; }
        [ "$tries" -lt "$steps" ] && sleep 0.5
    done
    return 0
}

stop_pid() {
    local tries
    kill "$1" 2>/dev/null || return 0
    for ((tries = 0; tries < 40; tries++)); do
        kill -0 "$1" 2>/dev/null || return 0
        sleep 0.05
    done
}

launch_failed() {
    HEALTH_WHY="$3"
    mkdir -p "$(dirname "$FAILED_LOG")"
    {
        printf '%s %s: %s\n' "$(date '+%F %T')" "$1" "$3"
        cat "$2"
    } >>"$FAILED_LOG"
    rm -f "$2"
}

launch() {
    local out tries=0 pid=""
    if dry; then
        say_dry "start $1 with qs -d -p"
        say_dry "wait up to ${HEALTH_WAIT}s for shell status to answer over ipc"
        say_dry "watch the log for ${HEALTH_SCAN}s for ReferenceError or Failed to load"
        return 0
    fi
    out=$(mktemp)
    if ! (cd "$HOME" && qs -d -p "$1") 8>&- >"$out" 2>&1 || grep -q "Failed to load configuration" "$out"; then
        launch_failed "$1" "$out" "did not load"
        return 1
    fi
    while [ "$tries" -lt 30 ]; do
        if pid=$(instance_of "$1"); then
            break
        fi
        pid=""
        sleep 0.2
        tries=$((tries + 1))
    done
    if [ -z "$pid" ]; then
        launch_failed "$1" "$out" "never appeared in qs list"
        return 1
    fi
    if ! health_check "$pid" 0; then
        launch_failed "$1" "$out" "$HEALTH_WHY"
        stop_pid "$pid"
        return 1
    fi
    rm -f "$out"
    return 0
}

start_backup() {
    if [ ! -f "$BACKUP/shell.qml" ]; then
        complain "shell failed to load and there is no backup yet (errors: $FAILED_LOG)"
        return 1
    fi
    complain "shell failed to load - running the last known good copy (errors: $FAILED_LOG)"
    launch "$BACKUP"
}

stop_shell() {
    local -a pids
    local pid alive tries=0
    mapfile -t pids < <(shell_pids)
    [ "${#pids[@]}" -gt 0 ] || return 1
    if dry; then
        say_dry "stop the running shell (${pids[*]})"
        return 0
    fi
    for pid in "${pids[@]}"; do
        (cd "$HOME" && timeout 2 qs ipc --pid "$pid" call shell flush) >/dev/null 2>&1 || true
    done
    kill "${pids[@]}" 2>/dev/null || true
    while [ "$tries" -lt 40 ]; do
        alive=0
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                alive=1
            fi
        done
        [ "$alive" = 0 ] && return 0
        sleep 0.05
        tries=$((tries + 1))
    done
    return 0
}

start_checkout() {
    ensure_lua || true
    ensure_built || complain "checkout incomplete, starting anyway (run: banditshell doctor)"
    if launch "$SHELL_DIR"; then
        refresh_backup || true
        remember_checkout
        echo "$green$1$plain"
    else
        start_backup || exit 1
        echo "running from backup - the checkout itself failed to load (errors: $FAILED_LOG)" >&2
        exit 1
    fi
}

try_worktree() {
    local target="$1" name live
    name=$(branch_of "$target")
    (SHELL_DIR="$target" && ensure_lua) || true
    (SHELL_DIR="$target" && ensure_built) || complain "$name: helpers not built, trying it anyway (run: banditshell dev build in it)"
    live=$(live_dir || true)
    [ -z "$live" ] || [ "$live" = "$target" ] || echo "${dim}leaving $(branch_of "$live") for $name$plain"
    stop_shell || true
    if launch "$target"; then
        echo "${green}trying $name$plain$dim - back to the checkout on its own once merged, or banditshell dev back$plain"
        (cd "$HOME" && detach "$(readlink -f "${BASH_SOURCE[0]}")" dev watch </dev/null >/dev/null 2>&1) || true
        return 0
    fi
    complain "$name failed to load - back on the checkout (errors: $FAILED_LOG)"
    SHELL_DIR=$(main_dir)
    start_checkout "back on $(branch_of "$SHELL_DIR")"
    exit 1
}

reach_hyprland() {
    local instance socket
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "${XDG_RUNTIME_DIR:-/tmp}/hypr/$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        [ -n "${WAYLAND_DISPLAY:-}" ] && return 0
    fi
    read -r instance socket < <(hyprctl instances 2>/dev/null | awk '
        /^instance / { sub(/^instance /, ""); sub(/:$/, ""); instance = $0 }
        /wl socket:/ && instance != "" { print instance, $NF; exit }
    ') || return 1
    [ -n "$instance" ] || return 1
    export HYPRLAND_INSTANCE_SIGNATURE="$instance" WAYLAND_DISPLAY="$socket"
}

session_locked() {
    local pid session
    pid=$(hyprctl instances 2>/dev/null | awk -v sig="$HYPRLAND_INSTANCE_SIGNATURE" '
        /^instance / { here = index($0, sig) > 0 }
        here && /pid:/ { print $NF; exit }
    ')
    [ -n "$pid" ] && session=$(cat "/proc/$pid/sessionid" 2>/dev/null) || return 1
    [ "$(loginctl show-session "$session" -p LockedHint --value 2>/dev/null)" = yes ]
}

frozen_pid() {
    local pid
    for pid in $(shell_pids); do
        answers "$pid" && continue
        kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
    done
    return 1
}

shell_answering() {
    answering_pid >/dev/null
}

dump_frozen() {
    local pid="$1" file="$2" tries report="" crashes="${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/crashes"
    {
        echo "the shell (pid $pid) stopped answering at $(date '+%F %T')"
        session_locked && echo "the session was locked"
        echo
    } >"$file"
    touch "$file.mark"
    kill -ABRT "$pid" 2>/dev/null || true
    for ((tries = 0; tries < 50; tries++)); do
        report=$(find "$crashes" -mindepth 2 -maxdepth 2 -name report.txt -newer "$file.mark" 2>/dev/null | head -n 1 || true)
        [ -n "$report" ] && break
        sleep 0.2
    done
    rm -f "$file.mark"
    if [ -n "$report" ]; then
        cat "$report" >>"$file"
    else
        echo "quickshell wrote no crash report; its last log lines:" >>"$file"
        (cd "$HOME" && qs log --pid "$pid" --log-times 2>/dev/null) | sed 's/\x1b\[[0-9;]*m//g' |
            grep -v 'quickshell.io.socket' | tail -n 30 >>"$file"
    fi
}

unstick() {
    local pid live="" file="" tries
    reach_hyprland || { complain "no Hyprland to bring the shell back into"; return 1; }
    hyprctl eval 'hl.config({ misc = { allow_session_lock_restore = true } })' >/dev/null 2>&1 || true
    if pid=$(frozen_pid); then
        live=$(live_worktree || true)
        mkdir -p "$HANG_DIR"
        file="$HANG_DIR/$(date +%F-%H%M%S).txt"
        dump_frozen "$pid" "$file"
        echo "the shell had frozen; its trace is in $file"
        for ((tries = 0; tries < HEALTH_WAIT; tries++)); do
            shell_answering && break
            sleep 1
        done
    elif running; then
        echo "the shell answers; nothing to unstick"
        return 0
    fi
    if shell_answering; then
        echo "${green}back up$plain"
    else
        [ -z "$pid" ] || kill -KILL "$pid" 2>/dev/null || true
        if [ -n "$live" ]; then
            (try_worktree "$live")
        else
            (start_checkout "back up")
        fi
    fi
    if session_locked; then
        loginctl lock-session >/dev/null 2>&1 || true
    fi
}

answers() {
    kill -0 "$1" 2>/dev/null && (cd "$HOME" && timeout 5 qs ipc --pid "$1" call shell status) >/dev/null 2>&1
}

answering_pid() {
    local pid
    for pid in $(shell_pids); do
        answers "$pid" && { echo "$pid"; return 0; }
    done
    return 1
}

watchdog() {
    local strikes=0 known=""
    while sleep 10; do
        reach_hyprland || { strikes=0; known=""; continue; }
        if [ -n "$known" ] && answers "$known"; then
            strikes=0
            continue
        fi
        known=""
        if frozen_pid >/dev/null; then
            strikes=$((strikes + 1))
            [ "$strikes" -ge 3 ] || continue
        elif running || ! session_locked; then
            strikes=0
            known=$(answering_pid) || known=""
            continue
        fi
        strikes=0
        unstick || true
    done
}

header() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$(readlink -f "${BASH_SOURCE[0]}")"; }

usage() {
    header | awk '
        function emit() {
            if (name == "")
                return
            if (length(name) > 12)
                printf "  %s\n%15s%s\n", name, "", text
            else
                printf "  %-12s %s\n", name, text
            name = ""
        }
        NR == 1 { print; print ""; next }
        /^exit codes/ { emit(); foot = $0; infoot = 1; next }
        infoot && /^[^ ]/ { foot = foot "\n" $0; next }
        { infoot = 0 }
        /^[a-z][a-z|]*( |$)/ && !/^[a-z]+ [^ ]/ {
            emit()
            name = $1
            gsub(/\|/, "  ", name)
            text = substr($0, 30, 2) == "  " ? substr($0, 32) : ""
            sub(/^ +/, "", text)
            if (text != "")
                emit()
            next
        }
        name != "" && match($0, /^ +/) && RLENGTH == 31 {
            text = substr($0, 32)
            emit()
            next
        }
        { emit() }
        END {
            emit()
            if (foot != "")
                print "\n" foot
        }
    '
}

group_help() {
    header | awk -v want="$1" '
        function title() {
            if (titled)
                return
            printf "banditshell %s%s\n\n", name, text == "" ? "" : " - " text
            titled = 1
        }
        done { next }
        /^[a-z][a-z|]*( |$)/ && !/^[a-z]+ [^ ]/ {
            if (inside) {
                done = 1
                next
            }
            n = split($1, words, "|")
            for (i = 1; i <= n; i++)
                if (words[i] == want)
                    inside = 1
            if (inside) {
                name = $1
                gsub(/\|/, ", ", name)
                text = substr($0, 30, 2) == "  " ? substr($0, 32) : ""
                sub(/^ +/, "", text)
            }
            next
        }
        !inside { next }
        /^$/ {
            done = 1
            next
        }
        !titled && text == "" && match($0, /^ +/) && RLENGTH == 31 {
            text = substr($0, 32)
            next
        }
        { title(); print }
        END { exit inside ? 0 : 1 }
    '
}

nope() {
    echo "banditshell: $1 has no ${2:-<nothing>}" >&2
    group_help "${1%% *}" >&2
    exit 2
}

say_usage() {
    echo "usage: banditshell $1" >&2
    exit 2
}

helpers_current() {
    local helper
    for helper in "${HELPERS[@]}"; do
        [ -x "$SHELL_DIR/bin/$helper" ] || return 1
        if [ "$SHELL_DIR/src/$helper.c" -nt "$SHELL_DIR/bin/$helper" ]; then
            return 1
        fi
    done
    return 0
}

ensure_built() {
    if [ "$(readlink "$SHELL_DIR/bin/banditshell" 2>/dev/null)" != ../cli/banditshell ]; then
        mkdir -p "$SHELL_DIR/bin" && ln -sfn ../cli/banditshell "$SHELL_DIR/bin/banditshell" || return 1
    fi
    helpers_current && return 0
    "$SHELL_DIR/bin/banditshell" dev build >/dev/null 2>&1 || "$SHELL_DIR/bin/banditshell" build >/dev/null 2>&1 || return 1
}

pct_of() { awk -v v="$1" 'BEGIN{printf "%d", v * 100 + 0.5}'; }

level_of() {
    local sign="" n="$1"
    case "$n" in
    [+-]*) sign="${n:0:1}" n="${n:1}" ;;
    esac
    case "$n" in
    "") [ -n "$sign" ] && n=10 ;;
    *.*) n=$(pct_of "$n") ;;
    esac
    printf '%s%s' "$sign" "$n"
}

labelled() {
    local out
    out=$(cat)
    [ -n "$out" ] || return 0
    awk -v label="$1" '{ printf "%-11s %s\n", NR == 1 ? label : "", $0 }' <<<"$out"
}

panel_ipc() {
    case "$1" in
    wallpaper) echo wallpapers ;;
    *) echo "$1" ;;
    esac
}

builtin_panel() {
    local surface
    for surface in "${SURFACES[@]}"; do
        [ "$surface" = "$1" ] && return 0
    done
    return 1
}

panel_status_takes_screen() { case "$1" in keyboard | notifications | island | hotkeys) return 0 ;; *) return 1 ;; esac; }

toggle_panel() {
    local name="$1" rest="${2:-}"
    case "$name" in
    launcher | session | clipboard | media | calculator | quickcontrols | settings) ipc "$name" toggle ;;
    keyboard | notifications | island | hotkeys | files) ipc "$name" toggle "$rest" ;;
    wallpaper) ipc wallpapers toggle "$rest" ;;
    *) ipc menu toggle "$name" "$rest" ;;
    esac
}

open_panel() {
    local name="$1"
    shift
    case "$name" in
    launcher) ipc launcher open "$*" ;;
    session | clipboard | media | calculator | quickcontrols) ipc "$name" open ;;
    keyboard | notifications | island | hotkeys | files) ipc "$name" open "${1:-}" ;;
    settings) ipc settings open "${1:-}" "${2:-}" ;;
    wallpaper) ipc wallpapers open "${1:-}" ;;
    *) ipc menu open "$name" "${1:-}" ;;
    esac
}

close_call() {
    case "$1" in
    wallpaper) call=(wallpapers close) ;;
    penmap) call=(penmap cancel) ;;
    launcher | session | clipboard | media | calculator | quickcontrols | keyboard | settings | notifications | island | hotkeys | files | picker) call=("$1" close) ;;
    *) call=(menu close) ;;
    esac
}

close_panel() {
    local -a call
    close_call "$1"
    ipc "${call[@]}"
}

close_everything() {
    local -a call
    local name closed=0
    if ipc_quiet panels closeAll >/dev/null; then
        ipc_quiet files close >/dev/null || true
        ipc_quiet penmap cancel >/dev/null || true
        echo "closed everything"
        return 0
    fi
    for name in menu picker penmap "${SURFACES[@]}"; do
        close_call "$name"
        if ipc_quiet "${call[@]}" >/dev/null; then
            closed=1
        fi
    done
    if [ "$closed" = 0 ]; then
        complain "not running (try: banditshell start)"
        return 3
    fi
    echo "closed everything"
}

status_panel() {
    local current
    if builtin_panel "$1"; then
        if panel_status_takes_screen "$1"; then
            ipc "$(panel_ipc "$1")" status "${2:-}"
        else
            ipc "$(panel_ipc "$1")" status
        fi
        return
    fi
    current=$(ipc menu current) || return 1
    if [ "$current" = "$1" ]; then echo open; else echo closed; fi
}

list_panels() {
    printf '%s\n' "${SURFACES[@]}"
    ipc_quiet menu list || true
}

route_panel() {
    local name="${1:-}" action
    case "$name" in
    "") list_panels; return ;;
    close) [ $# -eq 1 ] || nope panel "close ${2:-}"; close_everything; return ;;
    notch) name=island ;;
    esac
    shift
    action="${1:-status}"
    if [ $# -gt 0 ]; then shift; fi

    case "$name:$action" in
    launcher:run) [ $# -ge 1 ] || say_usage "panel launcher run <app|row>"; ipc launcher run "$1" ;;
    settings:page) [ $# -ge 1 ] || say_usage "panel settings page <page>"; ipc settings page "$1" ;;
    keyboard:dock) ipc keyboard dock ;;
    keyboard:float) ipc keyboard undock ;;
    keyboard:page) [ $# -ge 1 ] || say_usage "panel keyboard page <layer> [screen]"; ipc keyboard page "$1" "${2:-}" ;;
    clipboard:list | clipboard:clear) ipc clipboard "$action" ;;
    clipboard:use | clipboard:pin | clipboard:remove) [ $# -ge 1 ] || say_usage "panel clipboard $action <index>"; ipc clipboard "$action" "$1" ;;
    calculator:full) ipc calculator app ;;
    calculator:compact) ipc calculator panel ;;
    calculator:answer) [ $# -ge 1 ] || say_usage "panel calculator answer <expression>"; ipc calculator answer "$*" ;;
    notifications:clear) ipc notifications clear ;;
    *:toggle) toggle_panel "$name" "${1:-}" ;;
    *:open) open_panel "$name" "$@" ;;
    *:close) close_panel "$name" ;;
    *:status) status_panel "$name" "${1:-}" ;;
    *) nope panel "$name $action" ;;
    esac
}

activity_call() {
    local reply
    reply=$(ipc activity "$@") || return 1
    case "$reply" in
    "refused: "*) echo "banditshell: ${reply#refused: }" >&2; return 1 ;;
    esac
    if [ -n "$reply" ]; then printf '%s\n' "$reply"; fi
}

island_post() {
    local verb="$1" id="" text="" detail="" progress="" icon="" lasts="" priority="" run="" flag
    shift
    if [ "$verb" = update ]; then
        id="${1:-}"
        if [ -z "$id" ] || [[ $id == --* ]]; then
            say_usage "island update <id> [--text <text>] [--detail <text>] [--progress <fraction>] [--icon <name>] [--until <span>]"
        fi
        shift
    fi
    while [ $# -gt 0 ]; do
        flag="$1"
        [ $# -ge 2 ] || say_usage "island $verb: $flag needs a value"
        case "$flag:$verb" in
        --id:push) id="$2" ;;
        --text:*) text="$2" ;;
        --detail:*) detail="$2" ;;
        --progress:*) progress="$2" ;;
        --icon:*) icon="$2" ;;
        --until:*) lasts="$2" ;;
        --priority:push) priority="$2" ;;
        --run:push) run="$2" ;;
        *) nope island "$verb $flag" ;;
        esac
        shift 2
    done
    if [ "$verb" = push ]; then
        if [ -z "$id" ] || [ -z "$text" ]; then
            say_usage "island push --id <id> --text <text> [--detail <text>] [--progress <fraction>] [--icon <name>] [--until <span>]"
        fi
        activity_call push "$id" "$text" "$detail" "$progress" "$icon" "$lasts" "$priority" "$run"
    else
        activity_call update "$id" "$text" "$detail" "$progress" "$icon" "$lasts"
    fi
}

route_notifications() {
    local verb="${1:-}" filter="" app="" word
    if [ $# -gt 0 ]; then shift; fi
    case "$verb" in
    "")
        ipc notifications status "" || return $?
        ipc_quiet quiet status || true
        ;;
    list)
        for word in "$@"; do
            case "$word" in
            unread | held) filter="$word" ;;
            *) app="${app:+$app }$word" ;;
            esac
        done
        ipc notifications list "$filter" "$app"
        ;;
    open) ipc notifications search "$*" ;;
    act) ipc notifications act ;;
    dismiss) ipc notifications dismiss "${1:-front}" ;;
    reply) [ $# -ge 1 ] || say_usage "notifications reply <text>"; ipc notifications reply "$*" ;;
    snooze) ipc notifications snooze "$*" ;;
    mute) [ $# -ge 1 ] || say_usage "notifications mute <app> [hour|day|never]"; ipc notifications mute "$1" "${2:-}" ;;
    unmute) [ $# -ge 1 ] || say_usage "notifications unmute <app>"; ipc notifications unmute "$*" ;;
    clear) ipc notifications clear ;;
    *) nope notifications "$verb" ;;
    esac
}

route_island() {
    local verb="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$verb" in
    "") ipc island status "" ;;
    push | update) island_post "$verb" "$@" ;;
    end)
        [ $# -ge 1 ] || say_usage "island end <id> [done|failed|cancelled]"
        activity_call end "$1" "${2:-done}"
        ;;
    list) activity_call list ;;
    *) nope island "$verb" ;;
    esac
}

route_output() {
    case "${1:-}" in
    "") ipc output status ;;
    speakers | headphones | toggle | list) ipc output "$1" ;;
    assign) [ $# -ge 3 ] || say_usage "output assign speakers|headphones <device>"; ipc output assign "$2" "$3" ;;
    *) nope output "$1" ;;
    esac
}

route_screen() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc screen status | labelled display || return 1
        ipc_quiet border status | labelled border || true
        ipc_quiet sidebar status | labelled sidebar || true
        ipc_quiet stream status | labelled stream || true
        ;;
    brightness)
        if [ -z "${1:-}" ]; then ipc screen status; else ipc screen brightness "$(level_of "$1")"; fi ;;
    temperature)
        if [ -z "${1:-}" ]; then ipc screen status; else ipc screen temperature "$1"; fi ;;
    border)
        case "${1:-}" in
        "") ipc border status ;;
        on | off | toggle) ipc border "$1" ;;
        *) nope screen "border $1" ;;
        esac ;;
    sidebar)
        case "${1:-}" in
        "") ipc sidebar status ;;
        on | off | toggle) ipc sidebar "$1" "${2:-}" ;;
        *) nope screen "sidebar $1" ;;
        esac ;;
    stream)
        case "${1:-}" in
        "") ipc stream status ;;
        on) ipc stream on "${2:-}" ;;
        off) ipc stream off ;;
        *) nope screen "stream $1" ;;
        esac ;;
    *) nope screen "$what" ;;
    esac
}

route_wallpaper() {
    case "${1:-}" in
    "") ipc wallpaper status ;;
    on | off | toggle | palette) ipc wallpaper "$1" ;;
    next | prev | clear) ipc wallpaper "$1" "${2:-}" ;;
    set) [ $# -ge 2 ] || say_usage "wallpaper set <file> [screen|all]"
        ipc wallpaper set "$(absolute_path "$2")" "${3:-}" ;;
    list) ipc wallpaper list "${2:-}" ;;
    *) nope wallpaper "$1" ;;
    esac
}

screenshot_dir() {
    local cfg dir
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
    dir=$(jq -r '.picker.dir // empty' "$cfg" 2>/dev/null || true)
    dir="${dir:-~/Pictures/Screenshots}"
    printf '%s' "${dir/#\~/$HOME}"
}

pick_region() {
    local action="$1" region note dir editor out
    if ipc_quiet picker "$action"; then
        return 0
    fi
    if ! command -v slurp >/dev/null || ! command -v grim >/dev/null; then
        complain "not running, and no grim/slurp to fall back on"
        exit 1
    fi
    complain "not running - falling back to grim/slurp (try: banditshell start)"
    # shellcheck disable=SC2086
    region=$(slurp ${SLURP_ARGS:-}) || exit 0
    if [ -z "$region" ]; then
        exit 0
    fi
    note="banditshell was not running"
    case "$action" in
    freeze*) note="$note; taken live, nothing could be frozen" ;;
    esac
    case "$action" in
    *clip)
        grim -g "$region" - | wl-copy --type image/png
        notice "Screenshot copied" "$note"
        ;;
    *)
        dir=$(screenshot_dir)
        editor=$(jq -r '.picker.editor // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json" 2>/dev/null || true)
        editor="${editor:-swappy -f}"
        mkdir -p "$dir"
        out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
        grim -g "$region" "$out"
        notice "Screenshot saved" "$out ($note)"
        # shellcheck disable=SC2086
        ${editor} "$out" >/dev/null 2>&1 || true
        echo "$out"
        ;;
    esac
}

notice() {
    notify-send -a banditshell "$1" "$2" 2>/dev/null ||
        hyprctl notify -1 5000 "rgb(e5c07b)" "$1 - $2" >/dev/null 2>&1 || true
}

route_screenshot() {
    local mode="${1:-}" freeze=0 arg dir out
    if [ $# -gt 0 ]; then shift; fi
    case "$mode" in
    "") group_help screenshot; return ;;
    full)
        if [ -n "${1:-}" ]; then
            out="$1"
        else
            dir=$(screenshot_dir)
            mkdir -p "$dir"
            out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
        fi
        grim "$out"
        ipc_quiet picker taken "$(realpath -- "$out")" >/dev/null || true
        echo "$out"
        return
        ;;
    save | copy) ;;
    *) nope screenshot "$mode" ;;
    esac
    for arg in "$@"; do
        case "$arg" in
        --freeze) freeze=1 ;;
        *) nope screenshot "$mode $arg" ;;
        esac
    done
    case "$mode:$freeze" in
    save:0) pick_region open ;;
    save:1) pick_region freeze ;;
    copy:0) pick_region clip ;;
    copy:1) pick_region freezeclip ;;
    esac
}

route_timer() {
    case "${1:-}" in
    "") ipc timer status ;;
    start) [ $# -ge 2 ] || say_usage "clock timer start <duration> [label]"; ipc timer start "$2" "${3:-}" ;;
    pause | resume | toggle | cancel) ipc timer "$1" "${2:-}" ;;
    *) nope clock "timer $1" ;;
    esac
}

route_alarm() {
    local action="${1:-}" when days="" label="" mode="" payload=""
    case "$action" in
    "") ipc alarm status ;;
    list | snooze | stop) ipc alarm "$action" ;;
    enable | disable | remove) [ $# -ge 2 ] || say_usage "clock alarm $action <handle>"; ipc alarm "$action" "$2" ;;
    add)
        [ $# -ge 2 ] || say_usage "clock alarm add <time> [--days <days>] [--label <text>] [--run <command>|--ask <message>]"
        when="$2"
        shift 2
        while [ $# -gt 0 ]; do
            [ $# -ge 2 ] || { echo "banditshell: $1 needs a value" >&2; exit 2; }
            case "$1" in
            --days) days="$2" ;;
            --label) label="$2" ;;
            --run) mode="command" payload="$2" ;;
            --ask) mode="cloud" payload="$2" ;;
            *) echo "banditshell: unknown option: $1" >&2; exit 2 ;;
            esac
            shift 2
        done
        ipc alarm add "$when" "$days" "$label" "$mode" "$payload"
        ;;
    *) nope clock "alarm $action" ;;
    esac
}

route_zone() {
    local action="${1:-list}"
    case "$action" in
    list) ipc zone list ;;
    find | add | remove) [ $# -ge 2 ] || say_usage "clock zone $action <place>"; shift; ipc zone "$action" "$*" ;;
    *) nope clock "zone $action" ;;
    esac
}

route_clock() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc timer status | labelled timers || return 1
        ipc_quiet alarm status | labelled alarms || true
        ;;
    timer) route_timer "$@" ;;
    alarm) route_alarm "$@" ;;
    zone) route_zone "$@" ;;
    *) nope clock "$what" ;;
    esac
}

route_mode() {
    case "${1:-}" in
    "") ipc mode status ;;
    list) ipc mode list ;;
    *) ipc mode choose "$1" ;;
    esac
}

route_quiet() {
    case "${1:-}" in
    "") ipc quiet status ;;
    off) ipc quiet off ;;
    on | toggle) ipc quiet "$1" "${2:-}" ;;
    *) nope focus "quiet $1" ;;
    esac
}

route_focus() {
    local what="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    "")
        ipc mode status | labelled mode || return 1
        ipc_quiet quiet status || true
        ;;
    mode) route_mode "$@" ;;
    quiet) route_quiet "$@" ;;
    *) nope focus "$what" ;;
    esac
}

route_tablet() {
    case "${1:-}" in
    "")
        ipc tablet status | labelled tablet || return 1
        ipc_quiet penmap status | labelled pen || true
        ;;
    on | off | toggle) ipc tablet "$1" "${2:-}" ;;
    lid)
        case "${2:-}" in
        "") ipc tablet status ;;
        open | closed | toggle) ipc tablet lid "$2" "${3:-}" ;;
        *) nope tablet "lid $2" ;;
        esac ;;
    probe)
        case "${2:-}" in
        "") python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose ;;
        lid) python3 "$SHELL_DIR/scripts/tablet-state.py" --lid --verbose ;;
        *) nope tablet "probe $2" ;;
        esac ;;
    pen)
        case "${2:-}" in
        "") ipc penmap status ;;
        edit) ipc penmap open ;;
        commit | cancel | aspect | centre | follow) ipc penmap "$2" ;;
        area) [ $# -ge 6 ] || say_usage "tablet pen area <x> <y> <width> <height>"; ipc penmap set "$3" "$4" "$5" "$6" ;;
        *) nope tablet "pen $2" ;;
        esac ;;
    *) nope tablet "$1" ;;
    esac
}

route_config() {
    case "${1:-}" in
    "") group_help config ;;
    get) [ $# -ge 2 ] || say_usage "config get <key>"; ipc shell get "$2" ;;
    set) [ $# -ge 3 ] || say_usage "config set <key> <value>"; ipc shell set "$2" "$3" ;;
    theme)
        case "${2:-}" in
        "") ipc shell get theme ;;
        list) ipc shell themes ;;
        *) ipc shell set theme "\"$2\"" ;;
        esac ;;
    *) nope config "$1" ;;
    esac
}

JSON_AWK='
function jstr(s,   out, i, c, n) {
    out = ""
    n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\\") out = out "\\\\"
        else if (c == "\"") out = out "\\\""
        else if (c == "\t") out = out "\\t"
        else if (c == "\r") out = out "\\r"
        else out = out c
    }
    return "\"" out "\""
}
function jvalue(v) {
    if (v ~ /^-?(0|[1-9][0-9]*)(\.[0-9]+)?$/ || v == "true" || v == "false")
        return v
    return jstr(v)
}
'

JSON_TEXT_AWK="$JSON_AWK"'
function keep(k, v) {
    if (!(k in seen)) {
        seen[k] = 1
        order[++fields] = k
    }
    value[k] = v
}
function list(name, items, count,   i, part) {
    part = "\"" name "\":["
    for (i = 1; i <= count; i++)
        part = part (i > 1 ? "," : "") items[i]
    return part "]"
}
{
    line = $0
    if (line == "")
        next
    if (match(line, /^(ok|warn|fail) +[a-z]+ +/)) {
        split(line, words, " ")
        checks[++nchecks] = "{\"status\":" jstr(words[1]) ",\"name\":" jstr(words[2]) ",\"detail\":" jstr(substr(line, RLENGTH + 1)) "}"
        next
    }
    rest = line
    pairs = 0
    if (match(rest, /^[a-z]+ [A-Za-z_][A-Za-z0-9_.-]*=/)) {
        pairs++
        pendingKey[pairs] = "state"
        pendingVal[pairs] = substr(rest, 1, index(rest, " ") - 1)
        rest = substr(rest, index(rest, " ") + 1)
    }
    while (rest != "" && match(rest, /^[A-Za-z_][A-Za-z0-9_.-]*=("[^"]*"|[^ ]*)/)) {
        token = substr(rest, 1, RLENGTH)
        key = substr(token, 1, index(token, "=") - 1)
        val = substr(token, index(token, "=") + 1)
        if (val ~ /^".*"$/)
            val = substr(val, 2, length(val) - 2)
        pairs++
        pendingKey[pairs] = key
        pendingVal[pairs] = val
        rest = substr(rest, RLENGTH + 1)
        sub(/^ +/, "", rest)
    }
    if (pairs > 0 && rest == "") {
        for (i = 1; i <= pairs; i++)
            keep(pendingKey[i], pendingVal[i])
        next
    }
    if (match(line, /  +/) && RSTART > 1) {
        label = substr(line, 1, RSTART - 1)
        if (label ~ /^[A-Za-z][A-Za-z0-9_. -]*$/ && length(label) <= 24) {
            key = tolower(label)
            gsub(/[ .-]+/, "_", key)
            keep(key, substr(line, RSTART + RLENGTH))
            next
        }
    }
    quoted[++lines] = jstr(line)
}
END {
    out = ""
    for (i = 1; i <= fields; i++)
        out = out (out == "" ? "" : ",") jstr(order[i]) ":" jvalue(value[order[i]])
    if (nchecks > 0)
        out = out (out == "" ? "" : ",") list("checks", checks, nchecks)
    if (lines > 0)
        out = out (out == "" ? "" : ",") list("text", quoted, lines)
    print "{" out "}"
}'

as_json() {
    local out status=0
    out=$(BANDITSHELL_JSON=1 "$(readlink -f "${BASH_SOURCE[0]}")" "$@") || status=$?
    case "$out" in
    "") ;;
    "{"* | "["*) printf '%s\n' "$out" ;;
    open | closed) printf '{"state":"%s"}\n' "$out" ;;
    *) printf '%s\n' "$out" | awk "$JSON_TEXT_AWK" ;;
    esac
    exit "$status"
}

api_table() { printf '%s' "${BANDITSHELL_API_TABLE:-$SHELL_DIR/api/actions.tsv}"; }

api_number() { awk '/^# api [0-9]+/ { print $3; exit }' "$(api_table)" 2>/dev/null; }

module_number() { sed -n 's/^local API = \([0-9][0-9]*\)$/\1/p' "$SHELL_DIR/lua/banditshell.lua" 2>/dev/null | head -n 1 || true; }

valid_id() { [[ $1 =~ ^[a-z0-9_]+(\.[a-z0-9_]+)*$ ]]; }

resolve_action() {
    valid_id "$1" || return 1
    awk -F'\t' -v want="$1" '
        BEGIN { n = split(want, w, ".") }
        /^#/ || NF < 4 { next }
        {
            m = split($1, p, ".")
            if (m != n)
                next
            hits = 0
            split("", cap)
            for (i = 1; i <= m; i++) {
                if (p[i] == "*") {
                    hits++
                    cap[hits] = w[i]
                } else if (p[i] != w[i]) {
                    next
                }
            }
            if (!found || hits < bestHits) {
                found = 1
                bestHits = hits
                out = $4
                for (i = 1; i <= hits; i++)
                    gsub("\\$" i, cap[i], out)
                best = $1 "\t" $2 "\t" out "\t" $3 "\t" $5
            }
        }
        END { if (found) print best }
    ' "$(api_table)" 2>/dev/null
}

count_matching_rows() {
    local table="$1" combo part i mask
    matching=0
    local -a segments
    IFS=. read -ra segments <<<"$2"
    for ((mask = 0; mask < (1 << ${#segments[@]}); mask++)); do
        combo=""
        for ((i = 0; i < ${#segments[@]}; i++)); do
            part="${segments[i]}"
            if ((mask & (1 << i))); then part="*"; fi
            combo="${combo:+$combo.}$part"
        done
        if [[ $table == *$'\n'"$combo"$'\t'* ]]; then matching=$((matching + 1)); fi
    done
}

hinted_action() {
    local id="$1" table="" pattern status since argv i capture="" matching=0
    local -a want have
    IFS=$'\t' read -r pattern status since argv <<<"$BANDITSHELL_ROW" || return 1
    case "$status" in deprecated=* | removed* | "") return 1 ;; esac
    valid_id "$id" && [ -n "$argv" ] && [ "${pattern//[^.]/}" = "${id//[^.]/}" ] || return 1
    # shellcheck disable=SC2053
    [[ $id == $pattern ]] || return 1
    IFS= read -r -d '' table <"${BANDITSHELL_API_TABLE:-$SHELL_DIR/api/actions.tsv}" || true
    table=$'\n'$table
    [[ $table == *$'\n'"$BANDITSHELL_ROW"$'\t'* || $table == *$'\n'"$BANDITSHELL_ROW"$'\n'* ]] || return 1
    count_matching_rows "$table" "$id"
    [ "$matching" = 1 ] || return 1
    if [ "$pattern" != "$id" ]; then
        IFS=. read -ra want <<<"$id"
        IFS=. read -ra have <<<"$pattern"
        for ((i = 0; i < ${#want[@]}; i++)); do
            if [ "${have[i]}" = "*" ] && [ -z "$capture" ]; then
                capture="${want[i]}"
            fi
        done
        argv="${argv//\$1/$capture}"
    fi
    read -ra hinted <<<"$argv"
}

tell_once() {
    local id="$1" status="$2" mark message
    mark="$RUN_DIR/told-$id"
    [ ! -e "$mark" ] || return 0
    if mkdir -p "$RUN_DIR" 2>/dev/null; then : >"$mark" 2>/dev/null || true; fi
    case "$status" in
    deprecated=*) message="the action $id is deprecated, use ${status#deprecated=}; it still works" ;;
    removed=*) message="the action $id is gone, it now runs ${status#removed=}" ;;
    *) message="the action $id is gone" ;;
    esac
    echo "banditshell: $message" >&2
    if running; then
        notify-send -a banditshell "banditshell" "$message" 2>/dev/null || true
    else
        hyprctl notify -1 6000 "rgb(e5c07b)" "banditshell: $message" >/dev/null 2>&1 || true
    fi
}

route_action() {
    local id="${1:-}" row matched status argv since about
    local -a words
    [ -n "$id" ] || say_usage "action <id> [args...]"
    shift
    row=$(resolve_action "$id") || row=""
    if [ -z "$row" ]; then
        complain "no action called $id (banditshell api list shows them)"
        exit 2
    fi
    IFS=$'\t' read -r matched status argv since about <<<"$row"
    case "$status" in
    deprecated=* | removed*) tell_once "$id" "$status" ;;
    esac
    read -ra words <<<"$argv"
    exec "$(readlink -f "${BASH_SOURCE[0]}")" "${words[@]}" "$@"
}

api_rows() {
    local pattern="${1:-*}" id rest
    while IFS=$'\t' read -r id rest; do
        case "$id" in
        "" | "#"*) continue ;;
        esac
        # shellcheck disable=SC2254
        case "$id" in
        $pattern) printf '%s\t%s\n' "$id" "$rest" ;;
        esac
    done <"$(api_table)"
}

api_list() {
    local rows
    [ -r "$(api_table)" ] || { echo "banditshell: no action table at $(api_table)" >&2; return 1; }
    rows=$(api_rows "${1:-*}")
    [ -n "$rows" ] || { echo "banditshell: no action matches ${1:-*}" >&2; return 1; }
    if [ -n "${BANDITSHELL_JSON:-}" ]; then
        printf '%s\n' "$rows" | awk -F'\t' "$JSON_AWK"'
            BEGIN { printf "[" }
            {
                printf "%s{\"id\":%s,\"status\":%s,\"since\":%s,\"argv\":%s,\"description\":%s}", (NR > 1 ? "," : ""), jstr($1), jstr($2), jvalue($3), jstr($4), jstr($5)
            }
            END { print "]" }
        '
        return 0
    fi
    printf '%s\n' "$rows" | awk -F'\t' '
        { id[NR] = $1; status[NR] = $2; about[NR] = $5; if (length($1) > width) width = length($1) }
        END { for (i = 1; i <= NR; i++) printf "%-" width "s  %-16s %s\n", id[i], status[i], about[i] }
    '
}

api_show() {
    local row matched status argv since about
    row=$(resolve_action "$1") || row=""
    if [ -z "$row" ]; then
        echo "banditshell: no action called $1 (banditshell api list shows them)" >&2
        return 2
    fi
    IFS=$'\t' read -r matched status argv since about <<<"$row"
    printf '%-11s %s\n' id "$1"
    [ "$matched" = "$1" ] || printf '%-11s %s\n' pattern "$matched"
    printf '%-11s %s\n' status "$status" since "$since" runs "banditshell $argv" about "$about"
}

report() { printf '%-5s %-8s %s\n' "$1" "$2" "$3"; }

command_table() {
    local committed="$SHELL_DIR/cli/commands.tsv"
    if [ -r "$committed" ] && [ ! "$SHELL_DIR/cli/banditshell" -nt "$committed" ]; then
        cat "$committed"
    else
        "$SHELL_DIR/scripts/completion-rules.sh" "$SHELL_DIR/cli/banditshell"
    fi
}

api_check() {
    local table rules_file failed=0 version module count problems line
    table=$(api_table)
    if [ ! -r "$table" ]; then
        report fail table "no action table at $table"
        return 1
    fi
    version=$(api_number)
    module=$(module_number)
    if [ -z "$version" ]; then
        report fail table "$table has no '# api N' first line"
        failed=1
    elif [ -n "$module" ] && [ "$module" != "$version" ]; then
        report fail table "the table says api $version, lua/banditshell.lua says api $module"
        failed=1
    fi
    rules_file=$(mktemp)
    command_table 2>/dev/null | awk -F'\t' '$1 == "rule" { print $2 }' >"$rules_file" || true
    problems=$(awk -F'\t' '
        function reachable(argv,   words, n, i, j, k, parts, alternatives, ok, last, flags, hit, positions, w) {
            n = split(argv, words, " ")
            for (r = 1; r <= nrules; r++) {
                k = split(rule[r], parts, " ")
                flags = ""
                if (k > 1 && parts[k] ~ /^--/) {
                    flags = "," parts[k] ","
                    k--
                }
                positions = 0
                ok = 1
                for (i = 1; i <= n; i++) {
                    w = words[i]
                    if (w ~ /^--/) {
                        if (index(flags, "," w ",") == 0)
                            ok = 0
                        continue
                    }
                    positions++
                    if (positions > k) {
                        ok = 0
                        break
                    }
                    split(parts[positions], alternatives, ",")
                    hit = 0
                    for (j in alternatives)
                        if (alternatives[j] == w || alternatives[j] == "*" || alternatives[j] ~ /^@/)
                            hit = 1
                    if (!hit)
                        ok = 0
                }
                if (ok)
                    return 1
            }
            return 0
        }
        FNR == NR { rule[++nrules] = $0; next }
        /^#/ || $0 == "" { next }
        {
            rows++
            if (NF < 5) { print $1 ": needs five tab separated columns"; next }
            if ($1 !~ /^[a-z0-9_*]+(\.[a-z0-9_*]+)*$/) print $1 ": not a valid id"
            if (seen[$1]++) print $1 ": listed twice"
            if ($2 !~ /^(stable|deprecated=[a-z0-9_.*]+|removed=[a-z0-9_.*]+)$/) print $1 ": bad status " $2
            if ($3 !~ /^[0-9]+$/) print $1 ": bad since " $3
            argv = $4
            gsub(/\$[1-9]/, "x", argv)
            if (!reachable(argv)) print $1 ": " argv " is not a command this CLI has"
        }
        END { if (rows == 0) print "the table has no rows" }
    ' "$rules_file" "$table")
    rm -f "$rules_file"
    count=$(awk -F'\t' '!/^#/ && NF >= 4 { n++ } END { print n + 0 }' "$table")
    if [ -n "$problems" ]; then
        while IFS= read -r line; do
            report fail action "$line"
        done <<<"$problems"
        failed=1
    fi
    [ "$failed" = 0 ] && report ok actions "$count ids, api ${version:-?}, each one a command this CLI has"
    return "$failed"
}

route_api() {
    local what="${1:-list}"
    if [ $# -gt 0 ]; then shift; fi
    case "$what" in
    list) api_list "${1:-*}" ;;
    show)
        [ $# -ge 1 ] || say_usage "api show <id>"
        api_show "$1"
        ;;
    check) api_check ;;
    *) nope api "$what" ;;
    esac
}

route_version() {
    local release commit branch quickshell hyprland number channel follows
    release=$(U_DIR="$SHELL_DIR" && update_label "$(ugit rev-parse --verify --quiet HEAD)") || release=""
    [ -n "$release" ] || release=$(grep -m1 -o '"id": *"[^"]*"' "$SHELL_DIR/docs/whats-new.json" 2>/dev/null | sed 's/.*: *"\(.*\)"/\1/') || release=""
    commit=$(git -C "$SHELL_DIR" describe --always --dirty --tags 2>/dev/null) || commit=""
    branch=$(git -C "$SHELL_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
    quickshell=$(qs --version 2>/dev/null | head -n 1 | sed 's/ (revision.*//') || quickshell=""
    hyprland=$(Hyprland --version 2>/dev/null | head -n 1 | sed 's/ built from.*//') || hyprland=""
    number=$(api_number) || number=""
    channel=$(config_channel)
    follows=$(update_branch_for "$channel" "$(config_leaf updates branch main)")
    printf '%-11s %s\n' version "${release:-unknown}" channel "$channel" follows "$follows" commit "${commit:-unknown}" branch "${branch:-unknown}" \
        checkout "$SHELL_DIR" api "${number:-none}" quickshell "${quickshell:-unknown}" hyprland "${hyprland:-unknown}"
}

shim_format() { sed -n '1s/^-- banditshell shim, format \([0-9][0-9]*\)\..*/\1/p' "$1" 2>/dev/null; }

write_atomic() {
    local tmp
    tmp=$(mktemp "$(dirname "$2")/.banditshell.XXXXXX") || return 1
    if cat "$1" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$2"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

lua_notes=()

point_at() {
    local root="$1" tmp
    [ "$root" != "$BACKUP" ] || return 0
    [ "$(head -n 1 "$STATE_DIR/root" 2>/dev/null)" != "$root" ] || return 0
    mkdir -p "$STATE_DIR" || return 1
    tmp=$(mktemp "$STATE_DIR/.root.XXXXXX") || return 1
    if printf '%s\n' "$root" >"$tmp" && mv -f "$tmp" "$STATE_DIR/root"; then
        lua_notes+=("pointer now $root")
        return 0
    fi
    rm -f "$tmp"
    return 1
}

install_shim() {
    local source="$SHELL_DIR/api/shim.lua" target="$HYPR_DIR/$SHIM_NAME" have want
    [ -f "$source" ] || return 1
    [ -d "$HYPR_DIR" ] || return 0
    want=$(shim_format "$source")
    [ -n "$want" ] || return 1
    if [ -L "$target" ]; then
        return 0
    elif [ -e "$target" ]; then
        have=$(shim_format "$target")
        [ -n "$have" ] || return 0
        [ "$have" -lt "$want" ] || return 0
    fi
    write_atomic "$source" "$target" || return 1
    lua_notes+=("shim written to $target")
}

ensure_lua() {
    lua_notes=()
    point_at "$SHELL_DIR" || return 1
    install_shim
}

scan_binds() {
    local file legacy=0 count token id row status entry
    local -a files=() unknown=() retired=() bare=()
    local -A firsts=()
    [ -d "$HYPR_DIR" ] || return 0
    while IFS= read -r file; do files+=("$file"); done < <(find -L "$HYPR_DIR" -maxdepth 3 -type f \( -name '*.lua' -o -name '*.conf' \) ! -name "$SHIM_NAME" 2>/dev/null | sort)
    while IFS= read -r id; do firsts[${id%%.*}]=1; done < <(api_rows | cut -f1)
    for file in "${files[@]}"; do
        count=$(grep -hE '(exec_cmd|exec[ ,]).*banditshell +[a-z]' "$file" 2>/dev/null | grep -cvE '^[[:space:]]*(--|#)') || count=0
        legacy=$((legacy + count))
        if grep -qE 'require *\(? *["'\'']banditshell["'\'']' "$file" 2>/dev/null; then
            while IFS= read -r token; do
                id="${token#bs.}"
                case "$id" in
                api | action | bind | describe | has | need | cli | root | run) continue ;;
                esac
                row=$(resolve_action "$id") || row=""
                if [ -z "$row" ]; then
                    unknown+=("$token")
                    continue
                fi
                IFS=$'\t' read -r _ status _ <<<"$row"
                case "$status" in
                deprecated=* | removed*) retired+=("$token") ;;
                esac
            done < <(grep -ohE '\bbs\.[a-z_][a-z0-9_.]*' "$file" | sed 's/\.*$//' | sort -u)
        else
            for entry in "${!firsts[@]}"; do
                if grep -qE "\\bbs\\.$entry\\b" "$file" 2>/dev/null; then
                    bare+=("$file")
                    break
                fi
            done
        fi
    done
    if [ "$legacy" -gt 0 ]; then
        report warn binds "$legacy bind(s) still call banditshell by its command line; they work, but ids survive updates (banditshell doctor binds)"
    fi
    if [ "${#unknown[@]}" -gt 0 ]; then
        report warn binds "not in the action table: ${unknown[*]}"
    fi
    if [ "${#retired[@]}" -gt 0 ]; then
        report warn binds "deprecated or removed: ${retired[*]}"
    fi
    if [ "${#bare[@]}" -gt 0 ]; then
        report warn binds "uses bs. without require(\"banditshell\"): ${bare[*]}"
    fi
    if [ "$legacy" -eq 0 ] && [ "${#unknown[@]}" -eq 0 ] && [ "${#retired[@]}" -eq 0 ] && [ "${#bare[@]}" -eq 0 ]; then
        report ok binds "${#files[@]} file(s) read, nothing to change"
    fi
}

doctor_api() {
    local failed=0 note target source pointed here found
    local -a missing=()
    target="$HYPR_DIR/$SHIM_NAME"
    source="$SHELL_DIR/api/shim.lua"
    if ensure_lua; then
        for note in "${lua_notes[@]}"; do
            report ok fixed "$note"
        done
    else
        report fail setup "could not write the pointer or the shim (state $STATE_DIR, config $HYPR_DIR)"
        failed=1
    fi

    if [ ! -d "$HYPR_DIR" ]; then
        report warn shim "no Hyprland config at $HYPR_DIR, so no shim (set HYPR_DIR if it lives elsewhere)"
    elif [ -L "$target" ] || { [ -e "$target" ] && [ -z "$(shim_format "$target")" ]; }; then
        report fail shim "$target is not banditshell's, so require(\"banditshell\") loads that instead; move it aside and run: banditshell doctor api"
        failed=1
    elif [ ! -e "$target" ]; then
        report fail shim "missing: $target"
        failed=1
    elif cmp -s "$source" "$target"; then
        report ok shim "$target"
    else
        report ok shim "$target (format $(shim_format "$target"), the checkout has $(shim_format "$source"))"
    fi

    pointed=$(head -n 1 "$STATE_DIR/root" 2>/dev/null) || pointed=""
    if [ -z "$pointed" ] && [ "$SHELL_DIR" = "$BACKUP" ]; then
        report warn pointer "running from the last good copy; no pointer to check"
    elif [ -z "$pointed" ]; then
        report fail pointer "no pointer at $STATE_DIR/root"
        failed=1
    else
        for found in cli/banditshell lua/banditshell.lua api/actions.tsv; do
            [ -e "$pointed/$found" ] || missing+=("$found")
        done
        if [ "${#missing[@]}" -gt 0 ]; then
            report fail pointer "$pointed has no ${missing[*]}"
            failed=1
        elif [ "$pointed" = "$SHELL_DIR" ]; then
            report ok pointer "$pointed"
        else
            report ok pointer "$pointed (this CLI is $SHELL_DIR)"
        fi
    fi

    api_check || failed=1
    scan_binds

    here=$(readlink -f "$SHELL_DIR/cli/banditshell")
    found=$(command -v banditshell 2>/dev/null) || found=""
    if [ -z "$found" ]; then
        report warn path "banditshell is not on your PATH; run: ln -s $here ~/.local/bin/banditshell"
    elif [ "$(readlink -f "$found")" != "$here" ]; then
        report warn path "banditshell on your PATH is $found, not this checkout ($here)"
    else
        report ok path "$found"
    fi
    return "$failed"
}

redact_config() {
    local out=""
    if [ ! -r "$CONFIG_FILE" ]; then
        echo "no config file"
        return 0
    fi
    if command -v node >/dev/null 2>&1 && [ -f "$SHELL_DIR/scripts/redact-config.js" ]; then
        out=$(node "$SHELL_DIR/scripts/redact-config.js" "$CONFIG_FILE" 2>/dev/null) || out=""
    fi
    if [ -n "$out" ]; then
        printf '%s\n' "$out"
    else
        echo "(the config is left out: taking the secrets out of it safely needs node)"
    fi
}

mask_log() {
    local q="'" home_escaped
    local -a home_rule=()
    if [ -n "${HOME:-}" ] && [ "${HOME%/}" != "" ]; then
        home_escaped=$(printf '%s' "${HOME%/}" | sed 's/[][\\.*^$#+?(){}|]/\\&/g')
        home_rule=(-e "s#${home_escaped}(/|[^[:alnum:]_.-]|\$)#~\\1#g")
    fi
    sed -E \
        ${home_rule[@]+"${home_rule[@]}"} \
        -e 's#(://)[^/@[:space:]]+@#\1[removed]@#g' \
        -e "s#(authorization[\"$q]?[=: ]+[\"$q]?)((Basic|Bearer|Digest|Token)[[:space:]]+)?[^[:space:]\"$q]+#\\1[removed]#Ig" \
        -e 's#(Bearer[[:space:]]+)[A-Za-z0-9._~+/=-]+#\1[removed]#Ig' \
        -e 's#(gh[pousr]_|github_pat_)[A-Za-z0-9_]+#[removed]#g' \
        -e 's#sk-ant-[A-Za-z0-9_-]+#[removed]#g' \
        -e 's#(^|[^[:alnum:]_])sk-[A-Za-z0-9_-]{6,}#\1[removed]#g' \
        -e "s#(cookie[\"$q]?[=:][[:space:]]*).*#\\1[removed]#I" \
        -e "s#([A-Za-z0-9_-]*(token|secret|password|passwd|cookie|api[_-]?key|private[_-]?key)([_-][A-Za-z0-9_-]*|key)?[\"$q]?[=: ]+)(\"[^\"]*\"|${q}[^$q]*$q|[^[:space:]\"$q]+)#\\1[removed]#Ig"
}

strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

check_summary() {
    local name="$1" script="$2" last
    if ! command -v node >/dev/null 2>&1 || [ ! -f "$SHELL_DIR/scripts/$script" ]; then
        echo "$name: not run (node or the script is missing)"
        return 0
    fi
    last=$(cd "$SHELL_DIR" && node "scripts/$script" 2>&1 | tail -n 1) || true
    echo "$name: ${last:-no answer}"
}

report_sections() {
    echo "## version"
    route_version
    echo
    echo "## config (tokens, keys, passwords and cookies left out)"
    redact_config
    echo
    echo "## log (last 40 lines)"
    qs -p "$(live_dir || echo "$SHELL_DIR")" log 2>/dev/null | tail -n 40 | strip_ansi || true
    echo
    echo "## checks"
    check_summary modules check-modules.js
    check_summary rules lint-rules.js
}

doctor_report() { report_sections | mask_log; }

TRIAGE_REPO="" TRIAGE_TITLE="" TRIAGE_BODY=""

triage_repo() {
    local given="${BANDITSHELL_TRIAGE_REPO:-}" remote url=""
    if [ -n "$given" ]; then
        url="$given"
    else
        remote=$(config_leaf updates remote origin)
        url=$(git -C "$SHELL_DIR" remote get-url "$remote" 2>/dev/null) ||
            url=$(git -C "$SHELL_DIR" remote get-url origin 2>/dev/null) || url=""
        case "$url" in
        git@github.com:*) url=${url#git@github.com:} ;;
        ssh://git@github.com/*) url=${url#ssh://git@github.com/} ;;
        https://github.com/*) url=${url#https://github.com/} ;;
        *) url="" ;;
        esac
        url=${url%/}
        url=${url%.git}
        url=${url%/}
    fi
    [[ $url =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || url=""
    printf '%s\n' "$url"
}

triage_title() {
    local words title
    words=$(printf '%s' "$1" | tr '\n\r' '  ' | mask_log)
    words=${words#"${words%%[![:space:]]*}"}
    words=${words%"${words##*[![:space:]]}"}
    title="triage: ${words:-a problem report}"
    [ ${#title} -le 120 ] || title="${title:0:117}..."
    printf '%s\n' "$title"
}

triage_body() {
    local words="$1" owner="$2" text
    text=$({
        echo "## what happened"
        if [ -n "$words" ]; then
            printf '%s\n' "$words"
        else
            echo "(no words were given)"
        fi
        echo
        report_sections
    } 2>/dev/null | mask_log) || true
    if [ ${#text} -gt 60000 ]; then
        text="${text:0:60000}"$'\n\n'"(the report was cut here, it was too long)"
    fi
    printf '%s\n' "$text"
    if [ -n "$owner" ]; then
        printf '\ncc @%s\n' "$owner"
    fi
}

triage_save() {
    local file command
    file="$STATE_DIR/triage/$(date +%Y%m%d-%H%M%S)-$$.md"
    if ! (umask 077 && mkdir -p "$STATE_DIR/triage" && printf '%s\n' "$TRIAGE_BODY" >"$file") 2>/dev/null; then
        complain "could not save the report under $STATE_DIR/triage"
        return 1
    fi
    echo "not sent. the report is saved at $file"
    command="gh issue create --repo $(printf '%q' "${TRIAGE_REPO:-OWNER/REPO}") --title $(printf '%q' "$TRIAGE_TITLE") --body-file $(printf '%q' "$file")"
    echo "send it with: $command"
}

triage_keep() {
    echo "$1"
    triage_save || true
    exit 1
}

triage_show() {
    local view="title: $TRIAGE_TITLE"$'\n\n'"$TRIAGE_BODY"
    local -a pager=()
    if [ -t 1 ]; then
        read -ra pager <<<"${PAGER:-less}"
        if [ ${#pager[@]} -gt 0 ] && command -v "${pager[0]}" >/dev/null 2>&1 && "${pager[@]}" <<<"$view"; then
            return 0
        fi
    fi
    printf '%s\n' "$view"
}

triage_send() {
    local out status=0 url
    out=$(timeout --foreground 30 gh issue create --repo "$TRIAGE_REPO" --title "$TRIAGE_TITLE" --body-file - <<<"$TRIAGE_BODY" 2>&1) || status=$?
    url=$(printf '%s\n' "$out" | grep -oE 'https://[^[:space:]]+' | tail -n 1) || url=""
    if [ "$status" = 0 ] && [ -n "$url" ]; then
        echo "sent: $url"
        return 0
    fi
    printf '%s\n' "$out" | tail -n 3 | mask_log >&2
    if [ "$status" = 0 ] || [ "$status" = 124 ]; then
        triage_keep "gh gave no answer in time, so the issue may already exist; look at https://github.com/$TRIAGE_REPO/issues before sending this again"
    fi
    triage_keep "gh could not create the issue"
}

triage() {
    local assume_yes=0 arg answer words given="${BANDITSHELL_TRIAGE_REPO:-}"
    local -a given_words=()
    for arg in "$@"; do
        if [ "$arg" = --yes ]; then
            assume_yes=1
        else
            given_words+=("$arg")
        fi
    done
    words="${given_words[*]:-}"
    TRIAGE_REPO=$(triage_repo)
    TRIAGE_TITLE=$(triage_title "$words")
    TRIAGE_BODY=$(triage_body "$words" "${TRIAGE_REPO%%/*}")

    if [ -z "$TRIAGE_REPO" ] && [ -n "$given" ]; then
        triage_keep "BANDITSHELL_TRIAGE_REPO is not in owner/repo form: $(printf '%s' "$given" | mask_log)"
    elif [ -z "$TRIAGE_REPO" ]; then
        triage_keep "this checkout has no github remote, and BANDITSHELL_TRIAGE_REPO is not set"
    fi
    command -v gh >/dev/null 2>&1 || triage_keep "gh (github-cli) is not installed"
    timeout --foreground 10 gh auth status --hostname github.com >/dev/null 2>&1 ||
        triage_keep "gh is not logged in to github.com (run: gh auth login)"
    if [ "$assume_yes" = 0 ]; then
        [ -t 0 ] || triage_keep "there is no terminal to ask on, so nothing was sent (--yes sends without asking)"
        triage_show
        printf 'send this to github.com/%s? [y/N] ' "$TRIAGE_REPO"
        read -r answer || answer=""
        case "$answer" in
        y | Y | yes | YES | Yes) ;;
        *)
            echo "not sent"
            exit 1
            ;;
        esac
    fi
    triage_send
}

doctor() {
    local failed binds status=0
    if ensure_built; then
        echo "bin/ current, helpers in place"
    else
        complain "bin/ not rebuilt (run: bash $SHELL_DIR/install.sh)"
    fi
    mkdir -p "$HOME/bin"
    if [ -e "$HOME/bin/banditshell" ] && [ ! -L "$HOME/bin/banditshell" ]; then
        echo "kept your own ~/bin/banditshell"
    elif [ ! -e "$HOME/bin/banditshell" ] || [ "$(readlink -f "$HOME/bin/banditshell")" != "$(readlink -f "$SHELL_DIR/bin/banditshell")" ]; then
        ln -sfn "$SHELL_DIR/bin/banditshell" "$HOME/bin/banditshell"
        echo "exec symlink restored: ~/bin/banditshell"
    fi
    if command -v qs >/dev/null 2>&1; then
        echo "quickshell $(qs --version 2>/dev/null | head -1)"
    else
        complain "quickshell missing (run: bash $SHELL_DIR/install.sh)"
    fi
    if command -v dkms >/dev/null 2>&1 && dkms status 2>/dev/null | grep -q . && ! dkms status 2>/dev/null | grep -q "$(uname -r)"; then
        complain "no dkms module built for the running kernel $(uname -r); a reboot may come up without graphics (update again, or boot the older kernel)"
    fi
    failed=$(systemctl --failed --no-pager 2>/dev/null | sed -n 's/^\(.*\.service\).*/\1/p' | tr '\n' ' ' || true)
    if [ -n "$failed" ]; then
        echo "failed units (machine state, not the shell): $failed"
    fi
    if running; then
        echo "the shell itself: running"
        binds=$(ipc_quiet migration status || true)
        case "$binds" in
        "" | "all binds"* | "not scanned"*) ;;
        *) echo "binds: $binds (rewrite them: banditshell doctor binds rewrite)" ;;
        esac
    else
        echo "the shell itself: not running (try: banditshell start)"
    fi
    doctor_api || status=1
    return "$status"
}

build_helpers() {
    local cc="${CC:-}"
    local -a cflags ldflags wayland
    [ -n "$cc" ] || for cc in cc gcc clang; do command -v "$cc" >/dev/null && break; done
    command -v "$cc" >/dev/null || { echo "banditshell: no C compiler (set \$CC, or install gcc)" >&2; exit 1; }
    read -ra cflags <<<"-O2 -Wall -Wextra -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -fstack-protector-strong -fstack-clash-protection -fPIE ${CFLAGS:-}"
    read -ra ldflags <<<"-pie -Wl,-z,relro,-z,now ${LDFLAGS:-}"
    read -ra wayland <<<"$(pkg-config --cflags --libs wayland-client 2>/dev/null || echo -lwayland-client)"
    mkdir -p "$SHELL_DIR/bin"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-pty" "$SHELL_DIR/src/bs-pty.c" "${ldflags[@]}" -lutil
    echo "src/bs-pty.c -> bin/bs-pty"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-ls" "$SHELL_DIR/src/bs-ls.c" "${ldflags[@]}"
    echo "src/bs-ls.c -> bin/bs-ls"
    "$cc" "${cflags[@]}" -o "$SHELL_DIR/bin/bs-gamma" "$SHELL_DIR/src/bs-gamma.c" "$SHELL_DIR/src/gamma-client-protocol.c" "${ldflags[@]}" "${wayland[@]}" -lm
    echo "src/bs-gamma.c -> bin/bs-gamma"
}

build_shaders() {
    local qsb="${QSB:-$("$SHELL_DIR/scripts/find-qt.sh" tool qsb)}" f
    [ -x "$qsb" ] || { echo "banditshell: qsb not found (install Qt 6 shader tools, or set \$QSB)" >&2; exit 1; }
    while IFS= read -r f; do
        "$qsb" --glsl "100es,120,150" --hlsl 50 --msl 12 -o "$f.qsb" "$f"
        echo "${f#"$SHELL_DIR/"} -> ${f#"$SHELL_DIR/"}.qsb"
    done < <(find "$SHELL_DIR/components" -name '*.frag' | sort)
}

check_everything() {
    local status=0
    "$SHELL_DIR/scripts/qml-compile-check.sh" "$SHELL_DIR" || status=1
    if command -v node >/dev/null; then
        (cd "$SHELL_DIR" && node --test tests/*.test.js) || status=1
    else
        echo "banditshell: node not found" >&2
        status=1
    fi
    exit "$status"
}

go_back() {
    stop_shell || true
    SHELL_DIR=$(main_dir)
    start_checkout "back on $(branch_of "$SHELL_DIR")"
}

switch_to() {
    if [ "$1" = "$(live_dir || true)" ]; then
        echo "${yellow}already on $(branch_of "$1")$plain$dim - banditshell restart reloads it$plain"
        return 1
    fi
    if [ "$1" = "$(main_dir)" ]; then
        go_back
    else
        try_worktree "$1"
    fi
}

try_command() {
    local target answer
    if [ -n "${1:-}" ]; then
        target=$(match_worktree "$1") || {
            echo "${red}banditshell: no single worktree matches $1$plain" >&2
            list_worktrees >&2
            exit 2
        }
        switch_to "$target" || true
        exit 0
    fi
    tidy_worktrees
    if target=$(pick_worktree); then
        switch_to "$target"
        exit 0
    fi
    list_worktrees
    [ -t 0 ] && [ -t 1 ] && [ -n "$(other_worktrees)" ] || exit 0
    while read -rp "try which? " answer && [ -n "$answer" ]; do
        if ! target=$(match_worktree "$answer"); then
            echo "${red}no single worktree matches $answer$plain"
        elif switch_to "$target"; then
            exit 0
        fi
    done
}

preview_pid=""
preview_log=""

start_preview() {
    local name="$1" limit="$2"
    shift 2
    [ -f "$SHELL_DIR/previews/$name.qml" ] || { echo "banditshell: no preview named $name" >&2; exit 1; }
    mkdir -p "$SHOT_DIR"
    preview_log="$SHOT_DIR/$name.log"
    local -a command=(env "BANDITSHELL_PREVIEW=$name" "$@" qs -p "$SHELL_DIR/preview.qml")
    if [ "$limit" -gt 0 ]; then
        command=(timeout "$limit" "${command[@]}")
    fi
    (cd "$HOME" && exec "${command[@]}") >"$preview_log" 2>&1 &
    preview_pid=$!
}

preview_failed() {
    if kill -0 "$preview_pid" 2>/dev/null && ! grep -q "@previews/$1\.qml\[" "$preview_log"; then
        return 1
    fi
    kill "$preview_pid" 2>/dev/null || true
    echo "banditshell: the $1 preview did not come up (log: $preview_log)" >&2
    sed 's/\x1b\[[0-9;]*m//g' "$preview_log" | grep -E 'ERROR|@previews/' >&2 || true
    return 0
}

compositor_look() {
    local r p g b
    r=$(hyprctl getoption decoration:rounding -j 2>/dev/null | jq -r '.int // empty' 2>/dev/null) || r=""
    if [ -z "$r" ]; then
        echo "."
        return
    fi
    p=$(hyprctl getoption decoration:rounding_power -j | jq -r '.float // 2')
    g=$(hyprctl getoption general:gaps_out -j | jq -r '.css // .custom // .int' | awk '{print $1}')
    b=$(hyprctl getoption general:border_size -j | jq -r '.int // 0')
    echo ".compositor.follow = false | .rounding.base = $r | .rounding.power = $p | .edge.border = ${g:-0} | .edge.outerExtra = ((.edge.outerExtra // 0) + $b)"
}

headless_preview() {
    local name="$1" shots="$2" limit="$3" overrides="${4:-.}" work config tool
    for tool in gamescope dbus-run-session jq; do
        command -v "$tool" >/dev/null || { echo "banditshell: $tool not found" >&2; exit 1; }
    done
    [ -f "$SHELL_DIR/previews/$name.qml" ] || { echo "banditshell: no preview named $name" >&2; exit 1; }
    mkdir -p "$shots"
    work=$(mktemp -d)
    mkdir -p "$work/home" "$work/config/banditshell" "$work/state" "$work/cache" "$work/runtime"
    chmod 700 "$work/runtime"
    config="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
    overrides="$overrides | $(compositor_look)"
    jq "$overrides" "$config" >"$work/config/banditshell/config.json" 2>/dev/null ||
        jq -n "{} | $overrides" >"$work/config/banditshell/config.json"
    cat >"$work/bus.conf" <<EOF
<busconfig>
  <type>session</type>
  <listen>unix:dir=$work/runtime</listen>
  <policy context="default">
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
    preview_log="$shots/$name.log"
    : >"$preview_log"
    (cd "$work/home" && exec env -i PATH="$PATH" HOME="$work/home" LANG=C.UTF-8 \
        XDG_CONFIG_HOME="$work/config" XDG_STATE_HOME="$work/state" XDG_CACHE_HOME="$work/cache" XDG_RUNTIME_DIR="$work/runtime" \
        BANDITSHELL_PREVIEW="$name" BANDITSHELL_SHOTS="$shots" \
        timeout -s KILL "$limit" dbus-run-session --config-file="$work/bus.conf" -- \
        gamescope --backend headless -W 1400 -H 900 --expose-wayland -- \
        env QT_QPA_PLATFORM=wayland qs -p "$SHELL_DIR/preview.qml") </dev/null >"$preview_log" 2>&1 &
    preview_pid=$!
    trap 'kill -KILL -- -"$preview_pid" "$preview_pid" 2>/dev/null || true; wait "$preview_pid" 2>/dev/null || true; rm -rf "$work"; echo "stopped" >&2; exit 130' INT TERM
    tail -n +1 -f --pid="$preview_pid" "$preview_log" | sed -u 's/\x1b\[[0-9;]*m//g' |
        grep --line-buffered -oE '(PASS|FAIL) [0-9]+\. .*|(ERROR|WARN).*@(modules|previews|components|services)/.*' || true
    wait "$preview_pid" 2>/dev/null || true
    trap - INT TERM
    rm -rf "$work" 2>/dev/null || echo "banditshell: could not clear $work" >&2
}

check_island() {
    local out tally
    out=$(absolute_path "${1:-$SHOT_DIR/island}")
    echo "walking the island through its situations, about six minutes; ctrl-c stops"
    headless_preview IslandPreview "$out" 480 '.notifications.placement = "island" | .packages.interval = 0 | .sidebar.update = "never"'
    tally=$(sed 's/\x1b\[[0-9;]*m//g' "$preview_log" | grep -oE 'DONE [0-9]+/[0-9]+' | tail -1)
    tally="${tally#DONE }"
    if [ -z "$tally" ]; then
        echo "banditshell: the island check did not finish (log: $preview_log)" >&2
        sed 's/\x1b\[[0-9;]*m//g' "$preview_log" | grep -E 'ERROR' >&2 || true
        exit 1
    fi
    echo "$tally situations passed, photographs in $out"
    [ "${tally%/*}" = "${tally#*/}" ]
}

write_shot_handler() {
    cat >"$1" <<'EOF'
import QtQuick
import Quickshell
import Quickshell.Io
import qs.services

IpcHandler {
    target: "shot"

    function take(path: string): string {
        const win = Shell.windows[0];
        if (!win)
            return "no window";
        const item = win.contentItem.children[0];
        if (!item)
            return "no content";
        item.grabToImage(r => r.saveToFile(path));
        return "ok " + item.width + "x" + item.height;
    }
}
EOF
}

boot_root() {
    local work="$1" src="$2" shots="$3" source link
    mkdir -p "$src"
    for source in "$SHELL_DIR"/*; do
        link=$(basename "$source")
        [ "$link" = shell.qml ] || ln -s "$source" "$src/$link"
    done
    if [ -n "$shots" ]; then
        sed 's/^    LockScreen {}/    ShotIpc {}\n\n    LockScreen {}/' "$SHELL_DIR/shell.qml" >"$src/shell.qml"
        grep -q 'ShotIpc {}' "$src/shell.qml" || { echo "banditshell: shell.qml has no LockScreen line to put the shot handler before" >&2; return 1; }
        write_shot_handler "$src/ShotIpc.qml"
    else
        cp "$SHELL_DIR/shell.qml" "$src/shell.qml"
    fi
    mkdir -p "$work/home/.local/share" "$work/home/.config" "$work/home/Pictures"
    [ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" ] || ln -s "${XDG_DATA_HOME:-$HOME/.local/share}/fonts" "$work/home/.local/share/fonts"
    [ ! -d "${XDG_CONFIG_HOME:-$HOME/.config}/theme" ] || ln -s "${XDG_CONFIG_HOME:-$HOME/.config}/theme" "$work/home/.config/theme"
    [ ! -d "$HOME/Pictures/Wallpapers" ] || ln -s "$HOME/Pictures/Wallpapers" "$work/home/Pictures/Wallpapers"
}

print_boot_results() {
    local out="$1" verdict label detail class count sample
    boot_total=0
    boot_passed=0
    while IFS=$'\t' read -r verdict label detail; do
        case "$verdict" in
        PASS)
            boot_total=$((boot_total + 1))
            boot_passed=$((boot_passed + 1))
            echo "${green}PASS${plain} $boot_total. $label" ;;
        FAIL)
            boot_total=$((boot_total + 1))
            echo "${red}FAIL${plain} $boot_total. $label${detail:+ ${dim}$detail${plain}}" ;;
        SKIP) echo "${dim}SKIP $label${detail:+ $detail}${plain}" ;;
        esac
    done <"$out/calls.tsv"
    while IFS=$'\t' read -r verdict class count sample; do
        boot_total=$((boot_total + 1))
        if [ "$verdict" = PASS ]; then
            boot_passed=$((boot_passed + 1))
            echo "${green}PASS${plain} $boot_total. log has no $class"
        else
            echo "${red}FAIL${plain} $boot_total. log has $count $class ${dim}${sample}${plain}"
        fi
    done < <(node "$SHELL_DIR/scripts/boot-check.js" scan "$out/shell.log")
}

check_boot() {
    local out="" shots="" work src config overrides tool pid limit=150 argument
    for argument in "$@"; do
        case "$argument" in
        --shots) shots=1 ;;
        -*) say_usage "dev check boot [--shots] [dir]" ;;
        *) out=$(absolute_path "$argument") ;;
        esac
    done
    out="${out:-$SHOT_DIR/boot}"
    for tool in gamescope dbus-run-session jq node setsid qs; do
        command -v "$tool" >/dev/null || { echo "banditshell: $tool not found" >&2; exit 1; }
    done
    mkdir -p "$out"
    rm -f "$out/calls.tsv" "$out/shell.log" "$out/inner.log"
    work=$(mktemp -d)
    src="$work/root"
    boot_root "$work" "$src" "$shots" || { rm -rf "$work"; exit 1; }
    mkdir -p "$work/config/banditshell" "$work/state" "$work/cache" "$work/runtime"
    chmod 700 "$work/runtime"
    config="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
    overrides=". | $(compositor_look)"
    jq "$overrides" "$config" >"$work/config/banditshell/config.json" 2>/dev/null ||
        jq -n "{} | $overrides" >"$work/config/banditshell/config.json"
    cat >"$work/bus.conf" <<EOF
<busconfig>
  <type>session</type>
  <listen>unix:dir=$work/runtime</listen>
  <policy context="default">
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
    cat >"$work/run.sh" <<EOF
#!/usr/bin/env bash
cd "\$HOME"
qs -p "$src/shell.qml" >"$out/shell.log" 2>&1 &
shell_pid=\$!
SHELL_QML="$src/shell.qml" SRC="$src" OUT="$out" BOOT_SHOTS="$shots" bash "$SHELL_DIR/scripts/boot-check-inner.sh" >"$out/inner.log" 2>&1
kill "\$shell_pid" 2>/dev/null
sleep 1
kill -KILL "\$shell_pid" 2>/dev/null
exit 0
EOF
    echo "booting the real shell.qml headless and driving its ipc, about a minute; ctrl-c stops"
    (cd "$work/home" && exec setsid env -i PATH="$PATH" HOME="$work/home" LANG=C.UTF-8 \
        XDG_CONFIG_HOME="$work/config" XDG_STATE_HOME="$work/state" XDG_CACHE_HOME="$work/cache" XDG_RUNTIME_DIR="$work/runtime" \
        timeout -s KILL "$limit" dbus-run-session --config-file="$work/bus.conf" -- \
        gamescope --backend headless -W 1920 -H 1080 --expose-wayland -- \
        env QT_QPA_PLATFORM=wayland bash "$work/run.sh") </dev/null >"$out/gamescope.log" 2>&1 &
    pid=$!
    trap 'kill -KILL -- -"$pid" "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rm -rf "$work"; echo "stopped" >&2; exit 130' INT TERM
    wait "$pid" 2>/dev/null || true
    kill -KILL -- -"$pid" 2>/dev/null || true
    trap - INT TERM
    rm -rf "$work" 2>/dev/null || echo "banditshell: could not clear $work" >&2
    if [ ! -s "$out/calls.tsv" ]; then
        echo "banditshell: the boot check never reached the shell (logs: $out)" >&2
        sed 's/\x1b\[[0-9;]*m//g' "$out/gamescope.log" "$out/shell.log" 2>/dev/null | tail -n 12 >&2 || true
        exit 1
    fi
    print_boot_results "$out"
    if [ "$boot_passed" -ne "$boot_total" ]; then
        node "$SHELL_DIR/scripts/boot-check.js" errors "$out/shell.log" | head -n 20 | sed 's/^/     /'
    fi
    echo "BOOT $boot_passed/$boot_total, logs in $out"
    [ "$boot_passed" -eq "$boot_total" ]
}

perf_usage() {
    say_usage "dev perf [live] [--runs <n>] [--boots <n>] [--only <pattern>] [--profile] [--ns] [dir]"
}

perf_command() {
    local out="" runs=5 boots=5 only="" raw="" live="" work src config overrides tool pid link target limit=1800
    local -a extra=()
    if [ "${1:-}" = live ]; then
        live=1
        boots=0
        shift
    fi
    while [ $# -gt 0 ]; do
        case "$1" in
        --runs) [ $# -ge 2 ] || perf_usage; runs="$2"; shift ;;
        --boots) [ $# -ge 2 ] && [ -z "$live" ] || perf_usage; boots="$2"; shift ;;
        --only) [ $# -ge 2 ] || perf_usage; only="$2"; shift ;;
        --ns) raw=1 ;;
        --profile) [ -z "$live" ] || perf_usage; extra+=(--profile) ;;
        -*) perf_usage ;;
        *) out=$(absolute_path "$1") ;;
        esac
        shift
    done
    [[ $runs =~ ^[0-9]+$ && $boots =~ ^[0-9]+$ ]] || perf_usage
    command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
    [ -z "$only" ] || extra+=(--only "$only")
    [ -z "$raw" ] || extra+=(--ns)
    if [ -n "$live" ]; then
        out="${out:-$SHOT_DIR/perf-live}"
        resolve_target
        [ "${qs_target[0]}" = --pid ] || { complain "not running (try: banditshell start)"; exit 3; }
        echo "timing the running shell: every panel, menu and settings page opens and closes on your screen, $runs times; ctrl-c stops"
        mkdir -p "$SHOT_DIR/trace"
        exec node "$SHELL_DIR/scripts/perf.js" run --pid "${qs_target[1]}" --cli "$SHELL_DIR/cli/banditshell" --keep "$SHOT_DIR/trace/spans.json" \
            --runs "$runs" --where "live session" --out "$out" "${extra[@]}"
    fi
    out="${out:-$SHOT_DIR/perf}"
    for tool in gamescope dbus-run-session jq setsid qs pkill; do
        command -v "$tool" >/dev/null || { echo "banditshell: $tool not found" >&2; exit 1; }
    done
    mkdir -p "$out"
    rm -f "$out"/boot-*.log* "$out"/shell.log* "$out/progress.log" "$out/report.txt" "$out/session.log"
    work=$(mktemp -d)
    src="$work/root"
    boot_root "$work" "$src" "" || { rm -rf "$work"; exit 1; }
    for link in "$src"/*; do
        [ -L "$link" ] || continue
        target=$(readlink "$link")
        rm "$link"
        cp -a "$target" "$link"
    done
    mkdir -p "$work/config/banditshell" "$work/state" "$work/cache" "$work/runtime"
    chmod 700 "$work/runtime"
    config="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
    overrides='. | .pen.enabled = false | .pen.grabPad = false | .polkit.agent = false | .startup.runAutostart = false | .network.keepListFresh = false'
    overrides="$overrides | $(compositor_look)"
    jq "$overrides" "$config" >"$work/config/banditshell/config.json" 2>/dev/null ||
        jq -n "{} | $overrides" >"$work/config/banditshell/config.json"
    mkdir -p "$work/shims"
    printf '#!/bin/sh\nexit 1\n' >"$work/shims/ddcutil"
    printf '#!/bin/sh\nexec cat\n' >"$work/shims/systemd-inhibit"
    chmod +x "$work/shims/ddcutil" "$work/shims/systemd-inhibit"
    cat >"$work/bus.conf" <<EOF
<busconfig>
  <type>session</type>
  <listen>unix:dir=$work/runtime</listen>
  <policy context="default">
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF
    {
        printf '#!/usr/bin/env bash\ncd "$HOME"\nexport BANDITSHELL_DIR=%q PATH=%q\n' "$src" "$work/shims:$PATH"
        printf 'node %q run --shell %q --cli %q --runs %q --boots %q --where %q --out %q' \
            "$SHELL_DIR/scripts/perf.js" "$src/shell.qml" "$src/cli/banditshell" "$runs" "$boots" "headless, private session" "$out"
        [ ${#extra[@]} -eq 0 ] || printf ' %q' "${extra[@]}"
        printf ' >%q 2>%q\n' "$out/report.txt" "$out/progress.log"
    } >"$work/run.sh"
    : >"$out/progress.log"
    echo "booting the real shell.qml headless $boots times, then opening every panel, menu and settings page $runs times; a few minutes, ctrl-c stops"
    (cd "$work/home" && exec setsid env -i PATH="$PATH" HOME="$work/home" LANG=C.UTF-8 \
        XDG_CONFIG_HOME="$work/config" XDG_STATE_HOME="$work/state" XDG_CACHE_HOME="$work/cache" XDG_RUNTIME_DIR="$work/runtime" \
        timeout -s KILL "$limit" dbus-run-session --config-file="$work/bus.conf" -- \
        bash "$work/run.sh") </dev/null >"$out/session.log" 2>&1 &
    pid=$!
    trap 'kill -KILL -- -"$pid" "$pid" 2>/dev/null || true; pkill -KILL -f "$src/shell.qml" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; rm -rf "$work"; echo "stopped" >&2; exit 130' INT TERM
    tail -n +1 -f --pid="$pid" "$out/progress.log" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    kill -KILL -- -"$pid" 2>/dev/null || true
    pkill -KILL -f "$src/shell.qml" 2>/dev/null || true
    trap - INT TERM
    rm -rf "$work" 2>/dev/null || echo "banditshell: could not clear $work" >&2
    if [ ! -s "$out/report.txt" ]; then
        echo "banditshell: the timing run did not finish (logs: $out)" >&2
        sed 's/\x1b\[[0-9;]*m//g' "$out/session.log" "$out/progress.log" 2>/dev/null | tail -n 12 >&2 || true
        exit 1
    fi
    cat "$out/report.txt"
}

trace_command() {
