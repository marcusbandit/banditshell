#!/usr/bin/env bash
# banditshell - run and drive the shell.
#
# Menus open on hover, which is a fine way to use them and an impossible way to
# test: you cannot script a cursor into a corner and assert what happened. This
# drives the same code path from the terminal, so the gesture and the thing it
# opens can be checked separately.
#
#   banditshell start|stop|restart|run|log
#   banditshell menu list|open <key>|close|toggle <key>|current|hover
#   banditshell launcher toggle|open|close|scrub <0..1>
#   banditshell clipboard toggle|open|close|list|use <n>|pin <n>|remove <n>|clear|status
#                                what you copied; <n> is the index `list` prints.
#                                `status` says whether it is actually RECORDING,
#                                which a history that has quietly stopped growing
#                                cannot tell you any other way.
#   banditshell session toggle|open|close
#   banditshell calculator toggle|open|close|answer <expression>
#                                the keypad panel; `answer` evaluates and prints
#                                without a surface: `calculator answer "2+3*4"`
#   banditshell tablet on|off|toggle|status|probe
#                                the hinge. `on`/`off` are what the compositor's
#                                switch binds call when the machine is folded
#                                over; `probe` asks the hardware directly
#   banditshell keyboard toggle|open|close|status|dock|float|page <name>
#                                the on-screen board, for when the real keyboard
#                                is face down on the table. Comes up by itself
#                                on a fold unless tablet.autoKeyboard is off
#   banditshell settings toggle|open [page] [screen]|close|page <key>|pull|put|status
#                                pull = shell -> window, put = window -> shell
#   banditshell notifications toggle [screen]|open [screen]|close|clear|status [screen]
#   banditshell notch toggle [screen]|open [screen]|close|status [screen]
#   banditshell hotkeys toggle [screen]|open [screen]|close|status [screen]
#                                every bind the compositor knows, read live
#   banditshell close            shut every surface. THE WAY OUT if the desktop
#                                looks frozen: a surface holding the keyboard
#                                leaves no window focused and swallows clicks.
#                                Bind it; you cannot type your way out.
#   banditshell calendar         toggle the calendar menu (menu toggle calendar)
#   banditshell clock            toggle the clock menu (menu toggle clock)
#   banditshell timer start <duration> [label]|pause|resume|toggle|cancel [handle]|status
#                                durations: 10m, 90s, 2h, 1h30m, or a bare number of minutes
#                                a handle is the id or the position `timer status` prints;
#                                without one, the timer about to go off
#   banditshell alarm list|status|snooze|stop|enable <handle>|disable <handle>|remove <handle>
#                    add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]
#                                times: 07:00, 7:30pm, 0700, 7
#                                days:  mon,wed | mon-fri | weekdays | weekends | daily | once
#                                --run is a shell command, --ask sends the text to Claude
#   banditshell zone list|find <text>|add <place>|remove <place>
#                                a place is an IANA id, or enough of one to name only itself
#   banditshell volume up|down [n]|set <pct>|mute [on|off]|status
#   banditshell lock [status]    lock the session; `loginctl unlock-session` undoes it
#   banditshell picker open|freeze|clip|freezeclip|close
#   banditshell wallpaper toggle|on|off|next|prev|status|palette
#                                palette = the colours it is mostly made of
#   banditshell wallpapers toggle|open|close|status
#                                the picker: the bottom edge's second pull
#   banditshell status
#   banditshell theme [name]
#   banditshell get <key> | set <key> <value>
#   banditshell shot [file]      screenshot, for checking a change actually landed
#   banditshell demo <key>       open a menu, screenshot it, close it
#   banditshell lockpreview      draw the lock screen WITHOUT locking, and shoot it
#   banditshell shaders          recompile every components/**/*.frag to .qsb
#
# Every verb above is bindable: a Hyprland bind is an exec of this CLI, and
# docs/hyprland-binds.example.conf is a ready-made set to copy or source.

set -euo pipefail

SHELL_DIR="${BANDITSHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SHOT_DIR="${BANDITSHELL_SHOTS:-${XDG_RUNTIME_DIR:-/tmp}/banditshell}"

# Started from $HOME, ALWAYS.
#
# Every application the shell launches is its child and inherits its working
# directory, so a shell started from this repo opened every terminal in this
# repo. -p takes an absolute path, so nothing here depends on the cwd; the only
# thing it decides is where the desktop lands, and that is the user's home.
qs_() { (cd "$HOME" && qs -p "$SHELL_DIR" "$@"); }

# `qs ipc call` fails loudly when the shell is not running; say so in a way that
# tells you what to do about it.
ipc() {
    if ! qs_ ipc call "$@" 2>/dev/null; then
        echo "banditshell: not running (try: banditshell start)" >&2
        return 1
    fi
}

running() { pgrep -x qs >/dev/null 2>&1; }

# Print the header comment block, however long it happens to be. A hardcoded
# line range silently starts printing the code once the header changes length.
usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$(readlink -f "${BASH_SOURCE[0]}")"; }

cmd="${1:-help}"
shift || true

case "$cmd" in
start)
    running && { echo "already running"; exit 0; }
    qs_ -d
    ;;
stop)
    # -x, not -f: `pkill -f qs` matches this script's own command line and kills
    # the terminal it was typed in.
    pkill -x qs || true
    echo "stopped"
    ;;
restart)
    pkill -x qs || true
    sleep 0.5
    qs_ -d
    ;;
run)
    # Foreground, so QML errors land in the terminal. Spelled out rather than
    # calling qs_: bash's exec replaces the process from PATH and cannot run a
    # shell function, so `exec qs_` dies with "not found" before qs is reached.
    cd "$HOME" || exit 1
    exec qs -p "$SHELL_DIR"
    ;;
log)
    exec qs -p "$SHELL_DIR" log "$@"
    ;;

menu)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list | close | current | hover) ipc menu "$sub" ;;
    open | toggle)
        [ $# -ge 1 ] || { echo "usage: banditshell menu $sub <key>" >&2; exit 2; }
        ipc menu "$sub" "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell menu list|open <key>|close|toggle <key>|current|hover" >&2; exit 2 ;;
    esac
    ;;

launcher)
    if [[ "${1:-}" == "scrub" ]]; then
        ipc launcher scrub "${2:-0}"
    else
        ipc launcher "${1:-toggle}"
    fi
    ;;

# The verbs that take an index are spelled out; the rest pass through the way
# session's do. An index is whatever `clipboard list` printed in its first
# column, which is why that verb prints one.
clipboard)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | open | close | list | clear | status) ipc clipboard "$sub" ;;
    use | pin | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell clipboard $sub <index>" >&2; exit 2; }
        ipc clipboard "$sub" "$1"
        ;;
    *) echo "usage: banditshell clipboard toggle|open|close|list|use <n>|pin <n>|remove <n>|clear|status" >&2; exit 2 ;;
    esac
    ;;

session)
    ipc session "${1:-toggle}"
    ;;

# Spelled out rather than passed through the way session's is, because one verb
# takes an argument: `answer` is the only route to the arithmetic that involves
# no panel at all, so it has to be able to say what it could not parse.
calculator | calc)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | open | close) ipc calculator "$sub" ;;
    answer)
        [ $# -ge 1 ] || { echo "usage: banditshell calculator answer <expression>" >&2; exit 2; }
        ipc calculator answer "$*"
        ;;
    *) echo "usage: banditshell calculator toggle|open|close|answer <expression>" >&2; exit 2 ;;
    esac
    ;;

# THE HINGE, and this is the verb the COMPOSITOR calls rather than you.
#
# The switch binds in ~/.config/hypr/lua/binds.lua exec `tablet on` and
# `tablet off`, because the shell cannot read the switch device itself. `probe`
# is here as the diagnostic for when a fold does not seem to be arriving: it
# asks the hardware directly and will usually answer `unknown`, which is the
# expected answer and is explained in the script it runs.
tablet)
    sub="${1:-status}"
    case "$sub" in
    # The second argument says WHO is calling, and only the switch binds pass
    # one (`compositor`). It is what makes `status` able to tell a hinge that
    # moved from a command somebody typed.
    on | off | toggle) ipc tablet "$sub" "${2:-}" ;;
    status) ipc tablet status ;;
    probe) python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose ;;
    *) echo "usage: banditshell tablet on|off|toggle|status|probe" >&2; exit 2 ;;
    esac
    ;;

# The on-screen board, separately from the hinge above: a keyboard is worth
# having on an unfolded machine and worth dismissing on a folded one.
keyboard | osk)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    # `close` is the odd one out and takes NO screen: it reaches every window,
    # because "put it away" is not a question about a monitor. Passing it one
    # anyway is not ignored, it is an arity error from the IPC layer, and the
    # verb silently does nothing.
    close) ipc keyboard close ;;
    # Whether the board takes up room. Neither takes a screen: it is one
    # preference about how the keyboard behaves, not a fact about a monitor.
    dock | float) ipc keyboard "$sub" ;;
    toggle | open | status) ipc keyboard "$sub" "${1:-}" ;;
    page)
        [ $# -ge 1 ] || { echo "usage: banditshell keyboard page <name>" >&2; exit 2; }
        ipc keyboard page "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell keyboard toggle|open|close|status|dock|float|page <name>" >&2; exit 2 ;;
    esac
    ;;

# THE WAY OUT, and the reason it exists is worth writing down.
#
# Several surfaces take the keyboard EXCLUSIVELY while they are up (the
# launcher, the power panel, the hotkey sheet, a pinned menu) and put a
# full-screen region into the input mask so that a click anywhere off them
# puts them away. That is correct for each of them on its own. The failure it
# creates is that a surface left open by something that died mid-sequence, or
# a pin that got stuck, takes the whole desktop with it: no window holds focus,
# so a bind like `layoutmsg, focus l` has nothing to act on, and every click
# lands on the shell instead of on what is under it. The screen looks frozen.
#
# You cannot type your way out of that, because the terminal does not have the
# keyboard either. A compositor keybind still fires (Hyprland handles binds
# before the event reaches any client), so the only rescue that can work is a
# bind pointed at this, and that is why this verb exists and why it is one
# word. See docs/hyprland-binds.example.conf for the suggested binding.
#
# It closes everything unconditionally and never fails: each verb is allowed to
# error (a surface that is not open, an IPC target that is not registered yet)
# without stopping the ones after it, because the whole point is to be the thing
# that works when something else has not.
close | panic)
    for target in "menu close" "launcher close" "clipboard close" "session close" "hotkeys close" \
                  "settings close" "notifications close" "notch close" "picker close" \
                  "calculator close" "keyboard close"; do
        # Unquoted on purpose: this is the one place a verb and its argument
        # travel as one string and have to come apart again.
        # shellcheck disable=SC2086
        ipc $target >/dev/null 2>&1 || true
    done
    echo "closed everything"
    ;;

# The two verbs that take a value get spelled out; the rest pass through the
# way session's do. `open` always sends its page and screen arguments, empty
# when none was given, because the IPC function declares the parameters and an
# omitted argument does not read as an empty one on the other side. The screen
# goes second so `settings open icons` keeps meaning what it always meant; a
# caller that wants to name a screen without naming a page passes "" for the
# page, the same shape `menu open <key> <screen>` already has.
settings)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | close | pull | put | status) ipc settings "$sub" ;;
    open) ipc settings open "${1:-}" "${2:-}" ;;
    page)
        [ $# -ge 1 ] || { echo "usage: banditshell settings page <key>" >&2; exit 2; }
        ipc settings page "$1"
        ;;
    *) echo "usage: banditshell settings toggle|open [page] [screen]|close|page <key>|pull|put|status" >&2; exit 2 ;;
    esac
    ;;

# The tray and the notch, both pinned PER WINDOW, so both name a screen on the
# verbs that pin one. Bare, they toggle, like every other panel here.
#
# The screen is sent on every verb that has one, empty when none was named, for
# the reason spelled out under `hotkeys` below: the IPC function declares the
# parameter, and an omitted argument is a "too few arguments" error on the other
# side rather than an empty one, so a pass-through that dropped it would turn
# `notifications open` into a no-op. `close` and `clear` take none, because
# putting the tray away reaches every screen on purpose and the history is one
# list for the whole session.
notifications)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close | clear) ipc notifications "$sub" ;;
    toggle | open | status) ipc notifications "$sub" "${1:-}" ;;
    *) echo "usage: banditshell notifications toggle [screen]|open [screen]|close|clear|status [screen]" >&2; exit 2 ;;
    esac
    ;;

notch)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close) ipc notch close ;;
    toggle | open | status) ipc notch "$sub" "${1:-}" ;;
    *) echo "usage: banditshell notch toggle [screen]|open [screen]|close|status [screen]" >&2; exit 2 ;;
    esac
    ;;

# The hotkey sheet. Bare, it toggles, like every other panel here: this is the
# verb a key is bound to, and the key that put the sheet up is the key that
# should take it down. `status` prints what the sheet actually read, which is
# the question worth asking from a terminal, because a sheet full of chords with
# nothing beside them is the compositor declining to say rather than this shell
# failing to parse.
#
# The screen is sent on every verb that has one, empty when none was named,
# because the IPC function DECLARES the parameter and an omitted argument is not
# an empty one on the other side: it is a "too few arguments" error and nothing
# happens at all. `settings open` says the same thing above; this is the same
# trap one target along. `close` takes none, because putting the sheet away
# reaches every screen on purpose.
hotkeys)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close) ipc hotkeys close ;;
    toggle | open | status) ipc hotkeys "$sub" "${1:-}" ;;
    *) echo "usage: banditshell hotkeys toggle [screen]|open [screen]|close|status [screen]" >&2; exit 2 ;;
    esac
    ;;

# Sugar. The calendar is an ordinary menu with the key "calendar", registered
# in the sidebar like the rest, so no IPC target of its own exists or should:
# this is `menu toggle calendar` with fewer words, because the thing you bind
# to a key deserves a shorter name than the thing it is implemented as. The
# trailing "" is the screen argument every menu verb carries.
calendar)
    ipc menu toggle calendar ""
    ;;

# The same sugar for the clock, which is an ordinary menu with the key "clock".
# The three targets below drive everything behind it without it being open at
# all, which is the whole reason services/Clock.qml is a singleton: a countdown
# that only exists while somebody is looking at it is not a countdown.
clock)
    ipc menu toggle clock ""
    ;;

# Countdowns. Bare, it says what is counting, because that is the question you
# type in a terminal; `start` is the one worth a keybind, and `toggle` is the
# other one, for the same reason `volume mute` toggles. Every other verb takes
# an optional handle, the id or the position `status` prints beside it, and
# without one means the timer about to go off, which is the only thing a key
# could mean. The handle is sent empty rather than dropped, for the reason
# spelled out under `hotkeys` above: the IPC function declares the parameter.
timer)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    status) ipc timer status ;;
    pause | resume | toggle | cancel) ipc timer "$sub" "${1:-}" ;;
    start)
        [ $# -ge 1 ] || { echo "usage: banditshell timer start <duration> [label]" >&2; exit 2; }
        ipc timer start "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell timer start <duration> [label]|pause|resume|toggle|cancel [handle]|status" >&2; exit 2 ;;
    esac
    ;;

# Alarms. `add` is the only verb in this file with options, and they are FLAGS
# rather than positions because a keybind is a line somebody writes once and
# reads a year later: counting empty arguments to reach the fifth one is the
# mistake this shape cannot make. They are collected here and handed to the IPC
# function in its own fixed order, which is the division of labour set out in
# the alarm handler's comment in modules/Ipc.qml.
#
# --run and --ask are one slot said two ways (a shell command to run, a message
# to send), so the last one on the line wins; there is no alarm that does both.
alarm)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list | status | snooze | stop) ipc alarm "$sub" ;;
    enable | disable | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell alarm $sub <handle>" >&2; exit 2; }
        ipc alarm "$sub" "$1"
        ;;
    add)
        [ $# -ge 1 ] || { echo "usage: banditshell alarm add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]" >&2; exit 2; }
        when="$1"
        shift
        days=""
        label=""
        mode=""
        payload=""
        while [ $# -gt 0 ]; do
            # Every flag here takes a value, so one sitting at the end of the
            # line is a value that was forgotten rather than a flag that means
            # something alone. Checked BEFORE the shift, because `shift 2` with
            # one argument left fails, and under `set -e` a failed shift ends
            # the script with no message and an exit code nobody reads.
            [ $# -ge 2 ] || { echo "banditshell: $1 needs a value" >&2; exit 2; }
            case "$1" in
            --days) days="$2" ;;
            --label) label="$2" ;;
            --run) mode="command"; payload="$2" ;;
            --ask) mode="cloud"; payload="$2" ;;
            *) echo "banditshell: unknown option: $1" >&2; exit 2 ;;
            esac
            shift 2
        done
        ipc alarm add "$when" "$days" "$label" "$mode" "$payload"
        ;;
    *) echo "usage: banditshell alarm list|status|snooze|stop|add <time> [options]|enable <handle>|disable <handle>|remove <handle>" >&2; exit 2 ;;
    esac
    ;;

# Places. The argument is EVERYTHING that follows, joined back into one string,
# so `zone add new york` works without quotes: the tz database writes that space
# as an underscore, and both spellings are normalised to the same key on the
# other side (zoneKey in modules/Ipc.qml). There is no label to pass, because
# the city the panel draws is read off the id itself.
zone)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list) ipc zone list ;;
    find | add | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell zone $sub <place>" >&2; exit 2; }
        ipc zone "$sub" "$*"
        ;;
    *) echo "usage: banditshell zone list|find <text>|add <place>|remove <place>" >&2; exit 2 ;;
    esac
    ;;

# `up` and `down` move by the shell's configured step (the same one the wheel
# and the sound menu use) and take an optional count of steps; `set` speaks
# percent of the normal range, so 100 is full volume and anything above it is
# amplification up to the shell's ceiling.
volume)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    up | down) ipc volume "$sub" "${1:-}" ;;
    set)
        [ $# -ge 1 ] || { echo "usage: banditshell volume set <percent>" >&2; exit 2; }
        ipc volume set "$1"
        ;;
    mute) ipc volume mute "${1:-}" ;;
    status) ipc volume status ;;
    *) echo "usage: banditshell volume up|down [n]|set <pct>|mute [on|off]|status" >&2; exit 2 ;;
    esac
    ;;

# No `unlock` here, and that is not an oversight: see the lock handler in
# modules/Ipc.qml. The way back in is `loginctl unlock-session`, which works
# from a TTY and over SSH, which is where you will be if you need it.
lock)
    ipc lock "${1:-lock}"
    ;;

picker)
    ipc picker "${1:-freezeclip}"
    ;;

# The wallpaper the shell draws itself. Every one of these is a write to
# config.json that `set wallpaper.enabled` or `set wallpaper.current` could make
# by hand; what they add is the two a KEY needs, which is the two that have to
# read the value before writing it: the opposite of whatever it is now, and the
# next one along. Bare `wallpaper` is the toggle, like `settings` and `session`.
wallpaper)
    sub="${1:-toggle}"
    case "$sub" in
    toggle | on | off | next | prev | status | palette) ipc wallpaper "$sub" ;;
    *) echo "usage: banditshell wallpaper toggle|on|off|next|prev|status|palette" >&2; exit 2 ;;
    esac
    ;;

# The picker, which is a surface rather than a setting: plural for the folder,
# singular above for the one you are wearing. See the note on its IPC target.
wallpapers)
    ipc wallpapers "${1:-toggle}"
    ;;

status) ipc shell status ;;
themes) ipc shell themes ;;
theme)
    [ $# -ge 1 ] && ipc shell set theme "\"$1\"" || ipc shell get theme
    ;;
get)
    [ $# -ge 1 ] || { echo "usage: banditshell get <key>" >&2; exit 2; }
    ipc shell get "$1"
    ;;
set)
    [ $# -ge 2 ] || { echo "usage: banditshell set <key> <value>" >&2; exit 2; }
    ipc shell set "$1" "$2"
    ;;

shot)
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/shot.png}"
    grim "$out"
    echo "$out"
    ;;

shaders)
    # .qsb files are build output committed alongside their source, because
    # Quickshell loads QML from a directory and has nowhere to run a build step.
    # This is that build step; run it after editing any .frag.
    qsb="${QSB:-/usr/lib/qt6/bin/qsb}"
    [ -x "$qsb" ] || { echo "banditshell: qsb not found (install qt6-shadertools)" >&2; exit 1; }
    # EVERY .frag under components/, wherever it sits. It used to be the one
    # directory the first shader happened to live in, so the second one was
    # written, committed, and silently never compiled: the shell loaded the
    # stale .qsb that was not there and drew nothing at all.
    while IFS= read -r f; do
        "$qsb" --glsl "100es,120,150" --hlsl 50 --msl 12 -o "$f.qsb" "$f"
        echo "${f#"$SHELL_DIR/"} -> ${f#"$SHELL_DIR/"}.qsb"
    done < <(find "$SHELL_DIR/components" -name '*.frag' | sort)
    ;;

demo)
    # Open a menu, wait for the reveal to settle, capture it, put it away. The
    # sleep is the animation, not a guess: the reveal is exponential smoothing,
    # so it is asymptotic and needs a moment rather than a frame.
    [ $# -ge 1 ] || { echo "usage: banditshell demo <key>" >&2; exit 2; }
    mkdir -p "$SHOT_DIR"
    out="${2:-$SHOT_DIR/menu-$1.png}"
    ipc menu open "$1" "" >/dev/null
    sleep 0.6
    grim "$out"
    ipc menu close >/dev/null
    echo "$out"
    ;;

lockpreview)
    # The lock screen's LOOK, without the lock. A session lock cannot be opened
    # to look at, and the way back from one that drew wrong is a TTY, so the face
    # is a plain Item that also fits in an ordinary overlay surface.
    #
    # Its own quickshell instance, on a timer, taking no input: it draws over
    # everything for a few seconds and then goes away on its own whatever
    # happens. Deliberately NOT killed with pkill afterwards, which would take
    # the running shell with it.
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/lock.png}"
    (cd "$HOME" && timeout 9 qs -p "$SHELL_DIR/lockpreview.qml" >/dev/null 2>&1) &
    sleep 4
    grim "$out"
    wait
    echo "$out"
    ;;

help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
