#!/usr/bin/env bash
# banditshell - run and drive the shell.
#
# Menus open on hover, which is a fine way to use them and an impossible way to
# test: you cannot script a cursor into a corner and assert what happened. This
# drives the same code path from the terminal, so the gesture and the thing it
# opens can be checked separately.
#
#   banditshell start|stop|restart|run|log
#   banditshell menu list|open <key>|close|toggle <key>|current|hover
#   banditshell launcher toggle|open|close|run <id>|scrub <0..1>
#   banditshell clipboard toggle|open|close|list|use <n>|pin <n>|remove <n>|clear|status
#                                what you copied; <n> is the index `list` prints.
#                                `status` says whether it is actually RECORDING,
#                                which a history that has quietly stopped growing
#                                cannot tell you any other way.
#   banditshell session toggle|open|close
#   banditshell calculator toggle|open|close|app|panel|status|answer <expression>
#                                the keypad panel; `answer` evaluates and prints
#                                without a surface: `calculator answer "2+3*4"`.
#                                `app` is the same calculator standing over the
#                                whole screen, which is what the .desktop entry
#                                runs; `panel` is the strip on the sidebar's
#                                flank. Both toggle. The shape is sticky, so
#                                `toggle` reopens whichever you last used
#   banditshell tablet on|off|toggle|lid closed|open|status|probe|probe-lid
#                                the hinge. `on`/`off` are what the compositor's
#                                switch binds call when the machine is folded
#                                over; `probe` asks the hardware directly
#   banditshell keyboard toggle|open|close|status|dock|float|page <name>
#                                the on-screen board, for when the real keyboard
#                                is face down on the table. Comes up by itself
#                                on a fold unless tablet.autoKeyboard is off
#   banditshell settings toggle|open [page] [screen]|close|page <key>|pull|put|status
#                                pull = shell -> window, put = window -> shell
#   banditshell notifications toggle [screen]|open [screen]|close|clear|status [screen]
#   banditshell notch toggle [screen]|open [screen]|close|status [screen]
#   banditshell hotkeys toggle [screen]|open [screen]|close|status [screen]
#                                every bind the compositor knows, read live
#   banditshell close            shut every surface. THE WAY OUT if the desktop
#                                looks frozen: a surface holding the keyboard
#                                leaves no window focused and swallows clicks.
#                                Bind it; you cannot type your way out.
#   banditshell calendar         toggle the calendar menu (menu toggle calendar)
#   banditshell clock            toggle the clock menu (menu toggle clock)
#   banditshell timer start <duration> [label]|pause|resume|toggle|cancel [handle]|status
#                                durations: 10m, 90s, 2h, 1h30m, or a bare number of minutes
#                                a handle is the id or the position `timer status` prints;
#                                without one, the timer about to go off
#   banditshell alarm list|status|snooze|stop|enable <handle>|disable <handle>|remove <handle>
#                    add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]
#                                times: 07:00, 7:30pm, 0700, 7
#                                days:  mon,wed | mon-fri | weekdays | weekends | daily | once
#                                --run is a shell command, --ask sends the text to Claude
#   banditshell zone list|find <text>|add <place>|remove <place>
#                                a place is an IANA id, or enough of one to name only itself
#   banditshell volume up|down [n]|set <pct>|mute [on|off]|status
#   banditshell output toggle|speakers|headphones|status|list|assign <role> <name>
#                                the speakers/headphones switch, as one key. Which
#                                sink each name means is a setting, because no two
#                                machines have the same cards: `list` prints the
#                                names on this one and `assign` writes one
#   banditshell lock [status]    lock the session; `loginctl unlock-session` undoes it
#   banditshell picker open|freeze|clip|freezeclip|close
#                                falls back to grim/slurp when the shell cannot
#                                be reached, so the screenshot key always shoots
#   banditshell wallpaper toggle|on|off|status|palette
#   banditshell wallpaper next|prev|set <path>|clear [screen|all]
#                                a wallpaper is per monitor: no screen means the
#                                focused one, `all` means the whole desk at once
#                                palette = the colours it is mostly made of
#   banditshell wallpaper list [screen]
#                                every wallpaper in the folder with its measured
#                                shape, and whether it suits that screen. The
#                                picker shows you only the ones that do, so this
#                                is where the ones it left out are visible
#   banditshell wallpapers toggle [screen]|open [screen]|close|status
#                                the picker: the bottom edge's second pull. It
#                                sets the wallpaper for the screen it is on
#   banditshell status
#   banditshell theme [name]
#   banditshell get <key> | set <key> <value>
#   banditshell shot [file]      screenshot, for checking a change actually landed
#   banditshell demo <key>       open a menu, screenshot it, close it
#   banditshell lockpreview      draw the lock screen WITHOUT locking, and shoot it
#   banditshell settingspreview [WxH] [page] [file]
#                                the settings face in a plain window at that size:
#                                400x800 is a phone, 800x800 the phone unfolded
#   banditshell files [toggle|open [path]|close]
#                                the file browser, in its own window
#   banditshell shaders          recompile every components/**/*.frag to .qsb
#   banditshell build            compile src/*.c into bin/ (bs-pty, bs-ls)
#   banditshell test             run tests/ against the plain-JavaScript parts
#                                (the terminal, the base64 codec, the file marks)
#
# Every verb above is bindable: a Hyprland bind is an exec of this CLI, and
# docs/hyprland-binds.example.conf is a ready-made set to copy or source.

set -euo pipefail

SHELL_DIR="${BANDITSHELL_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
SHOT_DIR="${BANDITSHELL_SHOTS:-${XDG_RUNTIME_DIR:-/tmp}/banditshell}"

# Started from $HOME, ALWAYS.
#
# Every application the shell launches is its child and inherits its working
# directory, so a shell started from this repo opened every terminal in this
# repo. -p takes an absolute path, so nothing here depends on the cwd; the only
# thing it decides is where the desktop lands, and that is the user's home.
qs_() { (cd "$HOME" && qs -p "$SHELL_DIR" "$@"); }

# WHICH INSTANCE, and this is the failure it exists to stop.
#
# `qs ipc -p <dir>` finds an instance by the config path it was STARTED from,
# and the only path this script knows is the checkout it happens to live in.
# Those two agree right up until the shell is started from somewhere else,
# which a git worktree during development does as a matter of course, and from
# that moment every verb in this file addresses an instance that does not
# exist: one line to stderr, exit 1. A Hyprland bind is an exec with no
# terminal behind it, so the line goes nowhere, the KEY DOES NOTHING, and
# nothing says why. Nine binds silently dead with a shell running perfectly
# well on the screen.
#
# So the instance is the one that is RUNNING, found by asking rather than
# assumed from a path. The path stays a preference between candidates instead
# of a requirement: this checkout wins when it is up, any other shell.qml is
# taken over nothing at all. Preview instances (lockpreview.qml,
# settingspreview.qml) fall out by that filename; they are qs processes too and
# they answer no IPC.
#
# Resolved once and cached, because several verbs make more than one call.
qs_target=()
qs_target_resolved=0

resolve_target() {
    if [ "$qs_target_resolved" = 1 ]; then
        return 0
    fi
    qs_target_resolved=1

    local pid path exact="" any=""
    while IFS=$'\t' read -r pid path; do
        case "$path" in
        "$SHELL_DIR/shell.qml") exact="$pid" ;;
        */shell.qml) [ -n "$any" ] || any="$pid" ;;
        esac
    done < <(qs list --all 2>/dev/null | awk '
        /^[[:space:]]*Process ID:/ { pid = $NF }
        /^[[:space:]]*Config path:/ {
            p = $0
            sub(/^[[:space:]]*Config path:[[:space:]]*/, "", p)
            print pid "\t" p
        }
    ')

    local pick="${exact:-$any}"
    if [ -n "$pick" ]; then
        qs_target=(--pid "$pick")
    else
        qs_target=(-p "$SHELL_DIR")
    fi
}

# SAY SO SOMEWHERE A KEYBIND CAN BE HEARD.
#
# stderr is the right place for a line somebody typed in a terminal and the
# wrong place for a line produced by a key. hyprctl notify draws from the
# COMPOSITOR, which is the process still standing when the shell is the thing
# that died; notify-send hands the message to the shell's own notification
# daemon, so the one failure worth announcing is the one it cannot announce.
complain() {
    echo "banditshell: $1" >&2
    hyprctl notify -1 5000 "rgb(e06c75)" "banditshell: $1" >/dev/null 2>&1 || true
}

# `qs ipc call` fails loudly when the shell is not running; say so in a way that
# tells you what to do about it.
# The answer is BUFFERED rather than streamed, because qs writes its own
# failure ("No running instances for ...") to STDOUT, not to stderr. Passed
# straight through, that line lands in the middle of whatever was reading this
# verb's output as if it were the answer. So the call's output is held and
# printed only when the call actually worked.
ipc() {
    resolve_target
    local out
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    complain "not running (try: banditshell start)"
    return 1
}

# The same call for a caller that has its own answer to failure. Quiet only
# about the FAILURE: a verb that worked still says what it did, the way it
# always did from a terminal.
ipc_quiet() {
    resolve_target
    local out
    if out=$(cd "$HOME" && qs ipc "${qs_target[@]}" call "$@" 2>/dev/null); then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    fi
    return 1
}

running() { pgrep -x qs >/dev/null 2>&1; }

# Print the header comment block, however long it happens to be. A hardcoded
# line range silently starts printing the code once the header changes length.
usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$(readlink -f "${BASH_SOURCE[0]}")"; }

cmd="${1:-help}"
shift || true

case "$cmd" in
start)
    running && { echo "already running"; exit 0; }
    qs_ -d
    ;;
stop)
    # -x, not -f: `pkill -f qs` matches this script's own command line and kills
    # the terminal it was typed in.
    pkill -x qs || true
    echo "stopped"
    ;;
restart)
    pkill -x qs || true
    sleep 0.5
    qs_ -d
    ;;
run)
    # Foreground, so QML errors land in the terminal. Spelled out rather than
    # calling qs_: bash's exec replaces the process from PATH and cannot run a
    # shell function, so `exec qs_` dies with "not found" before qs is reached.
    cd "$HOME" || exit 1
    exec qs -p "$SHELL_DIR"
    ;;
log)
    exec qs -p "$SHELL_DIR" log "$@"
    ;;

menu)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list | close | current | hover) ipc menu "$sub" ;;
    open | toggle)
        [ $# -ge 1 ] || { echo "usage: banditshell menu $sub <key>" >&2; exit 2; }
        ipc menu "$sub" "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell menu list|open <key>|close|toggle <key>|current|hover" >&2; exit 2 ;;
    esac
    ;;

launcher)
    case "${1:-toggle}" in
    scrub) ipc launcher scrub "${2:-0}" ;;
    # `run` takes a desktop entry id, or anything the launcher's own search
    # would put at the top: `launcher run firefox`.
    run) ipc launcher run "${2:-}" ;;
    *) ipc launcher "${1:-toggle}" ;;
    esac
    ;;

# The verbs that take an index are spelled out; the rest pass through the way
# session's do. An index is whatever `clipboard list` printed in its first
# column, which is why that verb prints one.
clipboard)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | open | close | list | clear | status) ipc clipboard "$sub" ;;
    use | pin | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell clipboard $sub <index>" >&2; exit 2; }
        ipc clipboard "$sub" "$1"
        ;;
    *) echo "usage: banditshell clipboard toggle|open|close|list|use <n>|pin <n>|remove <n>|clear|status" >&2; exit 2 ;;
    esac
    ;;

session)
    ipc session "${1:-toggle}"
    ;;

# THE TABLET MAPPING, and this is the verb you reach for when the tablet cannot
# speak for itself. PenMap is meant to be driven from the pad: hold a button,
# drag with the pen, let go. That is the whole design, and it is also the whole
# risk, because the pad arrives over Bluetooth and a tablet that is asleep, flat
# or unpaired has no buttons to hold. Nothing here is bound to a key by default;
# it exists so "the mapper will not open" is one command to work around rather
# than a shell restart.
#
# `set` takes GLOBAL layout coordinates, the same frame `hyprctl monitors`
# prints, because that is the only frame in which "which monitor is this on" has
# an answer. The service clamps and re-homes whatever it is handed, so a
# rectangle that is off the edge or the wrong shape is corrected rather than
# refused.
penmap | pen)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    open | commit | cancel | aspect | follow | status) ipc penmap "$sub" ;;
    set)
        [ $# -eq 4 ] || { echo "usage: banditshell penmap set <x> <y> <w> <h>" >&2; exit 2; }
        ipc penmap set "$1" "$2" "$3" "$4"
        ;;
    *) echo "usage: banditshell penmap open|commit|cancel|aspect|follow|status|set <x> <y> <w> <h>" >&2; exit 2 ;;
    esac
    ;;

# Spelled out rather than passed through the way session's is, because one verb
# takes an argument: `answer` is the only route to the arithmetic that involves
# no panel at all, so it has to be able to say what it could not parse.
calculator | calc)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | open | close | app | panel | status) ipc calculator "$sub" ;;
    answer)
        [ $# -ge 1 ] || { echo "usage: banditshell calculator answer <expression>" >&2; exit 2; }
        ipc calculator answer "$*"
        ;;
    *) echo "usage: banditshell calculator toggle|open|close|app|panel|status|answer <expression>" >&2; exit 2 ;;
    esac
    ;;

# THE HINGE, and this is the verb the COMPOSITOR calls rather than you.
#
# The switch binds in ~/.config/hypr/lua/binds.lua exec `tablet on` and
# `tablet off`, because the shell cannot read the switch device itself. `probe`
# is here as the diagnostic for when a fold does not seem to be arriving: it
# asks the hardware directly and will usually answer `unknown`, which is the
# expected answer and is explained in the script it runs.
tablet)
    sub="${1:-status}"
    case "$sub" in
    # The second argument says WHO is calling, and only the switch binds pass
    # one (`compositor`). It is what makes `status` able to tell a hinge that
    # moved from a command somebody typed.
    on | off | toggle) ipc tablet "$sub" "${2:-}" ;;
    # THE LID, which vetoes the hinge: this machine's fold switch trips when the
    # lid is SHUT as well as when it is folded back, so the shell needs the lid
    # to tell 0 degrees from 360. Called by the lid bind, next to the fold ones.
    lid)
        case "${2:-}" in
        closed | open | toggle) ipc tablet lid "$2" "${3:-}" ;;
        *) echo "usage: banditshell tablet lid closed|open|toggle" >&2; exit 2 ;;
        esac
        ;;
    status) ipc tablet status ;;
    probe) python3 "$SHELL_DIR/scripts/tablet-state.py" --verbose ;;
    # The lid's own probe, same script and same diagnostic purpose.
    probe-lid) python3 "$SHELL_DIR/scripts/tablet-state.py" --lid --verbose ;;
    *) echo "usage: banditshell tablet on|off|toggle|lid closed|open|status|probe|probe-lid" >&2; exit 2 ;;
    esac
    ;;

# The on-screen board, separately from the hinge above: a keyboard is worth
# having on an unfolded machine and worth dismissing on a folded one.
keyboard | osk)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    # `close` is the odd one out and takes NO screen: it reaches every window,
    # because "put it away" is not a question about a monitor. Passing it one
    # anyway is not ignored, it is an arity error from the IPC layer, and the
    # verb silently does nothing.
    close) ipc keyboard close ;;
    # Whether the board takes up room. Neither takes a screen: it is one
    # preference about how the keyboard behaves, not a fact about a monitor.
    dock | float) ipc keyboard "$sub" ;;
    toggle | open | status) ipc keyboard "$sub" "${1:-}" ;;
    page)
        [ $# -ge 1 ] || { echo "usage: banditshell keyboard page <name>" >&2; exit 2; }
        ipc keyboard page "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell keyboard toggle|open|close|status|dock|float|page <name>" >&2; exit 2 ;;
    esac
    ;;

# THE WAY OUT, and the reason it exists is worth writing down.
#
# Several surfaces take the keyboard EXCLUSIVELY while they are up (the
# launcher, the power panel, the hotkey sheet, a pinned menu) and put a
# full-screen region into the input mask so that a click anywhere off them
# puts them away. That is correct for each of them on its own. The failure it
# creates is that a surface left open by something that died mid-sequence, or
# a pin that got stuck, takes the whole desktop with it: no window holds focus,
# so a bind like `layoutmsg, focus l` has nothing to act on, and every click
# lands on the shell instead of on what is under it. The screen looks frozen.
#
# You cannot type your way out of that, because the terminal does not have the
# keyboard either. A compositor keybind still fires (Hyprland handles binds
# before the event reaches any client), so the only rescue that can work is a
# bind pointed at this, and that is why this verb exists and why it is one
# word. See docs/hyprland-binds.example.conf for the suggested binding.
#
# It closes everything unconditionally and never fails: each verb is allowed to
# error (a surface that is not open, an IPC target that is not registered yet)
# without stopping the ones after it, because the whole point is to be the thing
# that works when something else has not.
close | panic)
    for target in "menu close" "launcher close" "clipboard close" "session close" "hotkeys close" \
                  "settings close" "notifications close" "notch close" "picker close" \
                  "calculator close" "keyboard close"; do
        # Unquoted on purpose: this is the one place a verb and its argument
        # travel as one string and have to come apart again.
        # shellcheck disable=SC2086
        ipc $target >/dev/null 2>&1 || true
    done
    echo "closed everything"
    ;;

# The two verbs that take a value get spelled out; the rest pass through the
# way session's do. `open` always sends its page and screen arguments, empty
# when none was given, because the IPC function declares the parameters and an
# omitted argument does not read as an empty one on the other side. The screen
# goes second so `settings open general` keeps meaning what it always meant; a
# caller that wants to name a screen without naming a page passes "" for the
# page, the same shape `menu open <key> <screen>` already has.
settings)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | close | pull | put | status) ipc settings "$sub" ;;
    open) ipc settings open "${1:-}" "${2:-}" ;;
    page)
        [ $# -ge 1 ] || { echo "usage: banditshell settings page <key>" >&2; exit 2; }
        ipc settings page "$1"
        ;;
    *) echo "usage: banditshell settings toggle|open [page] [screen]|close|page <key>|pull|put|status" >&2; exit 2 ;;
    esac
    ;;

# The tray and the notch, both pinned PER WINDOW, so both name a screen on the
# verbs that pin one. Bare, they toggle, like every other panel here.
#
# The screen is sent on every verb that has one, empty when none was named, for
# the reason spelled out under `hotkeys` below: the IPC function declares the
# parameter, and an omitted argument is a "too few arguments" error on the other
# side rather than an empty one, so a pass-through that dropped it would turn
# `notifications open` into a no-op. `close` and `clear` take none, because
# putting the tray away reaches every screen on purpose and the history is one
# list for the whole session.
notifications)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close | clear) ipc notifications "$sub" ;;
    toggle | open | status) ipc notifications "$sub" "${1:-}" ;;
    *) echo "usage: banditshell notifications toggle [screen]|open [screen]|close|clear|status [screen]" >&2; exit 2 ;;
    esac
    ;;

notch)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close) ipc notch close ;;
    toggle | open | status) ipc notch "$sub" "${1:-}" ;;
    *) echo "usage: banditshell notch toggle [screen]|open [screen]|close|status [screen]" >&2; exit 2 ;;
    esac
    ;;

# The hotkey sheet. Bare, it toggles, like every other panel here: this is the
# verb a key is bound to, and the key that put the sheet up is the key that
# should take it down. `status` prints what the sheet actually read, which is
# the question worth asking from a terminal, because a sheet full of chords with
# nothing beside them is the compositor declining to say rather than this shell
# failing to parse.
#
# The screen is sent on every verb that has one, empty when none was named,
# because the IPC function DECLARES the parameter and an omitted argument is not
# an empty one on the other side: it is a "too few arguments" error and nothing
# happens at all. `settings open` says the same thing above; this is the same
# trap one target along. `close` takes none, because putting the sheet away
# reaches every screen on purpose.
hotkeys)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    close) ipc hotkeys close ;;
    toggle | open | status) ipc hotkeys "$sub" "${1:-}" ;;
    *) echo "usage: banditshell hotkeys toggle [screen]|open [screen]|close|status [screen]" >&2; exit 2 ;;
    esac
    ;;

# Sugar. The calendar is an ordinary menu with the key "calendar", registered
# in the sidebar like the rest, so no IPC target of its own exists or should:
# this is `menu toggle calendar` with fewer words, because the thing you bind
# to a key deserves a shorter name than the thing it is implemented as. The
# trailing "" is the screen argument every menu verb carries.
calendar)
    ipc menu toggle calendar ""
    ;;

# The same sugar for the clock, which is an ordinary menu with the key "clock".
# The three targets below drive everything behind it without it being open at
# all, which is the whole reason services/Clock.qml is a singleton: a countdown
# that only exists while somebody is looking at it is not a countdown.
clock)
    ipc menu toggle clock ""
    ;;

# Countdowns. Bare, it says what is counting, because that is the question you
# type in a terminal; `start` is the one worth a keybind, and `toggle` is the
# other one, for the same reason `volume mute` toggles. Every other verb takes
# an optional handle, the id or the position `status` prints beside it, and
# without one means the timer about to go off, which is the only thing a key
# could mean. The handle is sent empty rather than dropped, for the reason
# spelled out under `hotkeys` above: the IPC function declares the parameter.
timer)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    status) ipc timer status ;;
    pause | resume | toggle | cancel) ipc timer "$sub" "${1:-}" ;;
    start)
        [ $# -ge 1 ] || { echo "usage: banditshell timer start <duration> [label]" >&2; exit 2; }
        ipc timer start "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell timer start <duration> [label]|pause|resume|toggle|cancel [handle]|status" >&2; exit 2 ;;
    esac
    ;;

# Alarms. `add` is the only verb in this file with options, and they are FLAGS
# rather than positions because a keybind is a line somebody writes once and
# reads a year later: counting empty arguments to reach the fifth one is the
# mistake this shape cannot make. They are collected here and handed to the IPC
# function in its own fixed order, which is the division of labour set out in
# the alarm handler's comment in modules/Ipc.qml.
#
# --run and --ask are one slot said two ways (a shell command to run, a message
# to send), so the last one on the line wins; there is no alarm that does both.
alarm)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list | status | snooze | stop) ipc alarm "$sub" ;;
    enable | disable | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell alarm $sub <handle>" >&2; exit 2; }
        ipc alarm "$sub" "$1"
        ;;
    add)
        [ $# -ge 1 ] || { echo "usage: banditshell alarm add <time> [--days <spec>] [--label <text>] [--run <cmd> | --ask <message>]" >&2; exit 2; }
        when="$1"
        shift
        days=""
        label=""
        mode=""
        payload=""
        while [ $# -gt 0 ]; do
            # Every flag here takes a value, so one sitting at the end of the
            # line is a value that was forgotten rather than a flag that means
            # something alone. Checked BEFORE the shift, because `shift 2` with
            # one argument left fails, and under `set -e` a failed shift ends
            # the script with no message and an exit code nobody reads.
            [ $# -ge 2 ] || { echo "banditshell: $1 needs a value" >&2; exit 2; }
            case "$1" in
            --days) days="$2" ;;
            --label) label="$2" ;;
            --run) mode="command"; payload="$2" ;;
            --ask) mode="cloud"; payload="$2" ;;
            *) echo "banditshell: unknown option: $1" >&2; exit 2 ;;
            esac
            shift 2
        done
        ipc alarm add "$when" "$days" "$label" "$mode" "$payload"
        ;;
    *) echo "usage: banditshell alarm list|status|snooze|stop|add <time> [options]|enable <handle>|disable <handle>|remove <handle>" >&2; exit 2 ;;
    esac
    ;;

# Places. The argument is EVERYTHING that follows, joined back into one string,
# so `zone add new york` works without quotes: the tz database writes that space
# as an underscore, and both spellings are normalised to the same key on the
# other side (zoneKey in modules/Ipc.qml). There is no label to pass, because
# the city the panel draws is read off the id itself.
zone)
    sub="${1:-list}"
    shift || true
    case "$sub" in
    list) ipc zone list ;;
    find | add | remove)
        [ $# -ge 1 ] || { echo "usage: banditshell zone $sub <place>" >&2; exit 2; }
        ipc zone "$sub" "$*"
        ;;
    *) echo "usage: banditshell zone list|find <text>|add <place>|remove <place>" >&2; exit 2 ;;
    esac
    ;;

# `up` and `down` move by the shell's configured step (the same one the wheel
# and the sound menu use) and take an optional count of steps; `set` speaks
# percent of the normal range, so 100 is full volume and anything above it is
# amplification up to the shell's ceiling.
volume)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    up | down) ipc volume "$sub" "${1:-}" ;;
    set)
        [ $# -ge 1 ] || { echo "usage: banditshell volume set <percent>" >&2; exit 2; }
        ipc volume set "$1"
        ;;
    mute) ipc volume mute "${1:-}" ;;
    status) ipc volume status ;;
    *) echo "usage: banditshell volume up|down [n]|set <pct>|mute [on|off]|status" >&2; exit 2 ;;
    esac
    ;;

# Where the sound comes out, as opposed to how loud it is. `toggle` is the one
# to bind: it goes to whichever of the two you are not on, and to the speakers
# when you are on neither. Spelled out rather than passed through the way
# session's is, because `assign` takes two arguments and has to be able to say
# which of them it did not understand.
output)
    sub="${1:-status}"
    shift || true
    case "$sub" in
    toggle | speakers | headphones | status | list) ipc output "$sub" ;;
    assign)
        [ $# -ge 1 ] || { echo "usage: banditshell output assign <role> <name>" >&2; exit 2; }
        # An empty name is a real argument: it unassigns the role.
        ipc output assign "$1" "${2:-}"
        ;;
    *) echo "usage: banditshell output toggle|speakers|headphones|status|list|assign <role> <name>" >&2; exit 2 ;;
    esac
    ;;

# No `unlock` here, and that is not an oversight: see the lock handler in
# modules/Ipc.qml. The way back in is `loginctl unlock-session`, which works
# from a TTY and over SSH, which is where you will be if you need it.
lock)
    ipc lock "${1:-lock}"
    ;;

# The picker, and the ONE verb in this file that can work without the shell.
#
# A screenshot key that does nothing is indistinguishable from broken hardware,
# and it is the key most likely to be pressed at the exact moment the thing
# worth keeping is on the screen and about to stop being there. "Nothing
# happened" is not an acceptable answer to it. So when the shell cannot be
# reached, this falls through to the same two tools the shell itself drives -
# slurp for the region, grim for the pixels - and takes the shot anyway.
#
# It is an HONEST backup rather than a quiet one, on both counts:
#
#   - It cannot freeze the screen first. Freezing means drawing a still over
#     every output, which means an overlay, which means the shell. A freeze
#     verb therefore comes back LIVE and the notification says so, instead of
#     handing back a picture that silently is not the one that was asked for.
#   - It still reports that the shell is down. A screenshot that worked is not
#     a reason to stop hearing that the other eight binds did not.
picker)
    sub="${1:-freezeclip}"

    if ipc_quiet picker "$sub"; then
        exit 0
    fi

    # Nothing open, so nothing to close, and no fallback that would mean
    # anything: the surface this would have dismissed does not exist.
    if [ "$sub" = close ]; then
        complain "not running (no picker to close)"
        exit 1
    fi

    if ! command -v slurp >/dev/null || ! command -v grim >/dev/null; then
        complain "not running, and no grim/slurp to fall back on"
        exit 1
    fi

    complain "not running - falling back to grim/slurp (try: banditshell start)"

    # Escape during the drag is a CANCEL, not a failure: slurp exits non-zero
    # for both, and a cancelled screenshot should be as quiet as a successful
    # one. Same for an empty selection, which is a click that never dragged.
    region=$(slurp ${SLURP_ARGS:-}) || exit 0
    if [ -z "$region" ]; then
        exit 0
    fi

    note="banditshell was not running"
    case "$sub" in
    freeze*) note="$note; taken live, nothing could be frozen" ;;
    esac

    # A notification the SHELL cannot deliver, because the shell is the thing
    # that is down. notify-send first anyway - another daemon may be up, and it
    # renders the thumbnail - then the compositor, which is always there.
    say() {
        notify-send -a banditshell "$1" "$2" 2>/dev/null ||
            hyprctl notify -1 5000 "rgb(e5c07b)" "$1 - $2" >/dev/null 2>&1 || true
    }

    case "$sub" in
    *clip)
        grim -g "$region" - | wl-copy --type image/png
        say "Screenshot copied" "$note"
        ;;
    *)
        # The same folder and the same editor the shell would have used, read
        # from the config it reads, so a capture taken while it was down lands
        # where the others did rather than somewhere only this branch knows.
        cfg="${XDG_CONFIG_HOME:-$HOME/.config}/banditshell/config.json"
        dir=$(jq -r '.picker.dir // empty' "$cfg" 2>/dev/null || true)
        editor=$(jq -r '.picker.editor // empty' "$cfg" 2>/dev/null || true)
        dir="${dir:-~/Pictures/Screenshots}"
        dir="${dir/#\~/$HOME}"
        editor="${editor:-swappy -f}"

        mkdir -p "$dir"
        out="$dir/banditshell-$(date +%Y-%m-%d-%H%M%S).png"
        grim -g "$region" "$out"
        say "Screenshot saved" "$out ($note)"
        # Unquoted on purpose: the configured editor is a command WITH its
        # flags ("swappy -f"), the same string the shell splits when it opens
        # one, so it has to come apart here the same way.
        # shellcheck disable=SC2086
        ${editor} "$out" >/dev/null 2>&1 || true
        echo "$out"
        ;;
    esac
    ;;

# The wallpaper the shell draws itself. Most of these are a write to config.json
# that `set wallpaper.enabled` or `set wallpaper.current` could make by hand;
# what they add is the two a KEY needs, which is the two that have to read the
# value before writing it: the opposite of whatever it is now, and the next one
# along. Bare `wallpaper` is the toggle, like `settings` and `session`.
#
# AND A SCREEN, on the four verbs that put a picture somewhere. A wallpaper is
# per monitor (services/Wallpaper.qml), and the argument is optional in the
# shell's usual sense rather than absent: `""` reaches the handler and means the
# focused screen, exactly as `menu open <key> ""` does above. `all` in the same
# slot means every screen as one decision.
#
# `set` is the verb `set wallpaper.current` cannot be. That key is the DEFAULT
# and writing it moves every screen that has not been given its own; the
# per-screen map is keyed by output name, and config/Config.qml refuses a dotted
# path its defaults do not name, so a monitor could not be addressed at all.
wallpaper)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    toggle | on | off | status | palette) ipc wallpaper "$sub" ;;
    next | prev | clear | list) ipc wallpaper "$sub" "${1:-}" ;;
    set)
        [ $# -ge 1 ] || { echo "usage: banditshell wallpaper set <path> [screen|all]" >&2; exit 2; }
        # ABSOLUTE, because the shell is not standing in this directory. A
        # relative path typed at a terminal is relative to the terminal, and the
        # shell would take it as relative to its own working directory and load
        # nothing at all, silently, which looks exactly like a broken wallpaper.
        #
        # `-s` SO THE NAME YOU TYPED IS THE NAME THAT ARRIVES. A collection is
        # very often a symlink into a dotfiles repo, and canonicalising here put
        # `~/dotfiles/wallpapers/.config/wallpapers/32x9/leaves.jpg` into
        # config.json for somebody who had said `~/.config/wallpapers`: where
        # that link lands is the repo's business, and the shell was told where
        # the pictures are. services/Wallpaper.qml lists the folder by the same
        # rule and tells two names for one file apart by inode instead.
        #
        # `-m` so the file need not exist: refusing a path here would be this
        # script second-guessing a shell that already knows what it can decode.
        ipc wallpaper set "$(realpath -s -m -- "$1")" "${2:-}"
        ;;
    *) echo "usage: banditshell wallpaper toggle|on|off|status|palette|list [screen]|next [screen]|prev [screen]|set <path> [screen|all]|clear [screen|all]" >&2; exit 2 ;;
    esac
    ;;

# The picker, which is a surface rather than a setting: plural for the folder,
# singular above for the one you are wearing. See the note on its IPC target.
wallpapers)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    # A screen on the two that put the panel somewhere, because the picker is
    # the control for THAT monitor's wallpaper now rather than for the shell's.
    toggle | open) ipc wallpapers "$sub" "${1:-}" ;;
    close | status) ipc wallpapers "$sub" ;;
    *) echo "usage: banditshell wallpapers toggle [screen]|open [screen]|close|status" >&2; exit 2 ;;
    esac
    ;;

status) ipc shell status ;;
themes) ipc shell themes ;;
theme)
    [ $# -ge 1 ] && ipc shell set theme "\"$1\"" || ipc shell get theme
    ;;
get)
    [ $# -ge 1 ] || { echo "usage: banditshell get <key>" >&2; exit 2; }
    ipc shell get "$1"
    ;;
set)
    [ $# -ge 2 ] || { echo "usage: banditshell set <key> <value>" >&2; exit 2; }
    ipc shell set "$1" "$2"
    ;;

shot)
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/shot.png}"
    grim "$out"
    echo "$out"
    ;;

files)
    sub="${1:-toggle}"
    shift || true
    case "$sub" in
    # Only the two that OPEN take a path. `close` and `status` declare no
    # parameter, and an extra argument is a hard error on the other side rather
    # than an ignored one, so passing "" to them turned both into failures.
    toggle | open) ipc files "$sub" "${1:-}" ;;
    close | status) ipc files "$sub" ;;
    *) echo "usage: banditshell files toggle|open [path]|close|status" >&2; exit 2 ;;
    esac
    ;;

# The C helpers, compiled here because Quickshell loads QML out of a directory
# and has nowhere to run a build step - the same reason `shaders` exists, and the
# same bargain: the binary is build output that lives next to its source.
#
# Not a Makefile. Two translation units with no options between them do not need
# one, and a build system would be a second thing to install before the shell
# runs at all.
build)
    cc="${CC:-gcc}"
    command -v "$cc" >/dev/null || { echo "banditshell: no C compiler (set \$CC, or install gcc)" >&2; exit 1; }
    mkdir -p "$SHELL_DIR/bin"
    # bs-pty wants -lutil for forkpty; bs-ls wants nothing. Listed per target
    # rather than shared, because a link line that is one thing for everything
    # is a link line nobody reads.
    "$cc" -O2 -Wall -Wextra -o "$SHELL_DIR/bin/bs-pty" "$SHELL_DIR/src/bs-pty.c" -lutil
    echo "src/bs-pty.c -> bin/bs-pty"
    "$cc" -O2 -Wall -Wextra -o "$SHELL_DIR/bin/bs-ls" "$SHELL_DIR/src/bs-ls.c"
    echo "src/bs-ls.c -> bin/bs-ls"
    ;;

shaders)
    # .qsb files are build output committed alongside their source, because
    # Quickshell loads QML from a directory and has nowhere to run a build step.
    # This is that build step; run it after editing any .frag.
    qsb="${QSB:-/usr/lib/qt6/bin/qsb}"
    [ -x "$qsb" ] || { echo "banditshell: qsb not found (install qt6-shadertools)" >&2; exit 1; }
    # EVERY .frag under components/, wherever it sits. It used to be the one
    # directory the first shader happened to live in, so the second one was
    # written, committed, and silently never compiled: the shell loaded the
    # stale .qsb that was not there and drew nothing at all.
    while IFS= read -r f; do
        "$qsb" --glsl "100es,120,150" --hlsl 50 --msl 12 -o "$f.qsb" "$f"
        echo "${f#"$SHELL_DIR/"} -> ${f#"$SHELL_DIR/"}.qsb"
    done < <(find "$SHELL_DIR/components" -name '*.frag' | sort)
    ;;

test)
    # The parts of the shell that are plain JavaScript are the parts a
    # screenshot cannot check. A colour that resolves to the wrong hex, an
    # erase that forgets its background, a character split across two reads of
    # the pty: none of those throw, they just make the terminal quietly wrong,
    # and the only evidence is a picture that looks a bit off. Node runs the
    # same files with no Qt under them, which is the whole reason vt.js has no
    # QML in it.
    #
    # A glob rather than the directory: node 26 reads `--test tests/` as a
    # module to load and fails with "Cannot find module". Quoted so node does
    # the expanding, since it is node's idea of a test file that decides.
    command -v node >/dev/null || { echo "banditshell: node not found" >&2; exit 1; }
    cd "$SHELL_DIR" || exit 1
    exec node --test 'tests/*.test.js' "$@"
    ;;

demo)
    # Open a menu, wait for the reveal to settle, capture it, put it away. The
    # sleep is the animation, not a guess: the reveal is exponential smoothing,
    # so it is asymptotic and needs a moment rather than a frame.
    [ $# -ge 1 ] || { echo "usage: banditshell demo <key>" >&2; exit 2; }
    mkdir -p "$SHOT_DIR"
    out="${2:-$SHOT_DIR/menu-$1.png}"
    ipc menu open "$1" "" >/dev/null
    sleep 0.6
    grim "$out"
    ipc menu close >/dev/null
    echo "$out"
    ;;

filespreview)
    # The browser in a plain window, for looking at it without touching the
    # running shell's own session. lockpreview's shape, with one difference: no
    # timeout, because a terminal you cannot type into for more than nine
    # seconds is not a terminal you can test. Close the window to end it.
    #
    # `banditshell filespreview [dir] [shot]` - with a second argument it
    # screenshots the window's own rect and exits, which is the form worth
    # binding while working on the layout.
    where="${1:-$HOME}"
    out="${2:-}"
    # Floated and sized by a window rule, the way settingspreview does it: a
    # tiled preview is whatever size the layout gives it, and a file grid at
    # 2500px wide is not the grid anybody will actually use.
    w=$(get files.width 2>/dev/null || echo 1200)
    h=$(get files.height 2>/dev/null || echo 760)
    hyprctl eval "hl.window_rule({ name = \"banditshell-filespreview\", match = { title = \"^(banditshell-filespreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true })" >/dev/null 2>&1 ||
        hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-filespreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-filespreview)\$ ; keyword windowrule center on, match:title ^(banditshell-filespreview)\$" >/dev/null 2>&1
    (cd "$HOME" && FILES_PREVIEW="$where" qs -p "$SHELL_DIR/filespreview.qml" >/dev/null 2>&1) &
    preview=$!
    if [ -n "$out" ]; then
        mkdir -p "$SHOT_DIR"
        sleep 4
        rect=$(hyprctl -j clients | jq -r '.[] | select(.title == "banditshell-filespreview") | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | head -1)
        if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
        kill "$preview" 2>/dev/null
        echo "$out"
    else
        wait "$preview"
    fi
    ;;

lockpreview)
    # The lock screen's LOOK, without the lock. A session lock cannot be opened
    # to look at, and the way back from one that drew wrong is a TTY, so the face
    # is a plain Item that also fits in an ordinary overlay surface.
    #
    # Its own quickshell instance, on a timer, taking no input: it draws over
    # everything for a few seconds and then goes away on its own whatever
    # happens. Deliberately NOT killed with pkill afterwards, which would take
    # the running shell with it.
    mkdir -p "$SHOT_DIR"
    out="${1:-$SHOT_DIR/lock.png}"
    (cd "$HOME" && timeout 9 qs -p "$SHELL_DIR/lockpreview.qml" >/dev/null 2>&1) &
    sleep 4
    grim "$out"
    wait
    echo "$out"
    ;;

settingspreview)
    # The settings face at a SIZE, which is the thing a running shell cannot
    # show you: its card is one size, and the page has three shapes. A plain
    # floating window of the asked-for size draws the same face, and grim
    # shoots that window's rect alone so the picture is the page and not the
    # desktop it happens to be over. Its own quickshell instance, on a timer,
    # for lockpreview's reason.
    mkdir -p "$SHOT_DIR"
    size="${1:-560x560}"
    page="${2:-}"
    out="${3:-$SHOT_DIR/settings-$size${page:+-$page}.png}"
    # FLOATED AND SIZED BY A WINDOW RULE, installed before the window exists:
    # a tiled window is whatever size the layout gives it, and the size IS the
    # question being asked. The same rule services/Settings.qml installs for
    # the real settings window, in whichever dialect this Hyprland speaks (the
    # Lua parser refuses `keyword`, the legacy one has no `eval`).
    #
    # AND OUT OF THE WAY: on a workspace of its own, silently, and without
    # taking the keyboard. A preview is spawned to be photographed, not
    # looked at, and one that landed on the workspace being worked in and
    # stole focus would interrupt exactly the person who asked for it.
    # PREVIEW_WORKSPACE names the workspace; the default is the first band of
    # the second screen (the vertical monitor here).
    w="${size%x*}"; h="${size#*x}"
    ws="${PREVIEW_WORKSPACE:-6}"
    hyprctl eval "hl.window_rule({ name = \"banditshell-settingspreview\", match = { title = \"^(banditshell-settingspreview)\$\" }, float = true, size = { $w, $h }, center = true, no_anim = true, workspace = \"$ws silent\", no_initial_focus = true, no_focus = true })" >/dev/null 2>&1 ||
        hyprctl --batch "keyword windowrule float on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule size $w $h, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule center on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule workspace $ws silent, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_initial_focus on, match:title ^(banditshell-settingspreview)\$ ; keyword windowrule no_focus on, match:title ^(banditshell-settingspreview)\$" >/dev/null 2>&1
    (cd "$HOME" && SETTINGS_PREVIEW="$size" SETTINGS_PAGE="$page" timeout 9 qs -p "$SHELL_DIR/settingspreview.qml" >/dev/null 2>&1) &
    sleep 4
    rect=$(hyprctl -j clients | jq -r '.[] | select(.title == "banditshell-settingspreview") | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | head -1)
    if [ -n "$rect" ]; then grim -g "$rect" "$out"; else grim "$out"; fi
    wait
    echo "$out"
    ;;

help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
