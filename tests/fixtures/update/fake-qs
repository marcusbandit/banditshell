#!/usr/bin/env bash
dir="${FAKE_QS_DIR:?}"
mkdir -p "$dir/inst"

instances() {
    local file pid
    for file in "$dir"/inst/*; do
        [ -e "$file" ] || continue
        pid="${file##*/}"
        if kill -0 "$pid" 2>/dev/null && [ -e "$(cat "$file")/RELOADEXIT" ] && [ ! -e "$dir/cold/$pid" ]; then
            kill "$pid" 2>/dev/null
            rm -f "$file"
        elif kill -0 "$pid" 2>/dev/null; then
            printf '%s\t%s\n' "$pid" "$(cat "$file")"
        else
            rm -f "$file"
        fi
    done
}

instance_dir() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null || return 1
    cat "$dir/inst/$pid" 2>/dev/null
}

printf '%s\n' "$*" >>"$dir/calls"

case "${1:-}" in
--version)
    echo "quickshell fake"
    ;;
list)
    instances | while IFS=$'\t' read -r pid path; do
        printf 'Instance %s:\n  Process ID: %s\n  Config path: %s/shell.qml\n\n' "$pid" "$pid" "$path"
    done
    ;;
-d)
    shift
    [ "${1:-}" = -p ] || exit 2
    target="$2"
    if [ -e "$target/NOLOAD" ]; then
        echo "ERROR: Failed to load configuration"
        exit 0
    fi
    setsid sleep 3601 >/dev/null 2>&1 &
    pid=$!
    disown
    printf '%s\n' "$target" >"$dir/inst/$pid"
    if [ -e "$target/RELOADFAIL" ] || [ -e "$target/RELOADEXIT" ]; then
        mkdir -p "$dir/cold"
        : >"$dir/cold/$pid"
    fi
    ;;
ipc)
    shift
    where=""
    if [ "${1:-}" = --pid ]; then
        where=$(instance_dir "$2") || exit 1
    else
        exit 1
    fi
    if [ -e "$where/CONFIGWRITE" ] && [ ! -e "$dir/wrote/$2" ]; then
        mkdir -p "$dir/wrote"
        : >"$dir/wrote/$2"
        cp "$where/CONFIGWRITE" "${XDG_CONFIG_HOME:?}/banditshell/config.json"
    fi
    [ ! -e "$where/NOANSWER" ] || exit 1
    echo "ok"
    ;;
log)
    shift
    [ "${1:-}" = --pid ] || exit 1
    where=$(instance_dir "$2") || exit 1
    echo "INFO: loaded $where"
    if [ -e "$where/RELOADFAIL" ] && [ ! -e "$dir/cold/$2" ]; then
        echo "ERROR: Failed to load configuration"
    fi
    if [ -e "$where/REFERROR" ]; then
        echo "ERROR: ReferenceError: Missing is not defined"
    fi
    ;;
*)
    exit 0
    ;;
esac
