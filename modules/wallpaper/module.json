{
  "name": "wallpaper",
  "summary": "the wallpaper, its picker and palette",
  "layer": 2,
  "owns": {
    "qml": ["modules/wallpaper"],
    "services": ["Wallpaper"],
    "scripts": ["scripts/palette.py", "scripts/wallpaper-colours.py"],
    "assets": ["assets/wallpapers"]
  },
  "requires": {
    "packages": ["core", "compositor"],
    "optional": []
  },
  "provides": {
    "singletons": ["Wallpaper"],
    "ipc": ["wallpaper", "wallpapers"]
  },
  "config": {
    "namespace": ["wallpaper"],
    "reads": ["control", "themeFromWallpaper"]
  }
}
