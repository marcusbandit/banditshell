{
  "name": "settings",
  "summary": "the settings panel",
  "layer": 3,
  "owns": {
    "qml": ["modules/settings", "previews/SettingsPreview.qml"],
    "services": ["Modes", "Settings", "ThemeSwitcher", "ThemeEditor"],
    "js": ["services/settings-summon.js", "services/theme-modes.js", "services/theme-editor.js"],
    "scripts": ["scripts/pointing-devices.py"],
    "tests": ["tests/pointing-devices.test.js", "tests/theme-modes.test.js", "tests/theme-editor.test.js", "tests/restore.test.js", "tests/settings-floating.test.js", "tests/settings-summon.test.js", "tests/settings.test.js"]
  },
  "requires": {
    "packages": ["core", "compositor", "display", "clock", "clipboard"],
    "optional": []
  },
  "provides": {
    "singletons": ["Modes"],
    "ipc": ["settings", "mode"]
  },
  "config": {
    "namespace": ["settings", "corner", "menu"],
    "reads": [
      "access",
      "anim",
      "colour",
      "control",
      "edge",
      "font",
      "launcher.plugins",
      "material",
      "polkit",
      "region",
      "rounding",
      "sourceEdits",
      "theme",
      "themeFromWallpaper",
      "volume.step",
      "weather",
      "widgets"
    ]
  }
}
